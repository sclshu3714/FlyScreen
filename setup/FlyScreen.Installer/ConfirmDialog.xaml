<Window x:Class="FlyScreen.Installer.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
  <Border Background="White" CornerRadius="10" BorderBrush="#E8ECF1" BorderThickness="1" Margin="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
    </Border.Effect>
    <Grid Margin="22,18,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <Button DockPanel.Dock="Right"
                Style="{StaticResource CaptionCloseButton}"
                Click="Close_Click" ToolTip="关闭">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M2,2 L12,12 M12,2 L2,12"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="IconBadge" Width="28" Height="28" CornerRadius="14"
                  Background="#EEF3FF" Margin="0,0,10,0">
            <TextBlock x:Name="IconText" Text="i" FontWeight="Bold" FontSize="14"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="TitleText" Text="提示" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="MessageText" Grid.Row="1"
                 TextWrapping="Wrap" FontSize="13" LineHeight="22"
                 Foreground="#4B5563" Margin="0,0,0,18"/>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="NoButton" Content="取消" Style="{StaticResource DialogSecondaryButton}"
                Margin="0,0,10,0" Click="No_Click"/>
        <Button x:Name="YesButton" Content="确定" Style="{StaticResource DialogPrimaryButton}"
                Click="Yes_Click" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
