<Window x:Class="FlyScreen.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlyScreen.Installer.Controls"
        Title="安装 玄鸟"
        Width="720"
        MinWidth="720"
        MaxWidth="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        ContentRendered="Window_ContentRendered">
  <Border x:Name="RootBorder"
          Background="{StaticResource BgBrush}"
          CornerRadius="8"
          BorderBrush="#E8ECF1"
          BorderThickness="1"
          Margin="8"
          Focusable="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="28,18,28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="TitleIcon" Width="22" Height="22" Margin="0,0,8,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock VerticalAlignment="Center">
            <Run x:Name="TitleRun" Text="安装 玄鸟" FontSize="22" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}"/>
            <Run x:Name="VersionRun" Text="v1.0.0" FontSize="11" BaselineAlignment="Subscript"
                 Foreground="{StaticResource MutedBrush}"/>
          </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource CaptionButton}" Margin="0,0,2,0"
                  Click="Minimize_Click" ToolTip="最小化">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M2,7 L12,7"/>
          </Button>
          <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="关闭">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M2,2 L12,12 M12,2 L2,12"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" x:Name="StageHost">
      <StackPanel x:Name="InstallBody" VerticalAlignment="Top">
      <!-- 轮播 -->
      <controls:CarouselView x:Name="Carousel" Height="260" Margin="0,0,0,12"/>

      <!-- 进度占位固定高度：显示/隐藏不改变窗体高度与按钮位置 -->
      <Grid Height="28" Margin="0,0,0,12">
        <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Hidden">
          <ProgressBar x:Name="ProgressBar" Style="{StaticResource InstallProgressBar}"
                       Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"/>
          <TextBlock x:Name="StatusText" Margin="0,6,0,0"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"
                     Text="准备安装…" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <Button x:Name="InstallButton"
              Content="一键安装"
              Style="{StaticResource PrimaryButton}"
              Click="Install_Click"
              IsEnabled="False"
              Margin="0,4,0,24"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="AgreeBox"
                  Style="{StaticResource ModernCheckBox}"
                  Checked="Agree_Changed" Unchecked="Agree_Changed">
          <TextBlock>
            <Run Text="我已阅读并同意"/>
            <Hyperlink NavigateUri="about:license"
                       Foreground="{StaticResource AccentBrush}"
                       TextDecorations="None"
                       Click="LicenseLink_Click">许可协议</Hyperlink>
          </TextBlock>
        </CheckBox>

        <Button x:Name="MoreButton" Grid.Column="1"
                Style="{StaticResource MoreToggleButton}"
                VerticalAlignment="Center" Click="More_Click">
          <StackPanel Orientation="Horizontal">
            <Path x:Name="MoreIcon" Width="10" Height="6" Stretch="Uniform"
                  VerticalAlignment="Center" Margin="0,1,6,0"
                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M1,1 L5,5 L9,1"/>
            <TextBlock x:Name="MoreLabel" Text="更多"
                       Foreground="{StaticResource AccentBrush}" FontSize="13"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border x:Name="MorePanel" Visibility="Collapsed" Margin="0,14,0,0"
              Background="#F5F7FB" CornerRadius="10" Padding="16"
              BorderBrush="#E6EBF2" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="安装路径" FontWeight="SemiBold" FontSize="13"
                     Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="浏览"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Click="Browse_Click"/>
            <TextBox x:Name="PathBox" Style="{StaticResource PathTextBox}"
                     TextChanged="PathBox_TextChanged"/>
          </DockPanel>
          <TextBlock x:Name="SpaceText" Margin="0,10,0,0"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
          <CheckBox x:Name="DesktopShortcutBox" Style="{StaticResource ModernCheckBox}"
                    Content="创建桌面快捷方式" IsChecked="True" Margin="0,14,0,0"/>
          <CheckBox x:Name="StartMenuShortcutBox" Style="{StaticResource ModernCheckBox}"
                    Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      </StackPanel>

      <StackPanel x:Name="FinishPanel" VerticalAlignment="Center" Visibility="Collapsed">
        <Border Background="#F5F7FB" CornerRadius="12" Padding="22,20" Margin="0,8,0,16"
                BorderBrush="#E6EBF2" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="FinishTitle" Text="安装完成" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="FinishPath" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>
        <CheckBox x:Name="LaunchFinishBox" Style="{StaticResource ModernCheckBox}"
                  Content="启动玄鸟" IsChecked="True" Margin="0,0,0,18"/>
        <Button x:Name="FinishButton" Content="完成" Style="{StaticResource PrimaryButton}"
                Click="Finish_Click" Margin="0,0,0,4"/>
      </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
