<Window x:Class="FlyScreen.Uninstaller.ModifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改 玄鸟"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Border Background="{StaticResource BgBrush}" CornerRadius="8"
          BorderBrush="#E8ECF1" BorderThickness="1" Margin="8" Focusable="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
    </Border.Effect>

    <StackPanel Margin="24,18,24,22">
      <Grid Margin="0,0,0,16">
        <TextBlock VerticalAlignment="Center">
          <Run x:Name="TitleRun" Text="修改 玄鸟" FontSize="20" FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}"/>
          <Run x:Name="VersionRun" Text="" FontSize="11" BaselineAlignment="Subscript"
               Foreground="{StaticResource MutedBrush}"/>
        </TextBlock>
        <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButton}"
                Click="Close_Click" ToolTip="关闭">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M2,2 L12,12 M12,2 L2,12"/>
        </Button>
      </Grid>

      <!-- 安装位置 -->
      <Border Background="#F5F7FB" CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
              BorderBrush="#E6EBF2" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathText" Text="—" FontSize="13" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
            <Button x:Name="OpenFolderButton" Grid.Column="1" Content="打开安装目录"
                    Style="{StaticResource SecondaryButton}" Height="36" MinWidth="0"
                    Padding="12,0" Margin="12,0,0,0" FontSize="13" FontWeight="Normal"
                    Click="OpenFolder_Click"/>
          </Grid>
          <TextBlock Text="选择要执行的维护操作：更改路径、修复组件、检查更新或卸载程序。"
                     TextWrapping="Wrap" FontSize="12" Foreground="#6B7280"
                     Margin="0,10,0,0" LineHeight="18"/>
        </StackPanel>
      </Border>

      <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                   Margin="0,0,0,8" Visibility="Collapsed" BorderThickness="0"
                   Background="#E8EEF8" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock x:Name="StatusText" Margin="0,0,0,12" FontSize="12" MinHeight="18"
                 Foreground="{StaticResource MutedBrush}" Text=""
                 TextWrapping="Wrap"/>

      <!-- 2×2 维护卡片 -->
      <UniformGrid Columns="2" Rows="2" Margin="0,0,0,18">
        <RadioButton x:Name="CardChangePath" GroupName="MaintainCards"
                     Style="{StaticResource MaintainCard}" Margin="0,0,6,6"
                     Click="ChangePath_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="#EEF3FF"
                    VerticalAlignment="Top" Margin="0,0,12,0">
              <Viewbox Width="20" Height="20" Stretch="Uniform">
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Fill="Transparent"
                      Data="M3,5 H13 V11 H3 Z M9,11 L14,16 M14,16 L11,16 M14,16 L14,13"/>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="更改安装路径" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="将程序文件迁移到新目录，并更新快捷方式与卸载信息。"
                         FontSize="11" Foreground="#9AA3AF" TextWrapping="Wrap"
                         Margin="0,4,0,0" LineHeight="16"/>
            </StackPanel>
          </Grid>
        </RadioButton>

        <RadioButton x:Name="CardRepairShortcut" GroupName="MaintainCards"
                     Style="{StaticResource MaintainCard}" Margin="6,0,0,6"
                     Click="RepairShortcuts_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="#EEF3FF"
                    VerticalAlignment="Top" Margin="0,0,12,0">
              <Viewbox Width="20" Height="20" Stretch="Uniform">
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Fill="Transparent"
                      Data="M4,3 H12 L15,6 V17 H4 Z M12,3 V6 H15 M7,10 H12 M7,13 H12"/>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="修复快捷方式" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="重建桌面与开始菜单快捷方式，指向当前安装目录。"
                         FontSize="11" Foreground="#9AA3AF" TextWrapping="Wrap"
                         Margin="0,4,0,0" LineHeight="16"/>
            </StackPanel>
          </Grid>
        </RadioButton>

        <RadioButton x:Name="CardRepairRegistry" GroupName="MaintainCards"
                     Style="{StaticResource MaintainCard}" Margin="0,6,6,0"
                     Click="RepairRegistry_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="#EEF3FF"
                    VerticalAlignment="Top" Margin="0,0,12,0">
              <Viewbox Width="20" Height="20" Stretch="Uniform">
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Fill="Transparent"
                      Data="M6,3 H14 V7 H6 Z M5,7 H15 V17 H5 Z M8,10 H12 M8,13 H12"/>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="修复卸载信息" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="刷新「应用和功能」中的卸载 / 修改入口与安装位置。"
                         FontSize="11" Foreground="#9AA3AF" TextWrapping="Wrap"
                         Margin="0,4,0,0" LineHeight="16"/>
            </StackPanel>
          </Grid>
        </RadioButton>

        <RadioButton x:Name="CardUpdate" GroupName="MaintainCards" IsChecked="True"
                     Style="{StaticResource MaintainCard}" Margin="6,6,0,0"
                     Click="Update_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="#EEF3FF"
                    VerticalAlignment="Top" Margin="0,0,12,0">
              <Viewbox Width="20" Height="20" Stretch="Uniform">
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Fill="Transparent"
                      Data="M10,2 L17,8 V16 H3 V8 Z M10,2 V8 M8,12 L10,15 L13,10"/>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="UpdateCardTitle" Text="检查并更新" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="检查是否有新版本；发现更新时可下载并启动安装程序。"
                         FontSize="11" Foreground="#9AA3AF" TextWrapping="Wrap"
                         Margin="0,4,0,0" LineHeight="16"/>
            </StackPanel>
          </Grid>
        </RadioButton>
      </UniformGrid>

      <Grid>
        <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Left" MinWidth="100" Click="Close_Click"/>
        <Button x:Name="UninstallButton" Content="立即卸载" Style="{StaticResource DangerButton}"
                HorizontalAlignment="Right" MinWidth="120" Click="Uninstall_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
