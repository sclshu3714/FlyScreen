<Window x:Class="FlyScreen.Uninstaller.ModifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改 玄鸟"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Border Background="{StaticResource BgBrush}" CornerRadius="8"
          BorderBrush="#E8ECF1" BorderThickness="1" Margin="8" Focusable="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
    </Border.Effect>

    <StackPanel Margin="24,18,24,22">
      <Grid Margin="0,0,0,16">
        <TextBlock VerticalAlignment="Center">
          <Run x:Name="TitleRun" Text="修改 玄鸟" FontSize="20" FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}"/>
          <Run x:Name="VersionRun" Text="" FontSize="11" BaselineAlignment="Subscript"
               Foreground="{StaticResource MutedBrush}"/>
        </TextBlock>
        <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButton}"
                Click="Close_Click" ToolTip="关闭">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M2,2 L12,12 M12,2 L2,12"/>
        </Button>
      </Grid>

      <Border Background="#F5F7FB" CornerRadius="10" Padding="14" Margin="0,0,0,14"
              BorderBrush="#E6EBF2" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="PathText" Text="—" FontSize="13" TextWrapping="Wrap"
                     Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="可检查并安装新版本，或修复快捷方式与卸载信息。"
                 TextWrapping="Wrap" FontSize="13" Foreground="#4B5563" LineHeight="20"
                 Margin="0,0,0,16"/>

      <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                   Margin="0,0,0,8" Visibility="Collapsed" BorderThickness="0"
                   Background="#E8EEF8" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock x:Name="StatusText" Margin="0,0,0,14" FontSize="12"
                 Foreground="{StaticResource MutedBrush}" Text=""
                 TextWrapping="Wrap"/>

      <StackPanel>
        <Button x:Name="UpdateButton" Content="检查并更新" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="Update_Click"/>
        <Button x:Name="RepairShortcutButton" Content="修复快捷方式" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="RepairShortcuts_Click"/>
        <Button x:Name="RepairRegistryButton" Content="修复卸载信息" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="RepairRegistry_Click"/>
        <Button x:Name="OpenFolderButton" Content="打开安装目录" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="OpenFolder_Click"/>
        <Button x:Name="UninstallButton" Content="卸载…" Style="{StaticResource DangerButton}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="Uninstall_Click"/>
        <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Stretch" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
