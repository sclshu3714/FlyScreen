<Window x:Class="FlyScreen.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 玄鸟"
        Width="520"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Border Background="{StaticResource BgBrush}" CornerRadius="8"
          BorderBrush="#E8ECF1" BorderThickness="1" Margin="8" Focusable="True"
          x:Name="RootBorder">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
    </Border.Effect>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="680">
      <StackPanel Margin="24,18,24,22">
        <Grid Margin="0,0,0,16">
          <TextBlock VerticalAlignment="Center">
            <Run x:Name="TitleRun" Text="卸载 玄鸟" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}"/>
            <Run x:Name="VersionRun" Text="" FontSize="11" BaselineAlignment="Subscript"
                 Foreground="{StaticResource MutedBrush}"/>
          </TextBlock>
          <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButton}"
                  Click="Close_Click" ToolTip="关闭">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M2,2 L12,12 M12,2 L2,12"/>
          </Button>
        </Grid>

        <Border Background="#F5F7FB" CornerRadius="10" Padding="14" Margin="0,0,0,14"
                BorderBrush="#E6EBF2" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="安装位置" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="PathText" Text="—" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="ScopePanel" Margin="0,0,0,0">
          <TextBlock Text="卸载范围" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
          <RadioButton x:Name="ModeProduct" GroupName="UninstallMode" IsChecked="True"
                       Style="{StaticResource ModernRadioButton}" Margin="0,0,0,6"
                       Checked="Mode_Changed">
            <TextBlock Text="卸载主程序（可勾选要一并卸载的插件）" TextWrapping="Wrap"/>
          </RadioButton>
          <RadioButton x:Name="ModeToolsOnly" GroupName="UninstallMode"
                       Style="{StaticResource ModernRadioButton}" Margin="0,0,0,12"
                       Checked="Mode_Changed">
            <TextBlock Text="仅卸载所选插件（保留主程序）" TextWrapping="Wrap"/>
          </RadioButton>

          <Border x:Name="ToolsPanel" Visibility="Collapsed" Background="#F8FAFC" CornerRadius="10"
                  Padding="12" Margin="0,0,0,12" BorderBrush="#E6EBF2" BorderThickness="1">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="已安装插件" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <Button Content="全选" Padding="8,2" Margin="0,0,6,0" Click="SelectAllTools_Click"
                          Style="{StaticResource SecondaryButton}"/>
                  <Button Content="全不选" Padding="8,2" Click="SelectNoneTools_Click"
                          Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </DockPanel>
              <StackPanel x:Name="ToolsList"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <CheckBox x:Name="KeepDataBox" Style="{StaticResource ModernCheckBox}"
                  IsChecked="True" Margin="0,0,0,0">
          <TextBlock TextWrapping="Wrap" LineHeight="18">
            <Run Text="保留个人配置（推荐）"/>
            <LineBreak/>
            <Run Text="%AppData%\Roaming\FlyScreen" FontSize="11"
                 Foreground="{StaticResource MutedBrush}"/>
          </TextBlock>
        </CheckBox>

        <Grid Height="36" Margin="0,16,0,0">
          <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Hidden">
            <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="False" BorderThickness="0"
                         Background="#E8EEF8" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Text="准备卸载…"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                  Margin="0,0,10,0" Click="Close_Click"/>
          <Button x:Name="UninstallButton" Content="卸载" Style="{StaticResource DangerButton}"
                  Click="Uninstall_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
