<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\FlyScreen.Assets.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>FlyScreen.Setup</RootNamespace>
    <AssemblyName>FlyScreen.Setup</AssemblyName>
    <ApplicationIcon>$(FlyScreenAppIco)</ApplicationIcon>
    <AssemblyTitle>玄鸟发布工具</AssemblyTitle>
    <Product>玄鸟发布工具</Product>
    <Description>FlyScreen 多端发布与安装包制作</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FlyScreen.Installer\**\*"
          Link="InstallerTemplate\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Never"
          Visible="false" />
  </ItemGroup>

  <Import Project="..\..\build\FlyScreen.Version.targets" Condition="Exists('..\..\build\FlyScreen.Version.targets')" />

</Project>
