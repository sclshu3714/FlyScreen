<Window x:Class="FlyScreen.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="玄鸟发布工具"
        Height="740" Width="1000"
        MinHeight="620" MinWidth="900"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,16"
               Text="选择端、打包方式与部署模式，一键发布独立程序或自定义安装包（始终使用 Release，不含 PDB）。"
               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
        <ScrollViewer Style="{StaticResource ModernScrollViewer}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="打包目标" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="全选" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Click="SelectAll_Click"/>
                <Button Content="全不选" Style="{StaticResource GhostButton}"
                        Click="SelectNone_Click"/>
              </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="TargetList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                          Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="1"
                          Opacity="{Binding Opacity}">
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}"
                              Margin="0"
                              ToolTip="{Binding DisabledReason}">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Rid}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="TargetMutexHint" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>

            <Separator Margin="0,12,0,12" Background="#EEF2F7"/>

            <TextBlock Text="打包方式" Style="{StaticResource SectionLabel}"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeStandalone" Content="独立应用" GroupName="PackageMode"
                           IsChecked="True" Checked="PackageMode_Changed"/>
              <RadioButton x:Name="ModeInstaller" Content="安装包" GroupName="PackageMode"
                           Checked="PackageMode_Changed"/>
            </StackPanel>
            <TextBlock x:Name="InstallerHint"
                       Text="安装包：Windows 桌面 / MAUI Win → Setup.exe；MAUI Android → APK。Linux / Mac 请用「独立应用」。"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock Text="部署模式" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="DeploySelfContained" Content="独立（Self-contained）"
                           GroupName="DeployMode" IsChecked="True" Checked="DeployMode_Changed"/>
              <RadioButton x:Name="DeployFramework" Content="依赖框架"
                           GroupName="DeployMode" Checked="DeployMode_Changed"/>
            </StackPanel>
            <TextBlock x:Name="DeployHint" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>

            <TextBlock Text="输出目录" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="浏览" MinWidth="72" Margin="8,0,0,0"
                      Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click"/>
              <TextBox x:Name="OutputDirBox" Style="{StaticResource FieldTextBox}"/>
            </DockPanel>

            <CheckBox x:Name="IncludeVddOfflineBox" Margin="0,14,0,0"
                      IsChecked="True"
                      Content="包含虚拟显示离线包（VddOffline / FlyScreen.VddOffline.zip）"/>
            <TextBlock Text="仅影响 Windows 桌面 / MAUI Win。不勾选则安装包更小，使用时通过 winget/在线安装驱动。"
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,0"/>

            <Expander x:Name="InstallerOptionsExpander"
                      Header="安装包选项（默认值可改）"
                      Margin="0,14,0,0"
                      IsExpanded="False">
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="产品名称" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ProductNameBox" Text="玄鸟" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10"/>
                <TextBlock Text="默认安装路径" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="InstallDirBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10"/>
                <TextBlock Text="许可协议链接" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="LicenseUrlBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10"/>
                <TextBlock Text="轮播图目录（附件，空则自动生成）" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,10">
                  <Button DockPanel.Dock="Right" Content="浏览" MinWidth="72" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" Click="BrowseCarousel_Click"/>
                  <TextBox x:Name="CarouselDirBox" Style="{StaticResource FieldTextBox}"/>
                </DockPanel>
                <CheckBox x:Name="DesktopShortcutBox" Content="创建桌面快捷方式" IsChecked="True"/>
                <CheckBox x:Name="StartMenuShortcutBox" Content="创建开始菜单快捷方式" IsChecked="True"/>
                <CheckBox x:Name="LaunchAfterBox" Content="安装后启动" IsChecked="True"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="输出日志" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Click="ClearLog_Click"/>
          </DockPanel>
          <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#EEF2F7" BorderThickness="1" Padding="8">
            <TextBox x:Name="LogBox" Style="{StaticResource LogTextBox}"/>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
      <!-- 窗体最底部进度条：默认隐藏，打包时显示 -->
      <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Bottom"
                   Height="4" Margin="0,10,0,0"
                   Minimum="0" Maximum="100" Value="0"
                   IsIndeterminate="False" BorderThickness="0"
                   Background="#E8EEF8" Foreground="{StaticResource AccentBrush}"
                   Visibility="Collapsed"/>

      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                  Margin="0,0,8,0" IsEnabled="False" Click="Cancel_Click"/>
          <Button x:Name="StartButton" Content="开始打包" Style="{StaticResource PrimaryButton}"
                  Click="Start_Click"/>
        </StackPanel>
        <!-- 状态 + 百分比合并到同一条文案 -->
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{StaticResource MutedBrush}"
                   Text="就绪 · 配置固定为 Release"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DockPanel>
  </Grid>
</Window>
