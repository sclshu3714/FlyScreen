<Window x:Class="FlyScreen.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlyScreen.Setup.Models"
        Title="玄鸟发布工具"
        Height="760" Width="1100"
        MinHeight="640" MinWidth="960"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,16"
               Text="选择端、打包方式与部署模式，一键发布独立程序或自定义安装包（始终使用 Release，不含 PDB）。"
               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftCol" Width="1.15*" MinWidth="320"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition x:Name="RightCol" Width="1*" MinWidth="360"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧配置 -->
      <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
        <TabControl x:Name="ConfigTabs" Style="{StaticResource LeftTabControl}">
          <TabItem Style="{StaticResource LeftTabItem}">
            <TabItem.Header>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="基" Style="{StaticResource LeftTabHeaderChar}"/>
                <TextBlock Text="础" Style="{StaticResource LeftTabHeaderChar}" Margin="0,2,0,0"/>
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource ModernScrollViewer}">
              <StackPanel>
                <!-- 打包方式 -->
                <Border Style="{StaticResource SectionCard}">
                  <StackPanel>
                    <TextBlock Text="打包方式" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ModeStandalone" Content="独立应用" GroupName="PackageMode"
                                   Checked="PackageMode_Changed"/>
                      <RadioButton x:Name="ModeInstaller" Content="安装包" GroupName="PackageMode"
                                   IsChecked="True" Checked="PackageMode_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="InstallerHint"
                               Text="安装包：Windows 桌面 / MAUI Win → Setup.exe；MAUI Android → APK；Linux → tar.gz。Mac 请用「独立应用」。"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>

                <!-- 输出目录 -->
                <Border Style="{StaticResource SectionCard}">
                  <StackPanel>
                    <TextBlock Text="输出目录" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="浏览" MinWidth="72" Margin="8,0,0,0"
                              Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click"/>
                      <TextBox x:Name="OutputDirBox" Style="{StaticResource FieldTextBox}"/>
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- 虚拟显示 -->
                <Border Style="{StaticResource SectionCard}">
                  <StackPanel>
                    <TextBlock Text="虚拟显示" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="IncludeVddOfflineBox" IsChecked="False"
                              Content="包含虚拟显示离线包（VddOffline）"/>
                    <TextBlock x:Name="VddOfflineHint"
                               Text="仅打进 Windows 电脑端。不勾选则体积更小，使用时通过 winget/在线安装。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <!-- 默认值：默认折叠 -->
                <Expander x:Name="InstallerOptionsExpander"
                          Header="安装包默认值（可改）"
                          IsExpanded="False"
                          Margin="0,0,0,4">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="产品名称" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProductNameBox" Text="玄鸟" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10"/>
                    <TextBlock Text="默认安装路径" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="InstallDirBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10"/>
                    <TextBlock Text="许可协议链接" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="LicenseUrlBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,10"/>
                    <TextBlock Text="轮播图目录（附件，空则自动生成）" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                      <Button DockPanel.Dock="Right" Content="浏览" MinWidth="72" Margin="8,0,0,0"
                              Style="{StaticResource SecondaryButton}" Click="BrowseCarousel_Click"/>
                      <TextBox x:Name="CarouselDirBox" Style="{StaticResource FieldTextBox}"/>
                    </DockPanel>
                    <CheckBox x:Name="DesktopShortcutBox" Content="创建桌面快捷方式" IsChecked="True"/>
                    <CheckBox x:Name="StartMenuShortcutBox" Content="创建开始菜单快捷方式" IsChecked="True"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Style="{StaticResource LeftTabItem}" IsSelected="True">
            <TabItem.Header>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="配" Style="{StaticResource LeftTabHeaderChar}"/>
                <TextBlock Text="置" Style="{StaticResource LeftTabHeaderChar}" Margin="0,2,0,0"/>
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource ModernScrollViewer}">
              <StackPanel>
                <!-- 打包目标：单选 -->
                <Border Style="{StaticResource SectionCard}">
                  <StackPanel>
                    <TextBlock Text="打包目标" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="TargetList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                                  Background="White" BorderBrush="#EEF2F7" BorderThickness="1"
                                  Opacity="{Binding Opacity}">
                            <RadioButton GroupName="PublishTarget"
                                         Style="{StaticResource ModernRadio}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         IsEnabled="{Binding IsEnabled}"
                                         Margin="0"
                                         Checked="TargetRadio_Checked"
                                         ToolTip="{Binding DisabledReason}">
                              <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Rid}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                              </StackPanel>
                            </RadioButton>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TargetMutexHint" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>

                <!-- 目标框架 / 运行时 -->
                <Border Style="{StaticResource SectionCard}">
                  <StackPanel>
                    <TextBlock Text="目标框架" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="FrameworkBox" Style="{StaticResource FieldComboBox}"
                              SelectionChanged="FrameworkBox_SelectionChanged"/>
                    <TextBlock x:Name="FrameworkHint" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>

                    <TextBlock Text="目标运行时" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
                    <ComboBox x:Name="RuntimeBox" Style="{StaticResource FieldComboBox}"
                              SelectionChanged="RuntimeBox_SelectionChanged"/>
                    <TextBlock x:Name="RuntimeHint" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <!-- 部署模式 -->
                <Border Style="{StaticResource SectionCard}" Margin="0">
                  <StackPanel>
                    <TextBlock Text="部署模式" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="DeploySelfContained" Content="独立（Self-contained）"
                                   GroupName="DeployMode" IsChecked="True" Checked="DeployMode_Changed"/>
                      <RadioButton x:Name="DeployFramework" Content="依赖框架"
                                   GroupName="DeployMode" Checked="DeployMode_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="DeployHint" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    ShowsPreview="True"
                    ResizeBehavior="PreviousAndNext"
                    Cursor="SizeWE"/>

      <!-- 右侧：开始打包 + 队列 + 日志 -->
      <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="StartButton"
                      Content="开始打包" Style="{StaticResource PrimaryButton}"
                      Click="Start_Click"/>
              <Button x:Name="OpenOutputButton"
                      Content="打开目录" Style="{StaticResource SecondaryButton}"
                      Margin="8,0,0,0" Height="40" MinWidth="96"
                      ToolTip="打开安装包/发布产物输出文件夹"
                      Click="OpenOutput_Click"/>
            </StackPanel>
            <TextBlock Text="打包队列" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
          </DockPanel>

          <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8"
                  BorderBrush="#EEF2F7" BorderThickness="1" Padding="8">
            <Grid>
              <TextBlock x:Name="QueueEmptyHint"
                         Text="点击「开始打包」将当前配置加入队列（最多同时执行 2 个）。"
                         Foreground="{StaticResource MutedBrush}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextWrapping="Wrap" Margin="16"/>
              <ScrollViewer Style="{StaticResource QueueScrollViewer}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="JobList" HorizontalContentAlignment="Stretch">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="HorizontalAlignment" Value="Stretch"/>
                      <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="10" BorderBrush="#E5E7EB"
                              BorderThickness="1" MinHeight="56"
                              SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                          <ProgressBar Value="{Binding Percent}" Style="{StaticResource JobProgressBar}"
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                       IsHitTestVisible="False"/>
                          <Grid Margin="10,8,8,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                         Foreground="{StaticResource TextBrush}"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding StatusLine}" FontSize="12" Margin="0,2,0,0"
                                         Foreground="{StaticResource MutedBrush}"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                              <Button Style="{StaticResource QueueActionButton}"
                                      ToolTip="查看本任务日志"
                                      Click="JobLog_Click" Tag="{Binding}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;"
                                           FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              </Button>
                              <Button Style="{StaticResource QueueActionButton}"
                                      ToolTip="重新打包（不新增队列项）"
                                      Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                      Click="JobRetry_Click" Tag="{Binding}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"
                                           FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              </Button>
                              <Button Style="{StaticResource QueueDeleteButton}"
                                      ToolTip="删除任务（运行中将取消）"
                                      Click="JobDelete_Click" Tag="{Binding}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"
                                           FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- 日志默认折叠；展开时固定矮高度，避免挤压队列 -->
          <Expander x:Name="LogExpander" Grid.Row="2" Margin="0,10,0,0"
                    IsExpanded="False"
                    Expanded="LogExpander_Expanded"
                    Collapsed="LogExpander_Collapsed">
            <Expander.Header>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource GhostButton}"
                        Height="28" MinWidth="56" FontSize="12" Padding="10,0"
                        Margin="8,0,0,0" Click="ClearLog_Click"
                        PreviewMouseLeftButtonDown="ClearLog_PreviewMouseDown"/>
                <TextBlock x:Name="LogTitle" Text="输出日志" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
              </DockPanel>
            </Expander.Header>
            <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#EEF2F7" BorderThickness="1"
                    Height="132" Margin="0,8,0,0" ClipToBounds="True">
              <ListBox x:Name="LogList"
                       Style="{StaticResource SetupLogListBox}"
                       ItemContainerStyle="{StaticResource SetupLogListBoxItem}"
                       Margin="4,4,2,8"
                       ScrollViewer.CanContentScroll="False"
                       VirtualizingPanel.IsVirtualizing="False"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:SetupLogEntry}">
                    <Grid Margin="0,0,0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TimeText}" Margin="0,0,10,0"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontFamily="Consolas, Cascadia Mono, Courier New"/>
                      <TextBlock Grid.Column="1" Text="{Binding LevelText}" MinWidth="36"
                                 Margin="0,0,10,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Level}" Value="{x:Static models:SetupLogLevel.Error}">
                                <Setter Property="Foreground" Value="#DC2626"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Level}" Value="{x:Static models:SetupLogLevel.Warn}">
                                <Setter Property="Foreground" Value="#D97706"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Level}" Value="{x:Static models:SetupLogLevel.Debug}">
                                <Setter Property="Foreground" Value="#6B7280"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Level}" Value="{x:Static models:SetupLogLevel.Info}">
                                <Setter Property="Foreground" Value="#2563EB"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                 Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Expander>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}"
                 Text="就绪 · 配置固定为 Release · 队列空闲"
                 TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
