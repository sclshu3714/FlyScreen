<Window x:Class="FlyScreen.ProgramDevHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计算器"
        Height="640"
        Width="380"
        MinHeight="560"
        MinWidth="320"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1E"
        Foreground="White"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FnButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#3A3A3C"/>
        </Style>
        <Style x:Key="OpButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#111113" CornerRadius="18" Padding="18,14,18,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              FlowDirection="RightToLeft">
                    <TextBlock x:Name="ExprText"
                               FlowDirection="LeftToRight"
                               Text=""
                               FontSize="16"
                               Foreground="#8E8E93"
                               TextAlignment="Right"
                               VerticalAlignment="Bottom"
                               TextWrapping="NoWrap"/>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              FlowDirection="RightToLeft">
                    <TextBlock x:Name="ResultText"
                               FlowDirection="LeftToRight"
                               Text="0"
                               FontSize="48"
                               FontWeight="Light"
                               Foreground="White"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Rows="6" Columns="4">
            <Button Content="(" Tag="(" Style="{StaticResource FnButton}" ToolTip="左括号"/>
            <Button Content=")" Tag=")" Style="{StaticResource FnButton}" ToolTip="右括号"/>
            <Button Content="&#x232B;" Tag="BS" Style="{StaticResource FnButton}" ToolTip="退格"/>
            <Button Content="C" Tag="C" Style="{StaticResource FnButton}" ToolTip="清空"/>

            <Button Content="&#x221A;" Tag="SQRT" Style="{StaticResource FnButton}" ToolTip="平方根"/>
            <Button Content="x&#x00B2;" Tag="SQR" Style="{StaticResource FnButton}" ToolTip="平方"/>
            <Button Content="1/x" Tag="INV" Style="{StaticResource FnButton}" FontSize="18" ToolTip="倒数"/>
            <Button Content="&#x00F7;" Tag="/" Style="{StaticResource OpButton}"/>

            <Button Content="7" Tag="7" Style="{StaticResource CalcButton}"/>
            <Button Content="8" Tag="8" Style="{StaticResource CalcButton}"/>
            <Button Content="9" Tag="9" Style="{StaticResource CalcButton}"/>
            <Button Content="&#x00D7;" Tag="*" Style="{StaticResource OpButton}"/>

            <Button Content="4" Tag="4" Style="{StaticResource CalcButton}"/>
            <Button Content="5" Tag="5" Style="{StaticResource CalcButton}"/>
            <Button Content="6" Tag="6" Style="{StaticResource CalcButton}"/>
            <Button Content="&#x2212;" Tag="-" Style="{StaticResource OpButton}"/>

            <Button Content="1" Tag="1" Style="{StaticResource CalcButton}"/>
            <Button Content="2" Tag="2" Style="{StaticResource CalcButton}"/>
            <Button Content="3" Tag="3" Style="{StaticResource CalcButton}"/>
            <Button Content="+" Tag="+" Style="{StaticResource OpButton}"/>

            <Button Content="%" Tag="%" Style="{StaticResource FnButton}" ToolTip="除以 100"/>
            <Button Content="0" Tag="0" Style="{StaticResource CalcButton}"/>
            <Button Content="." Tag="." Style="{StaticResource CalcButton}"/>
            <Button Content="=" Tag="=" Style="{StaticResource OpButton}"/>
        </UniformGrid>
    </Grid>
</Window>
