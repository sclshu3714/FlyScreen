<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia Linux 单文件 → artifacts/release/FlyScreen-{ver}-linux-x64 -->
  <Import Project="PublishProject.Common.props" />
  <PropertyGroup>
    <FlyScreenPublishTitle>发布 Avalonia Linux (linux-x64)</FlyScreenPublishTitle>
    <FlyScreenPublishRid>linux-x64</FlyScreenPublishRid>
    <FlyScreenPublishKind>UnixBin</FlyScreenPublishKind>
    <FlyScreenPublishStagingDir>src\FlyScreen.App.Linux\bin\publish\linux-x64</FlyScreenPublishStagingDir>
    <FlyScreenPublishCommand>dotnet publish "src\FlyScreen.App.Linux\FlyScreen.App.Linux.csproj" -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -o "src\FlyScreen.App.Linux\bin\publish\linux-x64"</FlyScreenPublishCommand>
  </PropertyGroup>
  <Import Project="PublishProject.Common.targets" />
</Project>
