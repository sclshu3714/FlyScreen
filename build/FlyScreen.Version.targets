<Project>
  <!--
    各端统一版本规则（与 Win 端一致）：
    Version = 最新 Git tag vX.Y.Z 自动 +1；minor/patch 大于 9 向高位进位
    （1.0.9→1.1.0，1.9.9→2.0.0）；与提交次数无关。
    可覆盖：dotnet build/publish -p:Version=1.1.0 -p:IgnoreGitVersion=true
    禁用：-p:IgnoreGitVersion=true

    Android 注意：Microsoft.Android.Sdk 在 _GenerateJavaStubs → GenerateMainAndroidManifest
    使用 $(_AndroidVersionName)/$(_AndroidVersionCode)。这些属性只在 Target 里赋值；
    若未在生成清单前设好，会落到 versionName=1.0.0 / versionCode=1（系统「应用信息」显示错误）。
  -->

  <!-- 评估期：优先读上次 Resolve 写入的 version.json，避免 ApplicationDisplayVersion 卡在默认 1.0.0 -->
  <PropertyGroup Condition="'$(Version)' == '' And Exists('$(MSBuildThisFileDirectory)version.json')">
    <_FsVersionJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.json'))</_FsVersionJson>
    <_FsJsonVer>$([System.Text.RegularExpressions.Regex]::Match($(_FsVersionJson), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</_FsJsonVer>
    <_FsJsonCode>$([System.Text.RegularExpressions.Regex]::Match($(_FsVersionJson), '"versionCode"\s*:\s*(\d+)').Groups[1].Value)</_FsJsonCode>
    <Version Condition="'$(_FsJsonVer)' != ''">$(_FsJsonVer)</Version>
    <FlyScreenVersionCode Condition="'$(_FsJsonCode)' != ''">$(_FsJsonCode)</FlyScreenVersionCode>
  </PropertyGroup>

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product Condition="'$(Product)' == ''">玄鸟</Product>
    <Authors Condition="'$(Authors)' == ''">sclshu3714</Authors>
    <Company Condition="'$(Company)' == ''">玄鸟</Company>
    <Copyright Condition="'$(Copyright)' == ''">Copyright © 2026</Copyright>
    <!-- MAUI/Android：评估期即对齐，供 SDK 与清单使用 -->
    <ApplicationDisplayVersion Condition="'$(UseMaui)' == 'true'">$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(UseMaui)' == 'true' And '$(FlyScreenVersionCode)' != ''">$(FlyScreenVersionCode)</ApplicationVersion>
    <ApplicationVersion Condition="'$(UseMaui)' == 'true' And '$(ApplicationVersion)' == ''">1</ApplicationVersion>
  </PropertyGroup>

  <Target Name="ResolveVersionFromGitTag"
          BeforeTargets="GenerateAssemblyInfo;CoreGenerateAssemblyInfo;GetAssemblyVersion;PrepareForBuild;_GetAndroidPackageName"
          Condition="'$(IgnoreGitVersion)' != 'true'">
    <!-- 与 Resolve-FlyScreenVersion.ps1 同源：+1 且各段 >9 进位 -->
    <PropertyGroup>
      <_FsResolveScript>$(MSBuildThisFileDirectory)Resolve-FlyScreenVersion.ps1</_FsResolveScript>
      <_FsRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_FsRepoRoot>
      <_FsVersionJsonOut>$(MSBuildThisFileDirectory)version.json</_FsVersionJsonOut>
    </PropertyGroup>

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_FsResolveScript)&quot; -RepoRoot &quot;$(_FsRepoRoot)&quot; -WriteVersionJson &quot;$(_FsVersionJsonOut)&quot; -MachineReadable"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          WorkingDirectory="$(_FsRepoRoot)">
      <Output TaskParameter="ConsoleOutput" ItemName="_FsVerOutLines" />
    </Exec>

    <PropertyGroup>
      <_FsVerRaw>@(_FsVerOutLines->'%(Identity)', ' ')</_FsVerRaw>
      <_FsMrVer>$([System.Text.RegularExpressions.Regex]::Match('$(_FsVerRaw)', '(\d+\.\d+\.\d+)\|(\d+)\|([^\s|]*)').Groups[1].Value)</_FsMrVer>
      <_FsMrCode>$([System.Text.RegularExpressions.Regex]::Match('$(_FsVerRaw)', '(\d+\.\d+\.\d+)\|(\d+)\|([^\s|]*)').Groups[2].Value)</_FsMrCode>
      <_FsMrTag>$([System.Text.RegularExpressions.Regex]::Match('$(_FsVerRaw)', '(\d+\.\d+\.\d+)\|(\d+)\|([^\s|]*)').Groups[3].Value)</_FsMrTag>
      <Version Condition="'$(_FsMrVer)' != ''">$(_FsMrVer)</Version>
      <FlyScreenVersionCode Condition="'$(_FsMrCode)' != ''">$(_FsMrCode)</FlyScreenVersionCode>
      <_LatestTag>$(_FsMrTag)</_LatestTag>
    </PropertyGroup>

    <!-- 解析失败时回退读刚写入的 version.json -->
    <PropertyGroup Condition="'$(_FsMrVer)' == '' And Exists('$(_FsVersionJsonOut)')">
      <_FsVersionJson>$([System.IO.File]::ReadAllText('$(_FsVersionJsonOut)'))</_FsVersionJson>
      <_FsJsonVer>$([System.Text.RegularExpressions.Regex]::Match('$(_FsVersionJson)', '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</_FsJsonVer>
      <_FsJsonCode>$([System.Text.RegularExpressions.Regex]::Match('$(_FsVersionJson)', '"versionCode"\s*:\s*(\d+)').Groups[1].Value)</_FsJsonCode>
      <_FsJsonTag>$([System.Text.RegularExpressions.Regex]::Match('$(_FsVersionJson)', '"latestTag"\s*:\s*"([^"]*)"').Groups[1].Value)</_FsJsonTag>
      <Version Condition="'$(_FsJsonVer)' != ''">$(_FsJsonVer)</Version>
      <FlyScreenVersionCode Condition="'$(_FsJsonCode)' != ''">$(_FsJsonCode)</FlyScreenVersionCode>
      <_LatestTag>$(_FsJsonTag)</_LatestTag>
    </PropertyGroup>

    <PropertyGroup>
      <_VerMajor>$([System.Version]::Parse('$(Version)').Major)</_VerMajor>
      <_VerMinor>$([System.Version]::Parse('$(Version)').Minor)</_VerMinor>
      <_VerPatch>$([System.Version]::Parse('$(Version)').Build)</_VerPatch>
      <_VerCodePart>$([MSBuild]::Add($([MSBuild]::Multiply($(_VerMajor), 10000)), $([MSBuild]::Multiply($(_VerMinor), 100))))</_VerCodePart>
      <FlyScreenVersionCode Condition="'$(FlyScreenVersionCode)' == ''">$([MSBuild]::Add($(_VerCodePart), $(_VerPatch)))</FlyScreenVersionCode>
    </PropertyGroup>

    <PropertyGroup>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
      <ApplicationDisplayVersion Condition="'$(UseMaui)' == 'true'">$(Version)</ApplicationDisplayVersion>
      <ApplicationVersion Condition="'$(UseMaui)' == 'true'">$(FlyScreenVersionCode)</ApplicationVersion>
      <_AndroidVersionName Condition="'$(UseMaui)' == 'true'">$(Version)</_AndroidVersionName>
      <_AndroidVersionCode Condition="'$(UseMaui)' == 'true'">$(FlyScreenVersionCode)</_AndroidVersionCode>
    </PropertyGroup>

    <Message Importance="High"
             Text="版本来自 Git 标签：最新 $(_LatestTag) → 项目 Version=$(Version)（code=$(FlyScreenVersionCode)；&gt;9 进位；提交不改变此版本）" />
  </Target>

  <!-- Setup / 命令行显式 -p:Version + IgnoreGitVersion：强制对齐程序集与 MAUI/Android 清单字段 -->
  <Target Name="ApplyExplicitVersion"
          BeforeTargets="GenerateAssemblyInfo;CoreGenerateAssemblyInfo;GetAssemblyVersion;PrepareForBuild;_GetAndroidPackageName"
          Condition="'$(IgnoreGitVersion)' == 'true' And '$(Version)' != ''">
    <PropertyGroup>
      <_VerMajor>$([System.Version]::Parse('$(Version)').Major)</_VerMajor>
      <_VerMinor>$([System.Version]::Parse('$(Version)').Minor)</_VerMinor>
      <_VerPatch>$([System.Version]::Parse('$(Version)').Build)</_VerPatch>
      <_VerCodePart>$([MSBuild]::Add($([MSBuild]::Multiply($(_VerMajor), 10000)), $([MSBuild]::Multiply($(_VerMinor), 100))))</_VerCodePart>
      <FlyScreenVersionCode Condition="'$(FlyScreenVersionCode)' == ''">$([MSBuild]::Add($(_VerCodePart), $(_VerPatch)))</FlyScreenVersionCode>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
      <ApplicationDisplayVersion Condition="'$(UseMaui)' == 'true'">$(Version)</ApplicationDisplayVersion>
      <ApplicationVersion Condition="'$(UseMaui)' == 'true'">$(FlyScreenVersionCode)</ApplicationVersion>
      <_AndroidVersionName Condition="'$(UseMaui)' == 'true'">$(Version)</_AndroidVersionName>
      <_AndroidVersionCode Condition="'$(UseMaui)' == 'true'">$(FlyScreenVersionCode)</_AndroidVersionCode>
    </PropertyGroup>
    <Message Importance="High"
             Text="版本来自显式覆盖：Version=$(Version)（code=$(FlyScreenVersionCode)；IgnoreGitVersion=true）" />
  </Target>

  <!-- 生成 AndroidManifest 前强制写入 VersionName/Code（钩到 SDK 的 BeforeGenerateAndroidManifest） -->
  <PropertyGroup Condition="'$(UseMaui)' == 'true'">
    <BeforeGenerateAndroidManifest>
      $(BeforeGenerateAndroidManifest);
      FlyScreen_SetAndroidManifestVersion;
    </BeforeGenerateAndroidManifest>
  </PropertyGroup>

  <Target Name="FlyScreen_SetAndroidManifestVersion"
          DependsOnTargets="ResolveVersionFromGitTag;ApplyExplicitVersion"
          Condition="'$(UseMaui)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
      <ApplicationVersion>$(FlyScreenVersionCode)</ApplicationVersion>
      <_AndroidVersionName>$(Version)</_AndroidVersionName>
      <_AndroidVersionCode>$(FlyScreenVersionCode)</_AndroidVersionCode>
    </PropertyGroup>
    <Message Importance="High"
             Text="Android 清单版本 → versionName=$(_AndroidVersionName) versionCode=$(_AndroidVersionCode)" />
  </Target>

  <!--
    增量：清单版本与当前 Version 不一致时清 stamp，迫使 _GenerateJavaStubs 重跑。
  -->
  <Target Name="FlyScreen_AndroidVersionInput"
          AfterTargets="ResolveVersionFromGitTag;ApplyExplicitVersion"
          Condition="'$(UseMaui)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Version)' != '' And '$(IntermediateOutputPath)' != ''">
    <PropertyGroup>
      <_FsAndroidVersionFile>$(IntermediateOutputPath)flyscreen.version</_FsAndroidVersionFile>
      <_FsAndroidVersionWant>$(Version)|$(FlyScreenVersionCode)</_FsAndroidVersionWant>
      <_FsManifestPath>$(IntermediateOutputPath)AndroidManifest.xml</_FsManifestPath>
      <_FsManifestText Condition="Exists('$(_FsManifestPath)')">$([System.IO.File]::ReadAllText('$(_FsManifestPath)'))</_FsManifestText>
      <_FsNameNeedle>android:versionName=&quot;$(Version)&quot;</_FsNameNeedle>
      <_FsCodeNeedle>android:versionCode=&quot;$(FlyScreenVersionCode)&quot;</_FsCodeNeedle>
      <_FsManifestStale Condition="!Exists('$(_FsManifestPath)') Or !$(_FsManifestText.Contains('$(_FsNameNeedle)')) Or !$(_FsManifestText.Contains('$(_FsCodeNeedle)'))">true</_FsManifestStale>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_FsAndroidVersionFile)" Condition="Exists('$(_FsAndroidVersionFile)')">
      <Output TaskParameter="Lines" PropertyName="_FsAndroidVersionHave" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(_FsAndroidVersionFile)"
                      Lines="$(_FsAndroidVersionWant)"
                      Overwrite="true"
                      Condition="'$(_FsAndroidVersionHave)' != '$(_FsAndroidVersionWant)'" />
    <Delete Files="$(IntermediateOutputPath)stamp\_GenerateJavaStubs.stamp"
            Condition="'$(_FsManifestStale)' == 'true'" />
    <ItemGroup>
      <_GenerateJavaStubsInputs Include="$(_FsAndroidVersionFile)" />
    </ItemGroup>
    <Message Importance="High"
             Condition="'$(_FsManifestStale)' == 'true'"
             Text="Android 清单版本与 $(Version)（code=$(FlyScreenVersionCode)）不一致，将重新生成" />
  </Target>

  <!-- Manifest Merger 之后再扫中间清单，避免 android/*.xml 仍残留 1.0.0 -->
  <Target Name="FlyScreen_PatchAndroidManifestFiles"
          AfterTargets="_ManifestMerger;_GenerateJavaStubs"
          BeforeTargets="_CreateBaseApk;_CompileAndroidPackage;_BuildApkEmbed"
          Condition="'$(UseMaui)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Version)' != '' And '$(FlyScreenVersionCode)' != '' And '$(IntermediateOutputPath)' != ''">
    <ItemGroup>
      <_FsPatchManifest Include="$(IntermediateOutputPath)AndroidManifest.xml" Condition="Exists('$(IntermediateOutputPath)AndroidManifest.xml')" />
      <_FsPatchManifest Include="$(IntermediateOutputPath)android\AndroidManifest.xml" Condition="Exists('$(IntermediateOutputPath)android\AndroidManifest.xml')" />
      <_FsPatchManifest Include="$(IntermediateOutputPath)android\manifest\AndroidManifest.xml" Condition="Exists('$(IntermediateOutputPath)android\manifest\AndroidManifest.xml')" />
    </ItemGroup>
    <PropertyGroup>
      <_FsPatchArgs>@(_FsPatchManifest->'%(FullPath)', ';')</_FsPatchArgs>
    </PropertyGroup>
    <Exec Condition="'@(_FsPatchManifest)' != ''"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Patch-AndroidManifestVersion.ps1&quot; -Version &quot;$(Version)&quot; -VersionCode &quot;$(FlyScreenVersionCode)&quot; -Files &quot;$(_FsPatchArgs)&quot;" />
  </Target>

  <Target Name="WritePublishVersion" AfterTargets="Publish">
    <PropertyGroup>
      <_VerOutDir Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_VerOutDir>
      <_VerOutDir Condition="'$(PublishDir)' == ''">$(OutputPath)</_VerOutDir>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VerOutDir)version.txt" Lines="$(Version)" Overwrite="true" Encoding="UTF-8" />
    <Message Importance="High"
             Text="玄鸟 Version=$(Version)。发版：上传产物到 GitHub Release，并打 tag v$(Version)" />
  </Target>
</Project>
