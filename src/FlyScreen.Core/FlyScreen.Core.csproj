<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FlyScreen</RootNamespace>
    <AssemblyName>FlyScreen.Core</AssemblyName>
    <Description>玄鸟跨平台核心：协议、网络、模型、本地化（无 UI / 无 Win32）</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.ToolSdk\FlyScreen.ToolSdk.csproj" />
    <ProjectReference Include="..\FlyScreen.Assets\FlyScreen.Assets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.4.1" />
    <!-- 脚本编译用 Compilation API；不再依赖 CSharp.Scripting（其会强制 CreateFromFile 运行时 CoreLib） -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Android / 单文件无磁盘框架 DLL：嵌入 net10.0 reference assemblies 供 Roslyn CreateFromImage -->
    <PackageReference Include="Microsoft.NETCore.App.Ref" Version="10.0.7" GeneratePathProperty="true" IncludeAssets="none" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\Programs\Builtin\generic_swipe_main.cs" />
    <EmbeddedResource Include="Services\Programs\Builtin\generic_swipe_main.cs"
                      LogicalName="FlyScreen.Services.Programs.Builtin.generic_swipe_main.cs" />
  </ItemGroup>

  <!-- 脚本编译引用：嵌入常用 net10.0 ref（约 2MB），供 Android/单文件 CreateFromImage -->
  <Target Name="FlyScreen_EmbedScriptRefs"
          BeforeTargets="PrepareResourceNames;CoreCompile"
          DependsOnTargets="ResolvePackageAssets">
    <PropertyGroup>
      <_FsScriptRefDir>$(PkgMicrosoft_NETCore_App_Ref)\ref\net10.0</_FsScriptRefDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(PkgMicrosoft_NETCore_App_Ref)' != '' and Exists('$(_FsScriptRefDir)')">
      <_FsScriptRefName Include="mscorlib.dll;netstandard.dll;System.dll;System.Core.dll;Microsoft.CSharp.dll;System.Runtime.dll;System.Runtime.Extensions.dll;System.Runtime.InteropServices.dll;System.Runtime.CompilerServices.Unsafe.dll;System.Runtime.Numerics.dll;System.Console.dll;System.Collections.dll;System.Collections.Concurrent.dll;System.Collections.Immutable.dll;System.Linq.dll;System.Linq.Expressions.dll;System.Threading.dll;System.Threading.Tasks.dll;System.Threading.Tasks.Extensions.dll;System.Threading.Thread.dll;System.Threading.ThreadPool.dll;System.Threading.Timer.dll;System.Threading.Channels.dll;System.Text.Encoding.dll;System.Text.Encoding.Extensions.dll;System.Text.RegularExpressions.dll;System.Text.Json.dll;System.Text.Encodings.Web.dll;System.Memory.dll;System.Buffers.dll;System.ObjectModel.dll;System.ComponentModel.dll;System.ComponentModel.Primitives.dll;System.IO.dll;System.IO.FileSystem.dll;System.Net.Primitives.dll;System.Net.Http.dll;System.Globalization.dll;System.Reflection.dll;System.Reflection.Extensions.dll;System.Reflection.Primitives.dll;System.Resources.ResourceManager.dll;System.Diagnostics.Debug.dll;System.Diagnostics.Tools.dll;System.Diagnostics.Tracing.dll;System.Numerics.Vectors.dll;System.ValueTuple.dll" />
      <_FsScriptRefCandidate Include="@(_FsScriptRefName->'$(_FsScriptRefDir)\%(Identity)')" />
      <_FsScriptRefFile Include="@(_FsScriptRefCandidate)" Condition="Exists('%(Identity)')" />
      <EmbeddedResource Include="@(_FsScriptRefFile)"
                        LogicalName="FlyScreen.ScriptRefs.%(Filename)%(Extension)"
                        Type="Non-Resx"
                        WithCulture="false" />
    </ItemGroup>
    <Warning Text="FlyScreen_EmbedScriptRefs: 未找到 $(_FsScriptRefDir)，Android C# 脚本将无法编译。"
             Condition="'$(PkgMicrosoft_NETCore_App_Ref)' == '' or !Exists('$(_FsScriptRefDir)')" />
    <Message Importance="High" Text="FlyScreen_EmbedScriptRefs: 已嵌入脚本 ref → @(EmbeddedResource->Count()) 项（含其它嵌入资源）。"
             Condition="'@(_FsScriptRefFile)' != ''" />
  </Target>

</Project>
