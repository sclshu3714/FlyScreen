<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FlyScreen</RootNamespace>
    <AssemblyName>FlyScreen.Core</AssemblyName>
    <Description>玄鸟跨平台核心：协议、网络、模型、本地化（无 UI / 无 Win32）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.4.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\Programs\Builtin\generic_swipe_main.cs" />
    <EmbeddedResource Include="Services\Programs\Builtin\generic_swipe_main.cs"
                      LogicalName="FlyScreen.Services.Programs.Builtin.generic_swipe_main.cs" />
  </ItemGroup>

</Project>
