<UserControl x:Class="FlyScreen.Tool.PortProxy.Ui.Win.PortProxyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WinBg}"
             Foreground="{DynamicResource Text}"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             FontSize="13"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theme:WpfTheme xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Wpf;assembly=FlyScreen.Ui.Theme.Wpf"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 工具条危险色（删除/重置）；其余令牌走统一主题 -->
      <SolidColorBrush x:Key="Warn" Color="#DC2626"/>
      <SolidColorBrush x:Key="WarnSoft" Color="#FEE2E2"/>

      <Style x:Key="ToolBarCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="Padding" Value="10,0,32,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="4,0,4,4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12"
               Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>

    <Border x:Name="AdminBanner" Grid.Row="1" Margin="0,0,0,8" Padding="10,8"
            CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource Line}" Background="{DynamicResource SubtleBg}">
      <TextBlock x:Name="AdminText" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource Text}"/>
    </Border>

    <Border Grid.Row="2" Margin="0,0,0,8" Padding="10,8" CornerRadius="8"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Background="{DynamicResource ControlBg}">
      <DockPanel LastChildFill="False">
        <Button x:Name="AddBtn" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"
                Click="AddBtn_Click"/>
        <Button x:Name="DeleteBtn" Style="{StaticResource SoftWarnBtn}" Margin="0,0,8,0"
                Click="DeleteBtn_Click"/>
        <Button x:Name="RefreshBtn" Style="{StaticResource NormalBtn}" Margin="0,0,8,0"
                Click="RefreshBtn_Click"/>
        <Button x:Name="ResetBtn" Style="{StaticResource SoftWarnBtn}" Margin="0,0,8,0"
                Click="ResetBtn_Click"/>
        <Button x:Name="DumpBtn" Style="{StaticResource NormalBtn}" Margin="0"
                Click="DumpBtn_Click"/>
        <ComboBox x:Name="FilterCombo" DockPanel.Dock="Right" Style="{StaticResource ToolBarCombo}"
                  Width="120" SelectionChanged="FilterCombo_SelectionChanged"/>
      </DockPanel>
    </Border>

    <DataGrid x:Name="RulesGrid" Grid.Row="3"
              IsReadOnly="True"
              AlternationCount="2"
              EnableRowVirtualization="True"
              MouseDoubleClick="RulesGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="44">
          <DataGridTemplateColumn.Header>
            <CheckBox x:Name="SelectAllBox" Click="SelectAllBox_Click" VerticalAlignment="Center"/>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="RowCheck_Click"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn x:Name="ColKind" Binding="{Binding KindToken}" Width="80"/>
        <DataGridTextColumn x:Name="ColListenAddress" Binding="{Binding ListenAddress}" Width="*"/>
        <DataGridTextColumn x:Name="ColListenPort" Binding="{Binding ListenPort}" Width="88"/>
        <DataGridTextColumn x:Name="ColConnectAddress" Binding="{Binding ConnectAddress}" Width="*"/>
        <DataGridTextColumn x:Name="ColConnectPort" Binding="{Binding ConnectPort}" Width="88"/>
        <DataGridTextColumn x:Name="ColProtocol" Binding="{Binding Protocol}" Width="64"/>
        <DataGridTemplateColumn x:Name="ColActions" Width="76">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ProgIconBtn}"
                        ToolTip="{Binding EditLabel}"
                        Tag="{Binding}" Click="RowEdit_Click">
                  <Viewbox Style="{StaticResource ProgRowIcon}">
                    <Path Data="{StaticResource GeoEdit}" Fill="#2563EB"/>
                  </Viewbox>
                </Button>
                <Button Style="{StaticResource ProgIconBtn}" Margin="0"
                        ToolTip="{Binding DeleteLabel}"
                        Tag="{Binding}" Click="RowDelete_Click">
                  <Viewbox Style="{StaticResource ProgRowIcon}">
                    <Path Data="{StaticResource GeoDelete}" Fill="#EF4444"/>
                  </Viewbox>
                </Button>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,8,0,0" FontSize="12"
               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
  </Grid>
</UserControl>
