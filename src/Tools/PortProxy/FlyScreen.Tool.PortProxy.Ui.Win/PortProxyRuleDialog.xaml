<Window x:Class="FlyScreen.Tool.PortProxy.Ui.Win.PortProxyRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        MinWidth="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theme:WpfTheme xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Wpf;assembly=FlyScreen.Ui.Theme.Wpf"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Margin="12" Background="{DynamicResource CardBg}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1"
          CornerRadius="14" Padding="22,20">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text}"
                 HorizontalAlignment="Center" Margin="0,0,0,14"/>

      <TextBlock x:Name="KindLabel" Margin="0,0,0,6" FontSize="12"
                 Foreground="{DynamicResource Muted}"/>
      <ComboBox x:Name="KindCombo" Margin="0,0,0,12" Height="34"/>

      <TextBlock x:Name="ListenAddressLabel" Margin="0,0,0,6" FontSize="12"
                 Foreground="{DynamicResource Muted}"/>
      <TextBox x:Name="ListenAddressBox" Margin="0,0,0,12"/>

      <TextBlock x:Name="ListenPortLabel" Margin="0,0,0,6" FontSize="12"
                 Foreground="{DynamicResource Muted}"/>
      <TextBox x:Name="ListenPortBox" Margin="0,0,0,12"/>

      <TextBlock x:Name="ConnectAddressLabel" Margin="0,0,0,6" FontSize="12"
                 Foreground="{DynamicResource Muted}"/>
      <TextBox x:Name="ConnectAddressBox" Margin="0,0,0,12"/>

      <TextBlock x:Name="ConnectPortLabel" Margin="0,0,0,6" FontSize="12"
                 Foreground="{DynamicResource Muted}"/>
      <TextBox x:Name="ConnectPortBox" Margin="0,0,0,12"/>

      <TextBlock x:Name="ProtocolLabel" Margin="0,0,0,6" FontSize="12"
                 Foreground="{DynamicResource Muted}"/>
      <TextBox x:Name="ProtocolBox" Margin="0,0,0,16" Text="tcp"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelBtn" Style="{StaticResource NormalBtn}" Margin="0,0,8,0"
                Click="CancelBtn_Click" IsCancel="True"/>
        <Button x:Name="OkBtn" Style="{StaticResource PrimaryBtn}" Margin="0"
                Click="OkBtn_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
