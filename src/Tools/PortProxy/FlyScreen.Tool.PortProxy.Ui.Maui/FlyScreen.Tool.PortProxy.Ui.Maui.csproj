<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.Tool.PortProxy.Ui.Maui</RootNamespace>
    <AssemblyName>FlyScreen.Tool.PortProxy.Ui.Maui</AssemblyName>
    <Description>端口代理 Maui UI（Windows 专版工具包）</Description>
