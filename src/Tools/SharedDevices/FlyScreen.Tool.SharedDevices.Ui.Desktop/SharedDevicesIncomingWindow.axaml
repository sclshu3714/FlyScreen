<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.Tool.SharedDevices.Ui.Desktop.SharedDevicesIncomingWindow"
        Width="480" Height="440"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="共享设备申请"
        Background="{DynamicResource WinBg}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="AcceptBtn" Classes="primary" Click="Accept_Click"/>
      <Button x:Name="RejectBtn" Classes="normal" Click="Reject_Click"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap"/>
        <StackPanel x:Name="DevicePanel" Spacing="8"/>
        <CheckBox x:Name="RememberCheck"/>
        <TextBlock x:Name="RememberHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
