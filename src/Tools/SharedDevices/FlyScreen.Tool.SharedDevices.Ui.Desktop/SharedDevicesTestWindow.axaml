<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.Tool.SharedDevices.Ui.Desktop.SharedDevicesTestWindow"
        Width="560" Height="560"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="共享设备测试"
        Background="{DynamicResource WinBg}">
  <DockPanel Margin="16">
    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Button x:Name="CloseBtn" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"
            Classes="normal" Click="Close_Click"/>
    <ScrollViewer>
      <StackPanel Spacing="12">
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock x:Name="CameraTitle" FontWeight="SemiBold"/>
            <TextBlock x:Name="CameraHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CameraStartBtn" Classes="primary" Click="CameraStart_Click"/>
              <Button x:Name="CameraStopBtn" Classes="normal" Click="CameraStop_Click" IsEnabled="False"/>
            </StackPanel>
            <Border Background="{DynamicResource SubtleBg}" CornerRadius="8" Height="220" ClipToBounds="True">
              <Panel>
                <Image x:Name="CameraPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="CameraStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}"/>
              </Panel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock x:Name="SpeakerTitle" FontWeight="SemiBold"/>
            <TextBlock x:Name="SpeakerHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SpeakerPlayBtn" Classes="primary" Click="SpeakerPlay_Click"/>
              <TextBlock x:Name="SpeakerStatus" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock x:Name="MicTitle" FontWeight="SemiBold"/>
            <TextBlock x:Name="MicHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="MicStartBtn" Classes="primary" Click="MicStart_Click"/>
              <Button x:Name="MicStopBtn" Classes="normal" Click="MicStop_Click" IsEnabled="False"/>
              <TextBlock x:Name="MicStatus" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource Muted}"/>
            </StackPanel>
            <ProgressBar x:Name="MicLevel" Minimum="0" Maximum="100" Value="0" Height="12"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
