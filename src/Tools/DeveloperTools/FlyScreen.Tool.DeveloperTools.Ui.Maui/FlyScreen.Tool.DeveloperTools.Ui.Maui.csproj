<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.Tool.DeveloperTools.Ui.Maui</RootNamespace>
    <AssemblyName>FlyScreen.Tool.DeveloperTools.Ui.Maui</AssemblyName>
    <Description>开发者工具 Maui UI</Description>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
