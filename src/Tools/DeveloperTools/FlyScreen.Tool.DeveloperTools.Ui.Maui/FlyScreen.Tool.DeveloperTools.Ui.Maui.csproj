  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Tool.DeveloperTools\FlyScreen.Tool.DeveloperTools.csproj" />
    <ProjectReference Include="..\..\..\FlyScreen.ToolSdk\FlyScreen.ToolSdk.csproj" />
    <ProjectReference Include="..\..\..\FlyScreen.Core\FlyScreen.Core.csproj" />
    <ProjectReference Include="..\..\..\Theme\FlyScreen.Ui.Theme.Maui\FlyScreen.Ui.Theme.Maui.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="..\..\..\FlyScreen.Windows\FlyScreen.Windows.csproj" />
  </ItemGroup>
</Project>
