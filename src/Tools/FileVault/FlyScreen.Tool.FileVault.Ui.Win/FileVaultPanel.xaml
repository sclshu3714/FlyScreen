<UserControl x:Class="FlyScreen.Tool.FileVault.Ui.Win.FileVaultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
      <TextBlock x:Name="SecurityNoticeText" TextWrapping="Wrap" FontSize="11"
                 Foreground="{DynamicResource Muted}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="CreateBtn" Margin="0,0,6,0" Padding="10,6" Click="CreateBtn_Click"/>
      <Button x:Name="OpenBtn" Margin="0,0,6,0" Padding="10,6" Click="OpenBtn_Click"/>
      <Button x:Name="UnlockBtn" Margin="0,0,6,0" Padding="10,6" Click="UnlockBtn_Click"/>
      <Button x:Name="LockBtn" Margin="0,0,6,0" Padding="10,6" Click="LockBtn_Click"/>
      <TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="{DynamicResource Text}"/>
    </StackPanel>

    <WrapPanel Grid.Row="2" Margin="0,0,0,4">
      <Button x:Name="UpBtn" Margin="0,0,6,6" Padding="10,6" Click="UpBtn_Click"/>
      <Button x:Name="ImportBtn" Margin="0,0,6,6" Padding="10,6" Click="ImportBtn_Click"/>
      <Button x:Name="ImportFolderBtn" Margin="0,0,6,6" Padding="10,6" Click="ImportFolderBtn_Click"/>
      <Button x:Name="ExportBtn" Margin="0,0,6,6" Padding="10,6" Click="ExportBtn_Click"/>
      <Button x:Name="DeleteBtn" Margin="0,0,6,6" Padding="10,6" Click="DeleteBtn_Click"/>
      <Button x:Name="NewFolderBtn" Margin="0,0,6,6" Padding="10,6" Click="NewFolderBtn_Click"/>
      <Button x:Name="MountBtn" Margin="0,0,6,6" Padding="10,6" Click="MountBtn_Click"/>
      <Button x:Name="OpenMountBtn" Margin="0,0,6,6" Padding="10,6" Click="OpenMountBtn_Click"/>
      <Button x:Name="MigrateBtn" Margin="0,0,6,6" Padding="10,6" Click="MigrateBtn_Click"/>
      <Button x:Name="BackupBtn" Margin="0,0,6,6" Padding="10,6" Click="BackupBtn_Click"/>
      <Button x:Name="RestoreBtn" Margin="0,0,6,6" Padding="10,6" Click="RestoreBtn_Click"/>
      <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="8,0,0,6"
                 Foreground="{DynamicResource Muted}"/>
    </WrapPanel>

    <WrapPanel Grid.Row="3" Margin="0,0,0,8">
      <CheckBox x:Name="SecureDeleteCheck" Margin="0,0,12,4" VerticalAlignment="Center"
                Checked="Settings_Changed" Unchecked="Settings_Changed"/>
      <CheckBox x:Name="AutoMountCheck" Margin="0,0,12,4" VerticalAlignment="Center"
                Checked="Settings_Changed" Unchecked="Settings_Changed"/>
      <TextBlock x:Name="IdleLockLabel" VerticalAlignment="Center" Margin="0,0,6,4"
                 Foreground="{DynamicResource Muted}"/>
      <TextBox x:Name="IdleLockBox" Width="48" Margin="0,0,0,4" VerticalAlignment="Center"
               LostFocus="IdleLockBox_LostFocus"/>
    </WrapPanel>

    <ListView x:Name="EntryList" Grid.Row="4"
              BorderBrush="{DynamicResource Line}" BorderThickness="1"
              MouseDoubleClick="EntryList_MouseDoubleClick">
      <ListView.View>
        <GridView>
          <GridViewColumn x:Name="ColName" Width="280" DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn x:Name="ColSize" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
          <GridViewColumn x:Name="ColModified" Width="160" DisplayMemberBinding="{Binding ModifiedText}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,8,0,0" FontSize="12"
               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
