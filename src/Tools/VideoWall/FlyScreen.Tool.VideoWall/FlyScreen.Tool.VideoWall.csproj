<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FlyScreen.Tool.VideoWall</RootNamespace>
    <AssemblyName>FlyScreen.Tool.VideoWall</AssemblyName>
    <Description>玄鸟视频墙工具包（LibVLC 播放后端、源目录与宫格装配）</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- 类库默认不拷贝 NuGet 依赖；.flytool ALC 需要旁路 LibVLCSharp.dll -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FlyScreen.Core\FlyScreen.Core.csproj" />
    <ProjectReference Include="..\..\..\FlyScreen.ToolSdk\FlyScreen.ToolSdk.csproj" />
    <PackageReference Include="LibVLCSharp" Version="3.9.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\tool-video-wall.png" LogicalName="FlyScreen.Tool.VideoWall.Icons.tool-video-wall.png" />
  </ItemGroup>
</Project>
