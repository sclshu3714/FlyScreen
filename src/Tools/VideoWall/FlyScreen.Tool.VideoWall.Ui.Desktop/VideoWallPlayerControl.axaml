<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlyScreen.Tool.VideoWall.Ui.Desktop.VideoWallPlayerControl"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="#000000"
             SizeChanged="Root_SizeChanged">
  <UserControl.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.chromeText">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <StreamGeometry x:Key="GeoBack">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</StreamGeometry>
    <StreamGeometry x:Key="GeoPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
    <StreamGeometry x:Key="GeoPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
    <StreamGeometry x:Key="GeoPause">M14,19H18V5H14M6,19H10V5H6V19Z</StreamGeometry>
    <StreamGeometry x:Key="GeoNext">M6,18L14.5,12L6,6V18M16,6V18H18V6H16Z</StreamGeometry>
    <StreamGeometry x:Key="GeoSeekFwd5">M12,5V1L17,6L12,11V7C8.69,7 6,9.69 6,13C6,16.31 8.69,19 12,19C15.31,19 18,16.31 18,13H20C20,17.42 16.42,21 12,21C7.58,21 4,17.42 4,13C4,8.58 7.58,5 12,5Z</StreamGeometry>
    <StreamGeometry x:Key="GeoSettings">M12,2L20.66,7V17L12,22L3.34,17V7L12,2M12,8.5A3.5,3.5 0 1 0 12,15.5A3.5,3.5 0 1 0 12,8.5Z</StreamGeometry>
    <StreamGeometry x:Key="GeoPip">M19,11H11V17H19V11M23,19V5C23,3.88 22.1,3 21,3H3A2,2 0 0,0 1,5V19A2,2 0 0,0 3,21H21A2,2 0 0,0 23,19M21,19H3V4.97H21V19Z</StreamGeometry>
    <StreamGeometry x:Key="GeoMaximize">M4,4H20V20H4V4M6,8V18H18V8H6Z</StreamGeometry>
    <StreamGeometry x:Key="GeoChevronRight">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
    <LinearGradientBrush x:Key="PlaybackVolumeGradient" StartPoint="0,1" EndPoint="0,0">
      <GradientStop Color="Lime" Offset="0"/>
      <GradientStop Color="Cyan" Offset="0.5"/>
      <GradientStop Color="SkyBlue" Offset="1"/>
    </LinearGradientBrush>
    <StreamGeometry x:Key="GeoVolume">M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z</StreamGeometry>
    <StreamGeometry x:Key="GeoMute">M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z</StreamGeometry>
    <StreamGeometry x:Key="GeoFullscreen">M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z</StreamGeometry>
    <StreamGeometry x:Key="GeoFullscreenExit">M14,14H19V16H16V19H14V14M5,14H10V19H8V16H5V14M8,5H10V10H5V8H8V5M16,8V5H14V10H19V8H16Z</StreamGeometry>
  </UserControl.Resources>

  <!-- 近透明底保证 PointerMoved 覆盖整块播放区；纯透明时悬停不触发 -->
  <Grid x:Name="PlaybackRoot" Background="#01000000"
        PointerMoved="Root_PointerMoved" PointerEntered="Root_PointerEntered"
        PointerReleased="Root_PointerReleased">
    <Border x:Name="PlaybackVideoHost" MinHeight="200" Background="Black"
            CornerRadius="0" Margin="0">
      <Image x:Name="PlaybackFrameImage" Stretch="Uniform"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Border>

    <Border x:Name="PlaybackTitleBarHost" Height="56" VerticalAlignment="Top" ZIndex="2">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F20B1220" Offset="0"/>
          <GradientStop Color="#CC0B1220" Offset="0.55"/>
          <GradientStop Color="#000B1220" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid x:Name="PlaybackTitleBar" Margin="12,0,12,8" Height="44" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="PlaybackBackBtn" Classes="chrome"
                Click="PlaybackBackBtn_Click" Margin="0,0,8,0">
          <Path Width="18" Height="18" Fill="White" Stretch="Uniform"
                Data="{StaticResource GeoBack}"/>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <TextBlock x:Name="PlaybackTitle" FontSize="15" FontWeight="SemiBold" Foreground="White"
                     TextTrimming="CharacterEllipsis" MaxWidth="520"/>
          <TextBlock x:Name="PlaybackTitleDuration" FontSize="13" Foreground="#94A3B8"
                     FontFamily="Consolas" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="PlaybackTransportBar" VerticalAlignment="Bottom" CornerRadius="0"
            Padding="16,28,16,14" BorderThickness="0" ZIndex="2">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#000B1220" Offset="0"/>
          <GradientStop Color="#990B1220" Offset="0.35"/>
          <GradientStop Color="#E60B1220" Offset="0.75"/>
          <GradientStop Color="#F20B1220" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid Height="40">
          <Slider x:Name="PlaybackSeekBar" Minimum="0" Maximum="1000" Value="0"
                  Height="16" VerticalAlignment="Bottom" Margin="0,0,0,8"
                  PointerPressed="PlaybackSeekBar_PointerPressed"
                  PointerMoved="PlaybackSeekBar_PointerMoved"
                  PointerReleased="PlaybackSeekBar_PointerReleased"
                  SizeChanged="PlaybackSeekBar_SizeChanged"/>
          <!-- 关键事件白点：点击跳转，右键进度条添加，右键白点删除 -->
          <Canvas x:Name="PlaybackCueLayer" Height="16" VerticalAlignment="Bottom"
                  Margin="0,0,0,8"/>
          <TextBlock x:Name="PlaybackTimeText" Text="00:00" Foreground="#CCE5E7EB" FontSize="11"
                     FontFamily="Consolas" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     IsHitTestVisible="False"/>
          <TextBlock x:Name="PlaybackLengthText" Text="00:00" Foreground="#CCE5E7EB" FontSize="11"
                     FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="PlaybackPlayPauseBtn" Classes="chrome" Click="PlaybackPlayPause_Click">
              <Path x:Name="PlaybackPlayPauseIcon" Width="22" Height="22" Fill="White" Stretch="Uniform"
                    Data="{StaticResource GeoPause}"/>
            </Button>
            <Button x:Name="PlaybackSeekFwdBtn" Classes="chrome" Click="PlaybackSeekFwd_Click">
              <Path Width="20" Height="20" Fill="White" Stretch="Uniform"
                    Data="{StaticResource GeoNext}"/>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="PlaybackSpeedBtn" Classes="chromeText" Content="倍速"
                    Click="PlaybackSpeedBtn_Click"/>

            <!-- 清晰度 -->
            <Panel>
              <Button x:Name="PlaybackQualityBtn" Classes="chromeText" Content="智能"
                      Click="PlaybackQualityBtn_Click"/>
              <Popup x:Name="PlaybackQualityPopup" Placement="Top" PlacementTarget="PlaybackQualityBtn"
                     IsLightDismissEnabled="True" Closed="MenuPopup_Closed">
                <Border Background="#F2161B26" CornerRadius="10" Padding="8"
                        BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="140">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="PlaybackQualityTitle" Foreground="#94A3B8" FontSize="11"
                               Margin="8,2,8,0"/>
                    <Border Background="#22FFFFFF" CornerRadius="6" Padding="12,7">
                      <TextBlock x:Name="PlaybackQualityAutoText" Foreground="#00D4C8" FontSize="13"/>
                    </Border>
                    <TextBlock x:Name="PlaybackQualityCurrentText" Foreground="#CCE5E7EB" FontSize="12"
                               Margin="12,2,12,2"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Panel>

            <!-- 选集 -->
            <Panel>
              <Button x:Name="PlaybackEpisodesBtn" Classes="chromeText" Content="选集"
                      Click="PlaybackEpisodesBtn_Click"/>
              <Popup x:Name="PlaybackEpisodesPopup" Placement="Top" PlacementTarget="PlaybackEpisodesBtn"
                     IsLightDismissEnabled="True" Closed="MenuPopup_Closed">
                <Border Background="#F2161B26" CornerRadius="10" Padding="8"
                        BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="200" MaxWidth="320">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="PlaybackEpisodesTitle" Foreground="#94A3B8" FontSize="11"
                               Margin="8,2,8,0"/>
                    <ListBox x:Name="PlaybackEpisodesList" Background="Transparent" Foreground="#E5E7EB"
                             BorderThickness="0" MaxHeight="260"
                             SelectionChanged="PlaybackEpisodesList_SelectionChanged"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Panel>

            <!-- 设置 -->
            <Panel>
              <Button x:Name="PlaybackSettingsBtn" Classes="chrome" Click="PlaybackSettingsBtn_Click">
                <Path Width="18" Height="18" Fill="White" Stretch="Uniform"
                      Data="{StaticResource GeoSettings}"/>
              </Button>
              <Popup x:Name="PlaybackSettingsPopup" Placement="Top" PlacementTarget="PlaybackSettingsBtn"
                     IsLightDismissEnabled="True" Closed="MenuPopup_Closed">
                <Border Background="#F2161B26" CornerRadius="12" Padding="16,14"
                        BorderBrush="#33FFFFFF" BorderThickness="1" Width="260">
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="PlaybackSettingsTitle" Foreground="White" FontSize="14"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="PlaybackLoopLabel" Foreground="#E5E7EB" FontSize="13"
                                 VerticalAlignment="Center"/>
                      <ToggleSwitch x:Name="PlaybackLoopSwitch" Grid.Column="1" OnContent="" OffContent=""
                                    IsCheckedChanged="PlaybackLoopSwitch_Changed"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="PlaybackEpisodeTitleLabel" Foreground="#E5E7EB" FontSize="13"
                                 VerticalAlignment="Center"/>
                      <ToggleSwitch x:Name="PlaybackEpisodeTitleSwitch" Grid.Column="1" OnContent="" OffContent=""
                                    IsChecked="True" IsCheckedChanged="PlaybackEpisodeTitleSwitch_Changed"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="PlaybackAspectLabel" Foreground="#E5E7EB" FontSize="13"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="PlaybackAspectValue" Grid.Column="1" Foreground="#94A3B8"
                                 FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="PlaybackDiagRow" Background="Transparent" Cursor="Hand"
                            PointerReleased="PlaybackDiagRow_PointerReleased">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="PlaybackDiagLabel" Foreground="#E5E7EB" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Path Grid.Column="1" Width="14" Height="14" Fill="#94A3B8" Stretch="Uniform"
                              Data="{StaticResource GeoChevronRight}"/>
                      </Grid>
                    </Border>
                    <TextBlock x:Name="PlaybackDiagText" Foreground="#CCE5E7EB" FontSize="11"
                               TextWrapping="Wrap" IsVisible="False" FontFamily="Consolas"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Panel>

            <Panel x:Name="PlaybackVolumeHost" Width="36" Height="34"
                   PointerEntered="PlaybackVolumeHost_PointerEntered"
                   PointerExited="PlaybackVolumeHost_PointerExited">
              <Button x:Name="PlaybackMuteBtn" Classes="chrome" Margin="0"
                      Click="PlaybackMute_Click">
                <Path x:Name="PlaybackMuteIcon" Width="18" Height="18" Fill="White" Stretch="Uniform"
                      Data="{StaticResource GeoVolume}"/>
              </Button>
              <Popup x:Name="PlaybackVolumePopup" Placement="Top"
                     PlacementTarget="PlaybackVolumeHost" IsLightDismissEnabled="False">
                <Border Background="#E6111827" CornerRadius="10" Padding="10,12"
                        BorderBrush="#33FFFFFF" BorderThickness="1"
                        PointerEntered="PlaybackVolumePopup_PointerEntered"
                        PointerExited="PlaybackVolumePopup_PointerExited">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="PlaybackVolumePct" Text="100%" Foreground="White"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <Slider x:Name="PlaybackVolumeBar" Orientation="Vertical"
                            Width="28" Height="120" Minimum="0" Maximum="100" Value="100">
                      <!-- 已播段用 绿→青→蓝 渐变 -->
                      <Slider.Resources>
                        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="PlaybackVolumeGradient"/>
                        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="PlaybackVolumeGradient"/>
                        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="PlaybackVolumeGradient"/>
                        <SolidColorBrush x:Key="SliderTrackFill" Color="#3B4252"/>
                        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3B4252"/>
                        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#3B4252"/>
                      </Slider.Resources>
                    </Slider>
                  </StackPanel>
                </Border>
              </Popup>
            </Panel>
            <Button x:Name="PlaybackPipBtn" Classes="chrome" Click="PlaybackPip_Click">
              <Path Width="18" Height="18" Fill="White" Stretch="Uniform"
                    Data="{StaticResource GeoPip}"/>
            </Button>
            <Button x:Name="PlaybackMaximizeBtn" Classes="chrome" Click="PlaybackMaximize_Click">
              <Path Width="16" Height="16" Fill="White" Stretch="Uniform"
                    Data="{StaticResource GeoMaximize}"/>
            </Button>
            <Button x:Name="PlaybackFullscreenBtn" Classes="chrome" Margin="0"
                    Click="PlaybackFullscreen_Click">
              <Path x:Name="PlaybackFullscreenIcon" Width="16" Height="16" Fill="White" Stretch="Uniform"
                    Data="{StaticResource GeoFullscreen}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
