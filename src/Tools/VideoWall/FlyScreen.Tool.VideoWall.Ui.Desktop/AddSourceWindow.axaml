<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.Tool.VideoWall.Ui.Desktop.AddSourceWindow"
        Width="480" MinHeight="280" MaxHeight="560"
        SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Margin="0,0,8,0">
        <StackPanel Spacing="4">
          <TextBlock x:Name="TypeLabel" FontSize="12" Opacity="0.7"/>
          <ComboBox x:Name="TypeCombo" MinHeight="36"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock x:Name="NameLabel" FontSize="12" Opacity="0.7"/>
          <TextBox x:Name="NameBox" MinHeight="36"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock x:Name="AddressLabel" FontSize="12" Opacity="0.7"/>
          <TextBox x:Name="AddressBox" AcceptsReturn="False" MinHeight="36"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock x:Name="AuthLabel" FontSize="12" Opacity="0.7"/>
          <ComboBox x:Name="AuthCombo" MinHeight="36"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock x:Name="UserLabel" FontSize="12" Opacity="0.7"/>
          <TextBox x:Name="UserBox" MinHeight="36"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock x:Name="PassLabel" FontSize="12" Opacity="0.7"/>
          <TextBox x:Name="PassBox" PasswordChar="●" MinHeight="36"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
      <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelBtn" Click="CancelBtn_Click" MinWidth="80"/>
        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Classes="primary" MinWidth="80"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
