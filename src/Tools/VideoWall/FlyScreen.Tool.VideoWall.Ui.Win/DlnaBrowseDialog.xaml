<Window x:Class="FlyScreen.Tool.VideoWall.Ui.Win.DlnaBrowseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="860" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinWidth="640" MinHeight="420"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theme:WpfTheme xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Wpf;assembly=FlyScreen.Ui.Theme.Wpf"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="HdrTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text}"/>
      <Button x:Name="DiscoverBtn" Grid.Column="1" Style="{StaticResource DlgPrimaryBtn}"
              Padding="10,4" VerticalAlignment="Center" Click="DiscoverBtn_Click">
        <StackPanel Orientation="Horizontal">
          <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
            <Path Data="{StaticResource GeoRefresh}" Fill="White"/>
          </Viewbox>
          <TextBlock x:Name="DiscoverBtnText" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="160"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="280"/>
      </Grid.ColumnDefinitions>

      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource ListBg}" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleBg}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <TextBlock x:Name="HdrServers" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource Muted}"/>
          </Border>
          <ListBox x:Name="ServerList" BorderThickness="0"
                   Background="{DynamicResource ListBg}"
                   Foreground="{DynamicResource Text}"
                   SelectionChanged="ServerList_SelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="10,8"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Text}"/>
                  <TextBlock Text="{Binding HostHint}" FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource ListBg}" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleBg}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="UpBtn" Style="{StaticResource DlgNormalBtn}" Padding="10,4"
                      Click="UpBtn_Click" Margin="0,0,8,0"/>
              <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
              <Button x:Name="LoadMoreBtn" Grid.Column="2" Style="{StaticResource DlgNormalBtn}"
                      Padding="10,4" Click="LoadMoreBtn_Click" Margin="8,0,0,0"/>
            </Grid>
          </Border>
          <ListView x:Name="NodeList" BorderThickness="0"
                    Background="{DynamicResource ListBg}"
                    Foreground="{DynamicResource Text}"
                    SelectionMode="Single"
                    MouseDoubleClick="NodeList_MouseDoubleClick">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="40">
                  <GridViewColumn.Header>
                    <CheckBox x:Name="HeaderSelectAll" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Click="HeaderSelectAll_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding CanSelect}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Click="RowCheck_Click"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="ColName" Width="360" DisplayMemberBinding="{Binding Title}"/>
                <GridViewColumn x:Name="ColKind" Width="72" DisplayMemberBinding="{Binding KindLabel}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="SelectedText" VerticalAlignment="Center" Margin="0,0,12,0"
                 Foreground="{DynamicResource Muted}"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                 Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <Button x:Name="AddSourcesBtn" Grid.Column="2" Style="{StaticResource DlgPrimaryBtn}"
              Margin="0,0,8,0" Click="AddSourcesBtn_Click"/>
      <Button x:Name="CloseBtn" Grid.Column="3" Style="{StaticResource DlgNormalBtn}"
              IsCancel="True" Click="CloseBtn_Click"/>
    </Grid>
  </Grid>
</Window>
