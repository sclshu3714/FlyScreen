<Window x:Class="FlyScreen.Tool.VideoWall.Ui.Win.ScanDevicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FlyScreen.Ui.Wpf;assembly=FlyScreen.Ui.Wpf"
        Title="" Width="640" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinWidth="520" MinHeight="420"
        ShowInTaskbar="False"
        Background="#80000000"
        AllowsTransparency="True" WindowStyle="None"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/VideoWallWinControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
      <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
      <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
      <SolidColorBrush x:Key="Text" Color="#111827"/>
      <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>
      <Geometry x:Key="GeoAdd">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
      <Geometry x:Key="GeoCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</Geometry>
    </ResourceDictionary>
  </Window.Resources>

  <!-- 居中卡片 -->
  <Grid>
    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="600" MaxHeight="480" MinHeight="400"
            Background="{DynamicResource CardBg}" CornerRadius="12"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Padding="20">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"
                   Foreground="{DynamicResource Text}"/>

        <!-- 网段 + 模板 + 扫描 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="SubnetLabel" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="SubnetBox" Height="34"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock x:Name="VendorLabel" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <ComboBox x:Name="VendorCombo" Height="34"/>
          </StackPanel>
          <Button x:Name="RescanBtn" Grid.Column="2" Style="{StaticResource DlgPrimaryBtn}"
                  Margin="10,18,0,0" VerticalAlignment="Bottom" Click="RescanBtn_Click"/>
        </Grid>

        <!-- 凭据 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <TextBlock x:Name="UserLabel" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Height="34"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <TextBlock x:Name="PassLabel" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <ui:SecurePasswordBox x:Name="PassBox" Height="34"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                Background="#FAFAFA" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="12,8" >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="HdrHost" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="HdrKind" Grid.Column="1" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="HdrPorts" Grid.Column="2" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="HdrActions" Grid.Column="3" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Muted}"/>
            </Grid>
            <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="12,8"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="0.8*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Host}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding KindHint}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}"/>
                    <TextBlock Grid.Column="2" Text="{Binding PortsText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="3" Style="{StaticResource DlgPrimaryBtn}" Padding="8,4"
                            Content="{Binding ActionLabel}" IsEnabled="{Binding CanAdd}"
                            Tag="{Binding}" Click="AddDevice_Click" HorizontalAlignment="Left"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,8"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CloseBtn" Style="{StaticResource DlgBtn}" IsCancel="True" Click="CloseBtn_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
