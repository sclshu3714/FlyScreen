<UserControl x:Class="FlyScreen.Tool.VideoWall.Ui.Win.VideoWallPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FlyScreen.Ui.Wpf;assembly=FlyScreen.Ui.Wpf"
             Background="#000000"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             MouseMove="Root_MouseMove"
             SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:WpfTheme xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Wpf;assembly=FlyScreen.Ui.Theme.Wpf"/>
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="TitleChromeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F20B1220" Offset="0"/>
                <GradientStop Color="#CC0B1220" Offset="0.55"/>
                <GradientStop Color="#000B1220" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TransportChromeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#000B1220" Offset="0"/>
                <GradientStop Color="#990B1220" Offset="0.35"/>
                <GradientStop Color="#E60B1220" Offset="0.75"/>
                <GradientStop Color="#F20B1220" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="ChromeTextBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 播放器 chrome：透明底 + 白图标，避免白底圆角方块 -->
            <Style x:Key="ChromeIconBtn" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="Transparent" BorderThickness="0"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 设置弹层里的开关 -->
            <Style x:Key="ChromeSwitch" TargetType="ToggleButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <Border x:Name="Track" CornerRadius="10" Background="#66FFFFFF"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource PlaybackAccent}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 选集列表项（深色弹层） -->
            <Style x:Key="ChromeListItem" TargetType="ListBoxItem">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="#E5E7EB"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PlaybackAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 单路完整嵌入：软件帧 Image + 同树 chrome（无 VideoView ForegroundWindow） -->
    <Grid x:Name="PlaybackRoot">
        <Border x:Name="PlaybackVideoSlot">
            <Grid x:Name="PlaybackVideoHost" Background="Black" ClipToBounds="True"
                  MouseMove="PlaybackChromeOverlay_MouseMove"
                  MouseEnter="PlaybackChromeOverlay_MouseEnter"
                  PreviewMouseLeftButtonUp="PlaybackChromeOverlay_PreviewMouseLeftButtonUp">
                <Image x:Name="PlaybackFrameImage" Stretch="Uniform"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <ui:LoadingOverlay x:Name="PlaybackLoading" Panel.ZIndex="1"/>
                <Grid x:Name="PlaybackChromeOverlay" Background="#01000000">
                        <Border x:Name="PlaybackTitleBarHost" VerticalAlignment="Top" Height="56"
            Background="{StaticResource TitleChromeBrush}" Panel.ZIndex="2">
                            <Grid x:Name="PlaybackTitleBar" Margin="12,0,12,8" VerticalAlignment="Top" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlaybackBackBtn" Style="{StaticResource ChromeIconBtn}" Margin="0,0,8,0"
                VerticalAlignment="Center" Click="PlaybackBackBtn_Click">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource GeoBack}" Fill="White"/>
                                    </Viewbox>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlaybackTitle"
                     FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"
                     Foreground="White" MaxWidth="520"/>
                                    <TextBlock x:Name="PlaybackTitleDuration" FontSize="13" Foreground="#94A3B8"
                     Margin="10,0,0,0" VerticalAlignment="Center"
                     FontFamily="Consolas, Cascadia Mono, monospace"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="PlaybackTransportSlot" VerticalAlignment="Bottom" Panel.ZIndex="2">
                            <Border x:Name="PlaybackTransportBar"
              Background="{StaticResource TransportChromeBrush}"
              BorderThickness="0" CornerRadius="0" Padding="16,28,16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 全宽进度 + 关键事件白点（可点击跳转/右键添加）+ 两端时间 -->
                                    <Grid Height="40" Margin="0,0,0,8">
                                        <Slider x:Name="PlaybackSeekBar" Style="{StaticResource PlaybackSeekSlider}"
                    VerticalAlignment="Bottom" Margin="0,0,0,8"
                    PreviewMouseLeftButtonDown="PlaybackSeekBar_PreviewMouseDown"
                    PreviewMouseMove="PlaybackSeekBar_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="PlaybackSeekBar_PreviewMouseUp"
                    LostMouseCapture="PlaybackSeekBar_LostMouseCapture"
                    PreviewMouseRightButtonUp="PlaybackSeekBar_PreviewMouseRightButtonUp"
                    ValueChanged="PlaybackSeekBar_ValueChanged"
                    SizeChanged="PlaybackSeekBar_SizeChanged"/>
                                        <Canvas x:Name="PlaybackCueLayer" Height="16" VerticalAlignment="Bottom"
                    Margin="0,0,0,8" ClipToBounds="False"/>
                                        <TextBlock x:Name="PlaybackTimeText" Text="00:00"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Foreground="#CCE5E7EB" FontSize="11" Margin="0,0,0,0"
                       FontFamily="Consolas, Cascadia Mono, monospace" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="PlaybackLengthText" Text="00:00"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="#CCE5E7EB" FontSize="11"
                       FontFamily="Consolas, Cascadia Mono, monospace" IsHitTestVisible="False"/>
                                    </Grid>

                                    <!-- 左：暂停/下一集；右：倍速/竖向音量/全屏 -->
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PlaybackPlayPauseBtn" Style="{StaticResource ChromeIconBtn}"
                      Margin="0,0,6,0" Click="PlaybackPlayPause_Click">
                                                <Viewbox Width="22" Height="22">
                                                    <Path x:Name="PlaybackPlayPauseIcon" Data="{StaticResource GeoPause}" Fill="White"/>
                                                </Viewbox>
                                            </Button>
                                            <Button x:Name="PlaybackSeekFwdBtn" Style="{StaticResource ChromeIconBtn}"
                      Click="PlaybackSeekFwd_Click">
                                                <Viewbox Width="20" Height="20">
                                                    <Path Data="{StaticResource GeoNext}" Fill="White"/>
                                                </Viewbox>
                                            </Button>
                                            <!-- 保留隐藏入口，避免破坏现有事件/本地化引用 -->
                                            <Button x:Name="PlaybackSeekBackBtn" Style="{StaticResource ChromeIconBtn}"
                      Visibility="Collapsed" Click="PlaybackSeekBack_Click"/>
                                            <Button x:Name="PlaybackStopBtn" Style="{StaticResource ChromeIconBtn}"
                      Visibility="Collapsed" Click="PlaybackStop_Click"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PlaybackSpeedBtn" Style="{StaticResource ChromeTextBtn}"
                      Content="倍速" Click="PlaybackSpeedBtn_Click"/>

                                            <!-- 清晰度 -->
                                            <Grid>
                                                <Button x:Name="PlaybackQualityBtn" Style="{StaticResource ChromeTextBtn}"
                        Content="智能" Click="PlaybackQualityBtn_Click"/>
                                                <Popup x:Name="PlaybackQualityPopup" Placement="Top"
                       AllowsTransparency="True" StaysOpen="False" VerticalOffset="-8"
                       Closed="MenuPopup_Closed">
                                                    <Border Background="#F2161B26" CornerRadius="10" Padding="8"
                          BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="140">
                                                        <StackPanel>
                                                            <TextBlock x:Name="PlaybackQualityTitle" Foreground="#94A3B8" FontSize="11"
                                 Margin="8,2,8,6"/>
                                                            <Border Background="#22FFFFFF" CornerRadius="6" Padding="12,7">
                                                                <TextBlock x:Name="PlaybackQualityAutoText" Foreground="#00D4C8" FontSize="13"/>
                                                            </Border>
                                                            <TextBlock x:Name="PlaybackQualityCurrentText" Foreground="#CCE5E7EB" FontSize="12"
                                 Margin="12,8,12,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- 选集 -->
                                            <Grid>
                                                <Button x:Name="PlaybackEpisodesBtn" Style="{StaticResource ChromeTextBtn}"
                        Content="选集" Click="PlaybackEpisodesBtn_Click"/>
                                                <Popup x:Name="PlaybackEpisodesPopup" Placement="Top"
                       AllowsTransparency="True" StaysOpen="False" VerticalOffset="-8"
                       Closed="MenuPopup_Closed">
                                                    <Border Background="#F2161B26" CornerRadius="10" Padding="8"
                          BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="200" MaxWidth="320">
                                                        <StackPanel>
                                                            <TextBlock x:Name="PlaybackEpisodesTitle" Foreground="#94A3B8" FontSize="11"
                                 Margin="8,2,8,6"/>
                                                            <ListBox x:Name="PlaybackEpisodesList" Background="Transparent" BorderThickness="0"
                               MaxHeight="260" ItemContainerStyle="{StaticResource ChromeListItem}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               SelectionChanged="PlaybackEpisodesList_SelectionChanged"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- 设置 -->
                                            <Grid>
                                                <Button x:Name="PlaybackSettingsBtn" Style="{StaticResource ChromeIconBtn}"
                        Click="PlaybackSettingsBtn_Click">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="{StaticResource GeoSettings}" Fill="White"/>
                                                    </Viewbox>
                                                </Button>
                                                <Popup x:Name="PlaybackSettingsPopup" Placement="Top"
                       AllowsTransparency="True" StaysOpen="False" VerticalOffset="-8"
                       Closed="MenuPopup_Closed">
                                                    <Border Background="#F2161B26" CornerRadius="12" Padding="16,14"
                          BorderBrush="#33FFFFFF" BorderThickness="1" Width="260">
                                                        <StackPanel>
                                                            <TextBlock x:Name="PlaybackSettingsTitle" Foreground="White" FontSize="14"
                                 FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                            <Grid Margin="0,4">
                                                                <TextBlock x:Name="PlaybackLoopLabel" Foreground="#E5E7EB" FontSize="13"
                                   VerticalAlignment="Center"/>
                                                                <ToggleButton x:Name="PlaybackLoopSwitch" Style="{StaticResource ChromeSwitch}"
                                      HorizontalAlignment="Right" Click="PlaybackLoopSwitch_Click"/>
                                                            </Grid>
                                                            <Grid Margin="0,4">
                                                                <TextBlock x:Name="PlaybackEpisodeTitleLabel" Foreground="#E5E7EB" FontSize="13"
                                   VerticalAlignment="Center"/>
                                                                <ToggleButton x:Name="PlaybackEpisodeTitleSwitch" Style="{StaticResource ChromeSwitch}"
                                      HorizontalAlignment="Right" IsChecked="True"
                                      Click="PlaybackEpisodeTitleSwitch_Click"/>
                                                            </Grid>
                                                            <Grid Margin="0,4">
                                                                <TextBlock x:Name="PlaybackAspectLabel" Foreground="#E5E7EB" FontSize="13"
                                   VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="PlaybackAspectValue" Foreground="#94A3B8" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <Border Background="Transparent" Cursor="Hand" Margin="0,4"
                              MouseLeftButtonUp="PlaybackDiagRow_MouseLeftButtonUp">
                                                                <Grid>
                                                                    <TextBlock x:Name="PlaybackDiagLabel" Foreground="#E5E7EB" FontSize="13"
                                     VerticalAlignment="Center"/>
                                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Right">
                                                                        <Path Data="{StaticResource GeoChevronRight}" Fill="#94A3B8"/>
                                                                    </Viewbox>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock x:Name="PlaybackDiagText" Foreground="#CCE5E7EB" FontSize="11"
                                 TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                                 FontFamily="Consolas, Cascadia Mono, monospace"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <Grid x:Name="PlaybackVolumeHost" Width="36" Height="34" Margin="4,0"
                    MouseEnter="PlaybackVolumeHost_MouseEnter"
                    MouseLeave="PlaybackVolumeHost_MouseLeave">
                                                <Button x:Name="PlaybackMuteBtn" Style="{StaticResource ChromeIconBtn}" Margin="0"
                        Click="PlaybackMute_Click">
                                                    <Viewbox Width="18" Height="18">
                                                        <Path x:Name="PlaybackMuteIcon" Data="{StaticResource GeoVolume}" Fill="White"/>
                                                    </Viewbox>
                                                </Button>
                                                <Popup x:Name="PlaybackVolumePopup" Placement="Top"
                       AllowsTransparency="True" StaysOpen="True"
                       VerticalOffset="-6">
                                                    <Border Background="#E6111827" CornerRadius="10" Padding="10,12"
                          BorderBrush="#33FFFFFF" BorderThickness="1"
                          MouseEnter="PlaybackVolumePopup_MouseEnter"
                          MouseLeave="PlaybackVolumePopup_MouseLeave">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock x:Name="PlaybackVolumePct" Text="100%" Foreground="White"
                                 FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <Slider x:Name="PlaybackVolumeBar"
                              Style="{StaticResource PlaybackVolumeVerticalSlider}"
                              Value="100"
                              PreviewMouseLeftButtonDown="PlaybackVolumeBar_PreviewMouseDown"
                              PreviewMouseLeftButtonUp="PlaybackVolumeBar_PreviewMouseUp"
                              ValueChanged="PlaybackVolumeBar_ValueChanged"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <Button x:Name="PlaybackPipBtn" Style="{StaticResource ChromeIconBtn}"
                      Click="PlaybackPip_Click">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Data="{StaticResource GeoPip}" Fill="White"/>
                                                </Viewbox>
                                            </Button>
                                            <Button x:Name="PlaybackMaximizeBtn" Style="{StaticResource ChromeIconBtn}"
                      Click="PlaybackMaximize_Click">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="{StaticResource GeoMaximize}" Fill="White"/>
                                                </Viewbox>
                                            </Button>
                                            <Button x:Name="PlaybackFullscreenBtn" Style="{StaticResource ChromeIconBtn}" Margin="0"
                      Click="PlaybackFullscreen_Click">
                                                <Viewbox Width="16" Height="16">
                                                    <Path x:Name="PlaybackFullscreenIcon" Data="{StaticResource GeoFullscreen}" Fill="White"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
