<UserControl x:Class="FlyScreen.Tool.VideoWall.Ui.Win.VideoWallPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{DynamicResource WinBg}"
             Foreground="{DynamicResource Text}"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             FontSize="13"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/VideoWallWinControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 默认淡色种子；嵌入主窗时 DynamicResource 会跟宿主主题 -->
      <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
      <SolidColorBrush x:Key="BluePress" Color="#1D4ED8"/>
      <SolidColorBrush x:Key="BlueSoft" Color="#DBEAFE"/>
      <SolidColorBrush x:Key="BlueHover" Color="#EFF6FF"/>
      <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
      <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
      <SolidColorBrush x:Key="Text" Color="#111827"/>
      <SolidColorBrush x:Key="WinBg" Color="#F7F8FA"/>
      <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SubtleBg" Color="#F3F4F6"/>
      <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>
      <SolidColorBrush x:Key="ControlHover" Color="#F9FAFB"/>
      <SolidColorBrush x:Key="Warn" Color="#DC2626"/>

      <Geometry x:Key="GeoAdd">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
      <Geometry x:Key="GeoDelete">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
      <Geometry x:Key="GeoPlay">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
      <Geometry x:Key="GeoEdit">M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z</Geometry>
      <Geometry x:Key="GeoBack">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</Geometry>

      <Style x:Key="ToolBarCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0,32,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </Style>

      <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="IconPrimaryBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Background" Value="{DynamicResource Blue}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BluePress}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BluePress}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="IconDangerBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
      </Style>

      <Style x:Key="RowIconBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 紧凑工具条：模式/视图/布局用下拉；添加/删除用图标 -->
    <Border x:Name="MainToolbar" Margin="0,0,0,8" Padding="8,6" CornerRadius="8"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Background="{DynamicResource CardBg}">
      <DockPanel LastChildFill="True">
        <ComboBox x:Name="ModeCombo" DockPanel.Dock="Left" Style="{StaticResource ToolBarCombo}"
                  Width="88" SelectionChanged="ModeCombo_SelectionChanged"/>
        <ComboBox x:Name="ViewCombo" DockPanel.Dock="Left" Style="{StaticResource ToolBarCombo}"
                  Width="88" SelectionChanged="ViewCombo_SelectionChanged"/>
        <!-- 右侧先 Dock：最右为布局下拉 -->
        <ComboBox x:Name="LayoutCombo" DockPanel.Dock="Right" Style="{StaticResource ToolBarCombo}"
                  Width="84" Margin="6,0,0,0" SelectionChanged="LayoutCombo_SelectionChanged"/>
        <Rectangle DockPanel.Dock="Right" Width="1" Fill="{DynamicResource Line}" Margin="4,4,0,4"/>
        <Button x:Name="DeleteBtn" DockPanel.Dock="Right" Style="{StaticResource IconDangerBtn}"
                Margin="0,0,0,0" Click="DeleteBtn_Click">
          <Viewbox Width="14" Height="14">
            <Path Data="{StaticResource GeoDelete}" Fill="{DynamicResource Warn}"/>
          </Viewbox>
        </Button>
        <Button x:Name="AddBtn" DockPanel.Dock="Right" Style="{StaticResource IconPrimaryBtn}"
                Click="AddBtn_Click">
          <Viewbox Width="14" Height="14">
            <Path Data="{StaticResource GeoAdd}" Fill="White"/>
          </Viewbox>
        </Button>
        <ComboBox x:Name="GroupFilter" DockPanel.Dock="Right" Style="{StaticResource ToolBarCombo}"
                  Width="120" Margin="0,0,6,0"/>
        <TextBox x:Name="SearchBox" MinWidth="72" Height="32" Margin="0,0,6,0"
                 VerticalAlignment="Center" VerticalContentAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1">
      <Grid x:Name="SourcesPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" SelectionMode="Extended"
                  Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}"
                  BorderThickness="1" Foreground="{DynamicResource Text}"
                  AlternatingRowBackground="{DynamicResource SubtleBg}"
                  MouseDoubleClick="SourcesGrid_MouseDoubleClick" Visibility="Visible">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn x:Name="ColKind" Binding="{Binding KindText}" Width="100"/>
            <DataGridTextColumn x:Name="ColAddress" Binding="{Binding AddressRedacted}" Width="2*"/>
            <DataGridTextColumn x:Name="ColGroup" Binding="{Binding Group}" Width="100"/>
            <DataGridTextColumn x:Name="ColStatus" Binding="{Binding StatusText}" Width="80"/>
            <DataGridTemplateColumn x:Name="ColActions" Width="108">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource RowIconBtn}" Tag="{Binding Id}"
                            ToolTip="{Binding PlayLabel}" Click="RowPlay_Click">
                      <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource GeoPlay}" Fill="#059669"/>
                      </Viewbox>
                    </Button>
                    <Button Style="{StaticResource RowIconBtn}" Tag="{Binding Id}"
                            ToolTip="{Binding EditLabel}" Click="RowEdit_Click">
                      <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource GeoEdit}" Fill="{DynamicResource Blue}"/>
                      </Viewbox>
                    </Button>
                    <Button Style="{StaticResource RowIconBtn}" Margin="0" Tag="{Binding Id}"
                            ToolTip="{Binding DeleteLabel}" Click="RowDelete_Click">
                      <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource GeoDelete}" Fill="{DynamicResource Warn}"/>
                      </Viewbox>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <ItemsControl x:Name="SourcesCards" Visibility="Collapsed">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="160" Height="120" Margin="6" Padding="8" CornerRadius="8"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      Background="{DynamicResource CardBg}" Cursor="Hand"
                      MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                  <TextBlock Text="{Binding AddressRedacted}" FontSize="10" Foreground="{DynamicResource Muted}"
                             TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                     HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
        </StackPanel>
      </Grid>

      <UniformGrid x:Name="WallGrid" Visibility="Collapsed" Rows="3" Columns="3"/>

      <Grid x:Name="PlaybackPane" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="PlaybackBackBtn" Style="{StaticResource IconBtn}" HorizontalAlignment="Left"
                Click="PlaybackBackBtn_Click">
          <Viewbox Width="14" Height="14">
            <Path Data="{StaticResource GeoBack}" Fill="{DynamicResource Text}"/>
          </Viewbox>
        </Button>
        <Border Grid.Row="1" Background="Black" Margin="0,8">
          <vlc:VideoView x:Name="PlayerView" Loaded="PlayerView_Loaded"/>
        </Border>
        <TextBlock x:Name="PlaybackStats" Grid.Row="2" Margin="0,8,0,0" FontSize="12"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      </Grid>
    </Grid>

    <TextBlock x:Name="StatusBar" Grid.Row="2" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
  </Grid>
</UserControl>
