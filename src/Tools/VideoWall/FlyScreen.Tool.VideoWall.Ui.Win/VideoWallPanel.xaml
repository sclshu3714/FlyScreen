<UserControl x:Class="FlyScreen.Tool.VideoWall.Ui.Win.VideoWallPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlyScreen.Tool.VideoWall.Ui.Win"
             Background="{DynamicResource WinBg}"
             Foreground="{DynamicResource Text}"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             FontSize="13"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theme:WpfTheme xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Wpf;assembly=FlyScreen.Ui.Theme.Wpf"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 工具侧危险色（删除等）；其余令牌走统一主题 -->
      <SolidColorBrush x:Key="Warn" Color="#DC2626"/>
      <Style x:Key="ToolBarCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0,32,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Type ComboBoxItem}}"/>
      </Style>

      <!-- 工具条搜索框：圆角描边，与 Combo 对齐 -->
      <Style x:Key="ToolBarTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="IconPrimaryBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Background" Value="{DynamicResource Blue}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BluePress}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BluePress}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="IconDangerBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
      </Style>

      <Style x:Key="RowIconBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>

      <!-- 分段：左圆右方 / 左方右圆，中间共边无缝 -->
      <Style x:Key="SegmentToggleBase" TargetType="ToggleButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="SegmentToggleLeft" TargetType="ToggleButton" BasedOn="{StaticResource SegmentToggleBase}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1,1,0,1"
                      CornerRadius="6,0,0,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SegmentToggleMid" TargetType="ToggleButton" BasedOn="{StaticResource SegmentToggleBase}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1,1,0,1"
                      CornerRadius="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SegmentToggleRight" TargetType="ToggleButton" BasedOn="{StaticResource SegmentToggleBase}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="0,6,6,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 对齐主窗 ProgList：底部分隔线 + 悬停/选中底色 -->
      <Style x:Key="SourceListView" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource ListBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
      <Style x:Key="SourceListItem" TargetType="ListViewItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource ListBg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="RootLayout" Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 顺序：添加 | 删除 | 源/列表 | 布局 | 分组 | 搜索 -->
    <Border x:Name="MainToolbar" Margin="0,0,0,8" Padding="8,6" CornerRadius="8"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Background="{DynamicResource CardBg}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="AddBtn" Grid.Column="0" Style="{StaticResource IconPrimaryBtn}"
                Margin="0,0,6,0" Click="AddBtn_Click">
          <Viewbox Width="14" Height="14" Margin="0,0,3,2">
            <Path Data="{StaticResource GeoAdd}" Fill="White"/>
          </Viewbox>
        </Button>
        <Button x:Name="ScanBtn" Grid.Column="1" Style="{StaticResource IconPrimaryBtn}"
                Margin="0,0,6,0" Click="ScanBtn_Click"
                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlBorder}">
          <Viewbox Width="14" Height="14" Margin="0,0,3,2">
            <Path Data="{StaticResource GeoScan}" Fill="{DynamicResource Blue}"/>
          </Viewbox>
        </Button>
        <Button x:Name="DlnaBtn" Grid.Column="2" Style="{StaticResource IconPrimaryBtn}"
                Margin="0,0,6,0" Click="DlnaBtn_Click"
                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlBorder}">
          <Viewbox Width="14" Height="14" Margin="0,0,3,2">
            <Path Data="{StaticResource GeoNetwork}" Fill="{DynamicResource Blue}"/>
          </Viewbox>
        </Button>
        <Button x:Name="DeleteBtn" Grid.Column="3" Style="{StaticResource IconDangerBtn}"
                Margin="0,0,8,0" Click="DeleteBtn_Click">
                    <Viewbox Width="14" Height="14"  Margin="0,0,3,2">
            <Path Data="{StaticResource GeoDelete}" Fill="{DynamicResource Warn}"/>
          </Viewbox>
        </Button>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,8,0"
                    VerticalAlignment="Center">
          <ToggleButton x:Name="ViewCardBtn" Style="{StaticResource SegmentToggleLeft}"
                        Click="ViewCardBtn_Click">
            <Viewbox Width="14" Height="14">
              <Path x:Name="ViewCardIcon" Data="{StaticResource GeoViewCard}"
                    Fill="{DynamicResource Text}"/>
            </Viewbox>
          </ToggleButton>
          <ToggleButton x:Name="ViewListBtn" Style="{StaticResource SegmentToggleMid}"
                        Click="ViewListBtn_Click">
            <Viewbox Width="14" Height="14">
              <Path x:Name="ViewListIcon" Data="{StaticResource GeoViewList}"
                    Fill="{DynamicResource Text}"/>
            </Viewbox>
          </ToggleButton>
          <ToggleButton x:Name="ViewCanvasBtn" Style="{StaticResource SegmentToggleRight}"
                        Click="ViewCanvasBtn_Click">
            <Viewbox Width="14" Height="14">
              <Path x:Name="ViewCanvasIcon" Data="{StaticResource GeoViewCanvas}"
                    Fill="{DynamicResource Text}"/>
            </Viewbox>
          </ToggleButton>
        </StackPanel>
        <ComboBox x:Name="LayoutCombo" Grid.Column="5" Style="{StaticResource ToolBarCombo}"
                  Width="84" Margin="0,0,6,0" Visibility="Collapsed"
                  SelectionChanged="LayoutCombo_SelectionChanged"/>
        <StackPanel x:Name="CarouselPanel" Grid.Column="6" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
          <CheckBox x:Name="CarouselToggle" VerticalAlignment="Center" Margin="0,0,6,0"
                    Checked="CarouselToggle_Changed" Unchecked="CarouselToggle_Changed"/>
          <TextBlock x:Name="CarouselPageText" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <ComboBox x:Name="GroupFilter" Grid.Column="7" Style="{StaticResource ToolBarCombo}"
                  Width="120" Margin="0,0,6,0"/>
        <TextBox x:Name="SearchBox" Grid.Column="8" Style="{StaticResource ToolBarTextBox}"/>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1">
      <Grid x:Name="SourcesPane">
        <Border Background="{DynamicResource ListBg}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="0,0,0,4">
          <Grid>
            <ListView x:Name="SourcesGrid" Style="{StaticResource SourceListView}"
                      ItemContainerStyle="{StaticResource SourceListItem}"
                      SelectionMode="Extended"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SizeChanged="SourcesGrid_SizeChanged"
                      SelectionChanged="SourcesGrid_SelectionChanged"
                      MouseDoubleClick="SourcesGrid_MouseDoubleClick" Visibility="Visible">
              <ListView.View>
                <GridView>
                  <!-- 独立复选列：表头全选/取消；Shift+单击反选 -->
                  <GridViewColumn x:Name="ColCheck" Width="40">
                    <GridViewColumn.Header>
                      <CheckBox x:Name="HeaderSelectAll" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Click="HeaderSelectAll_Click"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Click="RowCheck_Click"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColName" Width="120" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn x:Name="ColKind" Width="88" DisplayMemberBinding="{Binding KindText}"/>
                  <GridViewColumn x:Name="ColAddress" Width="200" DisplayMemberBinding="{Binding AddressRedacted}"/>
                  <GridViewColumn x:Name="ColGroup" Width="80" DisplayMemberBinding="{Binding Group}"/>
                  <GridViewColumn x:Name="ColStatus" Width="64" DisplayMemberBinding="{Binding StatusText}"/>
                  <GridViewColumn x:Name="ColActions" Width="108">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource RowIconBtn}" Tag="{Binding Id}"
                                  ToolTip="{Binding PlayLabel}" Click="RowPlay_Click">
                            <Viewbox Width="12" Height="12">
                              <Path Data="{StaticResource GeoPlay}" Fill="#059669"/>
                            </Viewbox>
                          </Button>
                          <Button Style="{StaticResource RowIconBtn}" Tag="{Binding Id}"
                                  ToolTip="{Binding EditLabel}" Click="RowEdit_Click">
                            <Viewbox Width="12" Height="12">
                              <Path Data="{StaticResource GeoEdit}" Fill="{DynamicResource Blue}"/>
                            </Viewbox>
                          </Button>
                          <Button Style="{StaticResource RowIconBtn}" Margin="0" Tag="{Binding Id}"
                                  ToolTip="{Binding DeleteLabel}" Click="RowDelete_Click">
                            <Viewbox Width="12" Height="12">
                              <Path Data="{StaticResource GeoDelete}" Fill="{DynamicResource Warn}"/>
                            </Viewbox>
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <ScrollViewer x:Name="SourcesCardsHost" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="4" SizeChanged="SourcesCardsHost_SizeChanged">
              <ItemsControl x:Name="SourcesCards" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- 不定 ItemWidth：由卡片定宽 + Margin 控制间距，避免槽位被均分拉宽 -->
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <!-- 宽度由代码按宿主宽算：默认窗约 3 列，缩放仍自适应列数 -->
                    <Setter Property="Width" Value="200"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border MinHeight="132" Margin="0" Padding="10" CornerRadius="8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Background="{DynamicResource CardBg}" Cursor="Hand"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top"
                            MouseLeftButtonDown="Card_MouseLeftButtonDown">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="11"
                                     Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                          <TextBlock Text="{Binding AddressRedacted}" FontSize="10"
                                     Foreground="{DynamicResource Muted}"
                                     TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"
                                    HorizontalAlignment="Right">
                          <Button Style="{StaticResource RowIconBtn}" Tag="{Binding Id}"
                                  ToolTip="{Binding PlayLabel}" Click="RowPlay_Click">
                            <Viewbox Width="12" Height="12">
                              <Path Data="{StaticResource GeoPlay}" Fill="#059669"/>
                            </Viewbox>
                          </Button>
                          <Button Style="{StaticResource RowIconBtn}" Tag="{Binding Id}"
                                  ToolTip="{Binding EditLabel}" Click="RowEdit_Click">
                            <Viewbox Width="12" Height="12">
                              <Path Data="{StaticResource GeoEdit}" Fill="{DynamicResource Blue}"/>
                            </Viewbox>
                          </Button>
                          <Button Style="{StaticResource RowIconBtn}" Margin="0" Tag="{Binding Id}"
                                  ToolTip="{Binding DeleteLabel}" Click="RowDelete_Click">
                            <Viewbox Width="12" Height="12">
                              <Path Data="{StaticResource GeoDelete}" Fill="{DynamicResource Warn}"/>
                            </Viewbox>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
              <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                         HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="WallHost" Visibility="Collapsed" Background="Transparent"
            MouseEnter="WallHost_MouseEnter" MouseLeave="WallHost_MouseLeave">
        <UniformGrid x:Name="WallGrid" Rows="3" Columns="3"/>
        <Button x:Name="CarouselPrevBtn" Width="36" Height="36" MinWidth="0" MinHeight="0"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                Padding="0" BorderThickness="0" Cursor="Hand" Focusable="False"
                Visibility="Collapsed" Click="CarouselPrevBtn_Click" Panel.ZIndex="2"
                Background="#99000000">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#CC2563EB"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Viewbox Width="16" Height="16">
            <Path Fill="White" Data="{StaticResource GeoChevronLeft}"/>
          </Viewbox>
        </Button>
        <Button x:Name="CarouselNextBtn" Width="36" Height="36" MinWidth="0" MinHeight="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                Padding="0" BorderThickness="0" Cursor="Hand" Focusable="False"
                Visibility="Collapsed" Click="CarouselNextBtn_Click" Panel.ZIndex="2"
                Background="#99000000">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#CC2563EB"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Viewbox Width="16" Height="16">
            <Path Fill="White" Data="{StaticResource GeoChevronRight}"/>
          </Viewbox>
        </Button>
        <StackPanel x:Name="CarouselDots" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,14" Panel.ZIndex="2"
                    Visibility="Collapsed" IsHitTestVisible="True"/>
      </Grid>

      <local:VideoWallPlayerControl x:Name="Player" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</UserControl>
