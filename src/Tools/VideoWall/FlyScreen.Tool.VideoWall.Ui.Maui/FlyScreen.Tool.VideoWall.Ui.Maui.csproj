<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.Tool.VideoWall.Ui.Maui</RootNamespace>
    <AssemblyName>FlyScreen.Tool.VideoWall.Ui.Maui</AssemblyName>
    <Description>视频墙 Maui UI（含 Maui-Win 源管理与播放控制）</Description>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Tool.VideoWall\FlyScreen.Tool.VideoWall.csproj" />
    <ProjectReference Include="..\..\..\FlyScreen.ToolSdk\FlyScreen.ToolSdk.csproj" />
    <ProjectReference Include="..\..\..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>
</Project>