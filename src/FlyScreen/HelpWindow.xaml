<Window x:Class="FlyScreen.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="玄鸟 — 帮助"
        Height="640" Width="720"
        MinHeight="520" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        ShowInTaskbar="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Text" Color="#111827"/>
    <SolidColorBrush x:Key="WinBg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="4">
      <RichTextBox x:Name="HelpRich"
                   IsReadOnly="True"
                   IsDocumentEnabled="True"
                   IsUndoEnabled="False"
                   BorderThickness="0"
                   Background="Transparent"
                   Foreground="{DynamicResource Text}"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled"
                   Padding="12,10"
                   Focusable="True"/>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="12" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SectionUpdateText" Text="更新与连接诊断" FontWeight="SemiBold"/>
        <TextBlock x:Name="ActionStatus" Grid.Row="1" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}" Margin="0,6,0,8"
                   Text="可通过 GitHub Release 检查更新；连接异常时先「一键检查」再「一键修复」。"/>
        <ProgressBar x:Name="UpdateProgressBar" Grid.Row="2" Height="10" Minimum="0" Maximum="100"
                     Margin="0,0,0,10" Visibility="Collapsed"
                     Background="{DynamicResource ControlBorder}" Foreground="{DynamicResource Blue}"/>
        <WrapPanel Grid.Row="3">
          <Button x:Name="CheckUpdateBtn" Content="检查更新" Click="CheckUpdate_Click"/>
          <Button x:Name="ApplyUpdateBtn" Content="自动更新" Click="ApplyUpdate_Click" IsEnabled="False"/>
          <Button x:Name="DiagCheckBtn" Content="一键检查" Click="DiagCheck_Click"/>
          <Button x:Name="DiagFixBtn" Style="{StaticResource PrimaryBtn}" Content="一键修复" Click="DiagFix_Click" Margin="0"/>
        </WrapPanel>
      </Grid>
    </Border>

    <TextBox x:Name="DiagOutput" Grid.Row="2" Margin="0,12,0,0" Height="120"
             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             BorderBrush="{DynamicResource Line}" Padding="10,8"
             Visibility="Collapsed"
             FontFamily="Consolas, Microsoft YaHei UI"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CloseBtn" Content="关闭" IsCancel="True" Click="Close_Click" Margin="0" MinWidth="88"/>
    </StackPanel>
  </Grid>
</Window>
