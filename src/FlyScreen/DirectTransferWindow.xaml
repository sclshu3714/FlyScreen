<Window x:Class="FlyScreen.DirectTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="直接传输"
        Height="520" Width="640"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="直接传输到指定电脑" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="选择本机文件或文件夹，指定已连接电脑及保存位置后开始推送。"
                 Foreground="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="待传输内容" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="添加文件…" Click="AddFiles_Click"/>
            <Button Content="添加文件夹…" Click="AddFolder_Click" Margin="0"/>
          </StackPanel>
        </DockPanel>
        <ListBox x:Name="PathList" Grid.Row="1" BorderThickness="0"
                 SelectionMode="Extended"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="移除所选" Click="RemoveSelected_Click"/>
          <Button Content="清空" Click="ClearPaths_Click" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="12" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="目标电脑" VerticalAlignment="Center"/>
        <ComboBox x:Name="PeerCombo" Grid.Column="1" Height="32"
                  DisplayMemberPath="Display"
                  SelectionChanged="PeerCombo_SelectionChanged"/>

        <TextBlock Grid.Row="1" Text="常用位置" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox x:Name="FolderPresetCombo" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,0,0"
                  DisplayMemberPath="Label" SelectionChanged="FolderPreset_SelectionChanged"/>

        <TextBlock Grid.Row="2" Text="保存路径" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0"
                 VerticalContentAlignment="Center" Padding="8,0"
                 ToolTip="对端电脑上的绝对路径，可手动修改"/>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource Muted}"
               Margin="0,10,0,0" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button x:Name="StartBtn" Style="{StaticResource PrimaryBtn}" Content="开始传输"
              IsDefault="True" Click="Start_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
