<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FlyScreen</RootNamespace>
    <AssemblyName>FlyScreen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wlogo_tu.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>玄鸟</Product>
    <Authors>sclshu3714</Authors>
    <Company>玄鸟</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Description>玄鸟 — 跨电脑键鼠与剪贴板共享（仿 Mouse without Borders，中文增强版）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 供 WPF 窗体 / 托盘以 pack URI 加载 -->
    <Resource Include="Assets\wlogo_tu.ico" />
  </ItemGroup>

</Project>
