<Window x:Class="FlyScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞鼠 1.0"
        Icon="pack://application:,,,/Assets/wlogo_tu.ico"
        Height="640" Width="960"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BlueHover" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Text" Color="#111827"/>
    <SolidColorBrush x:Key="Success" Color="#059669"/>

    <ControlTemplate x:Key="PcIconTemplate">
      <Grid Width="40" Height="34">
        <Border Width="36" Height="24" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#1F2937" CornerRadius="3" BorderBrush="#111827" BorderThickness="2">
          <Border Background="#60A5FA" Margin="3" CornerRadius="2" Opacity="0.4"/>
        </Border>
        <Border Width="12" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#6B7280" CornerRadius="1"/>
      </Grid>
    </ControlTemplate>

    <!-- 1×4 卡片内容 -->
    <DataTemplate x:Key="MachineCard1x4">
      <Grid Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6" Cursor="Arrow">
          <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                    Cursor="Hand" ToolTip="启用此位置"/>
          <TextBlock Text="{Binding PositionLabel}" FontSize="11" Foreground="#6B7280"
                     VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Arrow"/>
        </StackPanel>
        <Control Grid.Row="1" Template="{StaticResource PcIconTemplate}"
                 HorizontalAlignment="Center" Margin="0,0,0,6" Cursor="SizeAll"/>
        <TextBlock Grid.Row="2" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                   Cursor="SizeAll"/>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="{StaticResource Success}"
                   FontWeight="SemiBold" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"
                   Cursor="SizeAll"/>
      </Grid>
    </DataTemplate>

    <!-- 2×2 卡片内容：紧凑内边距，状态完整可见 -->
    <DataTemplate x:Key="MachineCard2x2">
      <Grid Margin="6,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Control Template="{StaticResource PcIconTemplate}"
                 VerticalAlignment="Center" Margin="0,0,10,0"
                 Cursor="SizeAll"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Cursor="Arrow">
            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                      VerticalAlignment="Center" Cursor="Hand"
                      ToolTip="启用此位置"/>
            <TextBlock Text="{Binding PositionLabel}" FontSize="11" Foreground="#6B7280"
                       VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Arrow"/>
          </StackPanel>
          <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                     TextAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                     Cursor="SizeAll"/>
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Success}"
                     FontWeight="SemiBold" FontSize="11" TextAlignment="Left" Margin="0,3,0,0"
                     Cursor="SizeAll"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- 侧栏按钮 -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 顶栏 Tab 胶囊 -->
    <Style x:Key="TopTab" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 1x4 / 2x2 分段 -->
    <Style x:Key="SegBtn" TargetType="RadioButton">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="False"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource Blue}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextBlock.Foreground="White"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="PasswordChar" Value="*"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="168"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== 左侧导航 ===== -->
    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,16,0,12">
        <Border DockPanel.Dock="Top" Margin="12,0,12,16" Background="#F3F4F6" CornerRadius="18" Height="36">
          <DockPanel Margin="12,0">
            <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="14" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Height="36"
                     VerticalContentAlignment="Center" Tag="搜索设置"
                     TextChanged="SearchBox_TextChanged">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                  <Setter Property="Height" Value="36"/>
                  <Setter Property="Padding" Value="0"/>
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Background">
                        <Setter.Value>
                          <VisualBrush Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                              <TextBlock Text="搜索设置" Foreground="#9CA3AF" FontSize="13" Margin="0,8,0,0"/>
                            </VisualBrush.Visual>
                          </VisualBrush>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
          </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="16,12,16,4"
                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="就绪"/>

        <StackPanel>
          <RadioButton x:Name="NavBasic" Style="{StaticResource NavBtn}" GroupName="SideNav"
                       IsChecked="True" Checked="Nav_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⌂" Width="22" FontSize="15"/>
              <TextBlock Text="基础" Margin="6,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavNetwork" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="◎" Width="22" FontSize="14"/>
              <TextBlock Text="网络" Margin="6,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavShare" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▦" Width="22" FontSize="14"/>
              <TextBlock Text="共享" Margin="6,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSecurity" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⛨" Width="22" FontSize="14"/>
              <TextBlock Text="安全" Margin="6,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="☰" Width="22" FontSize="14"/>
              <TextBlock Text="高级" Margin="6,0,0,0"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== 主区 ===== -->
    <Grid Grid.Column="1" Margin="20,16,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 顶栏 Tabs + 帮助 -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Content="？ 帮助" Click="Help_Click"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                Margin="0" MinWidth="60" Height="34" Cursor="Hand"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabBasic" Style="{StaticResource TopTab}" GroupName="TopTab"
                       Content="基础设置" IsChecked="True" Checked="TopTab_Changed"/>
          <RadioButton x:Name="TabOptions" Style="{StaticResource TopTab}" GroupName="TopTab"
                       Content="高级选项" Checked="TopTab_Changed"/>
          <RadioButton x:Name="TabNetwork" Style="{StaticResource TopTab}" GroupName="TopTab"
                       Content="网络设置" Checked="TopTab_Changed"/>
          <RadioButton x:Name="TabTransfer" Style="{StaticResource TopTab}" GroupName="TopTab"
                       Content="文件传输" Checked="TopTab_Changed"/>
        </StackPanel>
      </DockPanel>

      <!-- 页面内容（无滚动条，自适应） -->
      <Grid Grid.Row="1">
        <!-- ===== 基础设置 ===== -->
        <Grid x:Name="PageBasic" Visibility="Visible">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 安全密钥卡片 -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
            <StackPanel>
              <TextBlock Text="安全密钥" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="SecurityKeyBox" FontFamily="Consolas" FontSize="14" Visibility="Collapsed"/>
                  <PasswordBox x:Name="SecurityKeyPassword" FontFamily="Consolas" FontSize="14"/>
                </Grid>
                <CheckBox x:Name="ShowKeyCheck" Grid.Column="1" Content="显示" Margin="14,0,0,0"
                          VerticalAlignment="Center" Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="生成新密钥"
                        Click="NewKey_Click" Margin="12,0,0,0"/>
              </Grid>
              <TextBlock Text="两台电脑必须使用相同的安全密钥才能连接。"
                         Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <!-- 电脑布局卡片 -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="电脑布局" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Background="#F3F4F6" CornerRadius="8" Padding="3">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Layout1x4" Style="{StaticResource SegBtn}" GroupName="LayoutMode"
                                 Content="1×4" Checked="LayoutMode_Changed"/>
                    <RadioButton x:Name="Layout2x2" Style="{StaticResource SegBtn}" GroupName="LayoutMode"
                                 Content="2×2" IsChecked="True" Checked="LayoutMode_Changed"/>
                  </StackPanel>
                </Border>
              </DockPanel>

              <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                         Margin="0,0,0,10"
                         Text="下方格子代表真实摆放位置（从左到右、从上到下）。把电脑拖到对应格子：鼠标从本机左边缘出去会进入左侧电脑，右边缘进入右侧电脑；双行布局时上下边缘同样生效。"/>

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="4">
                  <Grid>
                    <Canvas x:Name="ArrowCanvas" IsHitTestVisible="False"/>
                    <ItemsControl x:Name="MachineMatrix"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="Matrix_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="Matrix_PreviewMouseMove"
                                  Drop="Matrix_Drop"
                                  DragOver="Matrix_DragOver"
                                  SizeChanged="MachineMatrix_SizeChanged">
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="HorizontalAlignment" Value="Stretch"/>
                          <Setter Property="VerticalAlignment" Value="Stretch"/>
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <!-- 小间隔；2×2 更紧凑，给状态文字留空间 -->
                          <Border Cursor="SizeAll" Tag="{Binding}"
                                  CornerRadius="8" Background="White"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Margin" Value="4"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Background" Value="{StaticResource BlueHover}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                                    <Setter Property="Opacity" Value="0.9"/>
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsTwoRow}" Value="True">
                                    <Setter Property="Margin" Value="3"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding}" HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center">
                              <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                  <Setter Property="ContentTemplate" Value="{StaticResource MachineCard1x4}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTwoRow}" Value="True">
                                      <Setter Property="ContentTemplate" Value="{StaticResource MachineCard2x2}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ContentControl.Style>
                            </ContentControl>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top" Width="100">
                  <TextBlock Text="拖拽互换位置" Foreground="{StaticResource Blue}" FontSize="12"
                             TextAlignment="Center" Margin="0,0,0,12"/>
                  <Button Content="刷新连接" Click="Reconnect_Click" Margin="0" Width="100" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== 其他选项 ===== -->
        <Grid x:Name="PageOptions" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="功能" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="WrapMouseCheck" Content="环形鼠标（首尾相连）"/>
                <CheckBox x:Name="ShareClipboardCheck" Content="共享剪贴板"/>
                <CheckBox x:Name="TransferFileCheck" Content="启用文件传输" Margin="20,4,0,4"/>
                <CheckBox x:Name="HideMouseCheck" Content="控制远端时隐藏本机边缘光标"/>
                <CheckBox x:Name="DrawCursorCheck" Content="绘制鼠标光标（预留）"/>
                <CheckBox x:Name="SameSubnetCheck" Content="仅同网段连接"/>
                <CheckBox x:Name="ShowStatusCheck" Content="显示状态消息"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="行为" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="BlockSaverCheck" Content="阻止其他机器屏保"/>
                <CheckBox x:Name="MoveRelCheck" Content="相对移动鼠标"/>
                <CheckBox x:Name="BlockCornerCheck" Content="屏幕四角阻挡切换"/>
                <CheckBox x:Name="EasyMouseCheck" Content="轻松鼠标（移出边缘切换）"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="键盘快捷键" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="切换机器（Ctrl+Alt+）" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="HotF" Content="F1–F4" GroupName="Sw" Margin="0,0,18,0" IsChecked="True"/>
                <RadioButton x:Name="HotNum" Content="1–4" GroupName="Sw" Margin="0,0,18,0"/>
                <RadioButton x:Name="HotOff" Content="禁用" GroupName="Sw"/>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="显示设置 (Ctrl+Alt+)" VerticalAlignment="Center"/>
                <TextBox x:Name="HkSettings" Grid.Column="1" Margin="6" MaxLength="1" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="重新连接 (Ctrl+Alt+)" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="HkReconnect" Grid.Column="3" Margin="6" MaxLength="1" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="退出程序 (Ctrl+Alt+)" VerticalAlignment="Center"/>
                <TextBox x:Name="HkExit" Grid.Row="1" Grid.Column="1" Margin="6" MaxLength="1" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="锁定机器 (Ctrl+Alt+)" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="HkLock" Grid.Row="1" Grid.Column="3" Margin="6" MaxLength="1" HorizontalContentAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== 网络设置 ===== -->
        <Grid x:Name="PageNetwork" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="本机网卡" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Text="选择用于通信的网卡，避免虚拟网卡导致单向连接。"
                         Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="NicCombo" DisplayMemberPath="Display"/>
                <Button Grid.Column="1" Content="刷新网卡" Click="RefreshNics_Click"/>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TCP 端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TcpPortBox" Grid.Column="1" Text="15155"/>
                <TextBlock Grid.Column="2" Text="发现端口" VerticalAlignment="Center" Margin="20,0,8,0"/>
                <TextBox x:Name="UdpPortBox" Grid.Column="3" Text="15156"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="局域网自动发现" FontWeight="SemiBold"/>
                  <TextBlock Text="双击可填入机器布局空位" Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="刷新发现" Click="RefreshDiscovery_Click"/>
              </DockPanel>
              <ListBox x:Name="DiscoveryList" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1"
                       MouseDoubleClick="DiscoveryList_DoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="6,8">
                      <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Success}"
                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <TextBlock>
                        <Run Text="{Binding MachineName}" FontWeight="SemiBold"/>
                        <Run Text="  "/><Run Text="{Binding Ip}" Foreground="#6B7280"/>
                        <Run Text=":" Foreground="#6B7280"/><Run Text="{Binding TcpPort}" Foreground="#6B7280"/>
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== 文件传输 ===== -->
        <Grid x:Name="PageTransfer" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="传输列表" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="支持多文件、无大小限制；完成后自动更新剪贴板"
                         Foreground="{StaticResource Muted}" FontSize="12"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="打开收件箱" Click="OpenInbox_Click"/>
              <Button Content="清除已完成" Click="ClearTransfers_Click"/>
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="TransferList" BorderThickness="0">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="方向" Width="56" DisplayMemberBinding="{Binding DirectionText}"/>
                  <GridViewColumn Header="文件名" Width="220" DisplayMemberBinding="{Binding FileName}"/>
                  <GridViewColumn Header="对端" Width="130" DisplayMemberBinding="{Binding PeerName}"/>
                  <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="进度" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <ProgressBar Value="{Binding Progress}" Height="10" Margin="0,6"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="状态" Width="72" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Border>
        </Grid>
      </Grid>

      <!-- 底部按钮：应用 / 隐藏 / 退出 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Style="{StaticResource PrimaryBtn}" Content="应用" Click="Apply_Click" IsDefault="True"/>
        <Button Content="隐藏到托盘" Click="Hide_Click"/>
        <Button Content="退出" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
