<Window x:Class="FlyScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FlyScreen"
        xmlns:helpers="clr-namespace:FlyScreen.Helpers"
        xmlns:ui="clr-namespace:FlyScreen.Ui.Wpf;assembly=FlyScreen.Ui.Wpf"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="玄鸟"
        Height="640" Width="960"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        StateChanged="MainWindow_StateChanged">
    <!-- Win10 DWM 沉浸式标题栏不可靠（启动时常仍发白）；改用自绘标题栏，随主题即时变色 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 色板 / 通用控件 / 表格 / 滚动条：见 FlyScreen.Ui.Theme.Wpf.WpfTheme -->

        <ControlTemplate x:Key="PcIconTemplate">
            <Grid Width="40" Height="34">
                <Border Width="36" Height="24" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#1F2937" CornerRadius="3" BorderBrush="#111827" BorderThickness="2">
                    <Border Background="#60A5FA" Margin="3" CornerRadius="2" Opacity="0.4"/>
                </Border>
                <Border Width="12" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#6B7280" CornerRadius="1"/>
            </Grid>
        </ControlTemplate>

        <!-- 1×4 卡片内容（双击移除对端；单击选中） -->
        <!-- 影子子卡：叠在底部（不占主卡布局高度，主卡文字相对整卡居中） -->
        <DataTemplate x:Key="RemoteShadowSubCard">
            <Border MinHeight="78" Padding="8,10" CornerRadius="6"
                    Background="{DynamicResource BlueSoft}" BorderBrush="{DynamicResource Blue}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ActiveRemoteStatusText}" FontSize="10"
                                   Foreground="{DynamicResource Success}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="⋯"
                                Width="28" Height="28" MinWidth="28" Padding="0" Margin="0"
                                FontSize="16" FontWeight="Bold"
                                Foreground="{DynamicResource Muted}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Focusable="False"
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                Tag="{Binding}"
                                PreviewMouseLeftButtonDown="RemoteShadowMenu_PreviewMouseLeftButtonDown"
                                Click="RemoteShadowMenu_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding ActiveRemoteName}" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource Blue}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding ActiveRemoteBindHint}" FontSize="9"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MachineCard1x4">
            <!-- 叠层：主卡相对整卡居中；子卡贴底不挤占主卡高度 -->
            <Grid Margin="4">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding PositionLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <Button Content="⋯" Width="28" Height="28" MinWidth="28" Padding="0" Margin="0,-2,-2,0"
                                FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Tag="{Binding}"
                                Visibility="{Binding ShowAsRemotePrimary, Converter={StaticResource BoolToVis}}"
                                PreviewMouseLeftButtonDown="RemoteShadowMenu_PreviewMouseLeftButtonDown"
                                Click="RemoteShadowMenu_Click"/>
                    </Grid>
                    <Control Grid.Row="1" Template="{StaticResource PcIconTemplate}"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="{Binding CardTitle}" FontSize="12" FontWeight="SemiBold"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CardTitle}"/>
                    <TextBlock Grid.Row="3" Text="{Binding CardStatus}" Foreground="{DynamicResource Success}"
                       FontWeight="SemiBold" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="4" Text="{Binding CardEdgeHint}" Foreground="{DynamicResource Blue}"
                       FontSize="10" TextAlignment="Center" Margin="0,2,0,0"
                       Visibility="{Binding ShowHostHint, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="5" Text="{Binding CardHostHint}" Foreground="{DynamicResource Muted}"
                       FontSize="10" TextAlignment="Center" Margin="0,2,0,0"
                       Visibility="{Binding ShowHostHint, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ContentControl VerticalAlignment="Bottom"
                                Content="{Binding}" ContentTemplate="{StaticResource RemoteShadowSubCard}"
                                Visibility="{Binding ShowRemoteSubCard, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- 2×2 卡片内容 -->
        <DataTemplate x:Key="MachineCard2x2">
            <Grid Margin="6,4">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Control Template="{StaticResource PcIconTemplate}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding PositionLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center"/>
                            <Button Content="⋯" Width="28" Height="28" MinWidth="28" Padding="0"
                                    FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Tag="{Binding}"
                                    Visibility="{Binding ShowAsRemotePrimary, Converter={StaticResource BoolToVis}}"
                                    PreviewMouseLeftButtonDown="RemoteShadowMenu_PreviewMouseLeftButtonDown"
                                    Click="RemoteShadowMenu_Click"/>
                        </Grid>
                        <TextBlock Text="{Binding CardTitle}" FontSize="13" FontWeight="SemiBold"
                         TextAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding CardTitle}"/>
                        <TextBlock Text="{Binding CardStatus}" Foreground="{DynamicResource Success}"
                         FontWeight="SemiBold" FontSize="11" TextAlignment="Left" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding CardEdgeHint}" Foreground="{DynamicResource Blue}"
                         FontSize="10" TextAlignment="Left" Margin="0,2,0,0"
                         Visibility="{Binding ShowHostHint, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding CardHostHint}" Foreground="{DynamicResource Muted}"
                         FontSize="10" TextAlignment="Left" Margin="0,2,0,0"
                         Visibility="{Binding ShowHostHint, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
                <ContentControl VerticalAlignment="Bottom"
                                Content="{Binding}" ContentTemplate="{StaticResource RemoteShadowSubCard}"
                                Visibility="{Binding ShowRemoteSubCard, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- 侧栏按钮：勿在选中时设 RadioButton.Foreground，否则会把彩色 Emoji 洗成单色 -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                            <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 侧栏文字：选中变蓝；与图标同一行垂直居中 -->
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 侧栏矢量图标：紧贴 Path 包围盒放大，避免再套 Canvas 造成上下留白、图标偏小 -->
        <Style x:Key="NavIconHost" TargetType="Viewbox">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="NavItemPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- IconActionBtn / Geo*：见 Theme.Wpf -->
        <!-- 工具卡片右上角三点：对齐 Maui-Win（勿吃全局 Button MinWidth=88） -->
        <Style x:Key="ToolCardMoreBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,-2,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="更多操作"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具卡片三点菜单：对齐 Maui-Win MenuFlyout（圆角白底 + 浅蓝悬停，无图标列） -->
        <Style x:Key="ToolCardContextMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                                  Opacity="0.16" Color="#14233A"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolCardMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Margin="0,1" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- NetIconOpBtn / ProgIconBtn / ProgRowIcon / WorkspaceCloseBtn：见 Theme.Wpf ActionStyles -->
        <!-- 侧栏链接样式（历史兼容） -->
        <Style x:Key="NavLinkBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具栏紧凑态依赖本窗 ProgToolsCompact / LogToolsCompact -->
        <Style x:Key="ProgToolIcon" TargetType="Viewbox">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProgToolsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgToolLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="14"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProgToolsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogToolBtn" TargetType="Button" BasedOn="{StaticResource SoftBlueBtn}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogToolsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="MinWidth" Value="30"/>
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,3,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogToolIcon" TargetType="Viewbox">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogToolsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Width" Value="13"/>
                    <Setter Property="Height" Value="13"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogToolLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogToolsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <local:StringBox x:Key="Str.DeleteTip" Value="删除"/>
        <local:StringBox x:Key="Str.Add" Value="添加"/>
        <local:StringBox x:Key="Str.ProgActStart" Value="启动"/>
        <local:StringBox x:Key="Str.ProgActStop" Value="停止"/>
        <local:StringBox x:Key="Str.ProgActEdit" Value="编辑"/>
        <local:StringBox x:Key="Str.ProgActDelete" Value="删除"/>
        <local:StringBox x:Key="Str.ProgActLog" Value="日志"/>
        <local:StringBox x:Key="Str.ProgActShare" Value="共享"/>
        <local:StringBox x:Key="Str.ProgActSettings" Value="设置"/>

        <!-- ListView / GridView / ProgressBar / TransferListItemStyle：见 Theme.Wpf ListStyles -->

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- WindowChrome 去玻璃后补 1px 外框；圆角对齐 Maui-Win / DWM；最大化时码里清零 -->
    <Border x:Name="WindowOuterBorder"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Background="{DynamicResource WinBg}"
            CornerRadius="8" ClipToBounds="True"
            SnapsToDevicePixels="True">
    <Grid>
        <!-- 自定义主题壁纸层（淡色/深色保持 Collapsed） -->
        <Image x:Name="WallpaperImage" Stretch="UniformToFill"
               Visibility="Collapsed" IsHitTestVisible="False"/>
        <!-- 仅极淡压噪，避免挡住壁纸；高透明主题靠色板 Alpha -->
        <Border x:Name="WallpaperScrim" Background="#10000000"
                Visibility="Collapsed" IsHitTestVisible="False"/>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：背景用 WinBg，深色启动即正确 -->
        <Border x:Name="AppTitleBar" Grid.Row="0"
                Background="{DynamicResource WinBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleBarText"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource Text}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TitleProjectBtn" Style="{StaticResource TitleBarBtn}"
                            FontSize="11" MinWidth="78" Padding="8,0"
                            ToolTip="投影到电脑" Click="TitleProject_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="TitleMinBtn" Style="{StaticResource TitleBarBtn}" Content="─"
                            Click="TitleMin_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="TitleMaxBtn" Style="{StaticResource TitleBarBtn}" Content="☐"
                            Click="TitleMax_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="TitleCloseBtn" Style="{StaticResource TitleBarCloseBtn}" Content="✕"
                            Click="TitleClose_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧导航 ===== -->
        <Border Grid.Column="0" Background="{DynamicResource PaneBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,12">
                <Border DockPanel.Dock="Top" Margin="12,0,12,16" Background="{DynamicResource SubtleBg}" CornerRadius="18" Height="36">
                    <DockPanel Margin="12,0">
                        <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="14" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Height="36"
                       VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholderText"
                         Text="搜索设置"
                         Foreground="{DynamicResource Placeholder}" FontSize="13"
                         VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="16,12,16,4"
                   Foreground="{DynamicResource Muted}" FontSize="11"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                   ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   Text="就绪"/>

                <StackPanel>
                    <RadioButton x:Name="NavBasic" Style="{StaticResource NavBtn}" GroupName="SideNav"
                       IsChecked="True" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <!-- 家形 Path 光学重心偏下，略上移与文字对齐 -->
                            <Viewbox Style="{StaticResource NavIconHost}" Margin="0,-1,0,1">
                                <Path Fill="#F59E0B" Data="{StaticResource GeoHome}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavBasicText" Text="基础" Style="{StaticResource NavLabel}" Padding="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#2563EB" Data="{StaticResource GeoNetwork}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavNetworkText" Text="网络" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavShare" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#10B981" Data="{StaticResource GeoShare}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavShareText" Text="共享" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSecurity" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#8B5CF6" Data="{StaticResource GeoSecurity}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavSecurityText" Text="安全" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#64748B" Data="{StaticResource GeoAdvanced}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavAdvancedText" Text="高级" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPrograms" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#14B8A6" Data="{StaticResource GeoPrograms}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavProgramsText" Text="程序" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#8B5CF6" Data="{StaticResource GeoAdvanced}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavToolsText" Text="工具" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,10,16,6"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#F97316" Data="{StaticResource GeoLog}"/>
                            </Viewbox>
                            <TextBlock x:Name="NavLogText" Text="日志" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#0EA5E9" Data="{StaticResource GeoAbout}"/>
                            </Viewbox>
                            <TextBlock x:Name="AboutBtnText" Text="关于" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHelp" Style="{StaticResource NavBtn}" GroupName="SideNav" Checked="Nav_Changed">
                        <StackPanel Style="{StaticResource NavItemPanel}">
                            <Viewbox Style="{StaticResource NavIconHost}">
                                <Path Fill="#EC4899" Data="{StaticResource GeoHelp}"/>
                            </Viewbox>
                            <TextBlock x:Name="HelpBtnText" Text="帮助" Style="{StaticResource NavLabel}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 主区 ===== -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 页面内容（无滚动条，自适应） -->
            <Grid Grid.Row="0">
                <!-- ===== 安全（独立页）：生成密钥在标题工具栏，输入框窄屏不被挤裁 ===== -->
                <Grid x:Name="PageSecurity" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="NewKeyBtn" Style="{StaticResource PrimaryBtn}"
                                            Content="生成新密钥" Click="NewKey_Click" Margin="12,0,0,0"
                                            VerticalAlignment="Center"/>
                                    <Button x:Name="SyncKeyBtn" Style="{StaticResource PrimaryBtn}"
                                            Content="同步密钥" Click="SyncKey_Click" Margin="8,0,0,0"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="SecurityTitleText" Text="安全密钥" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ui:SecurePasswordBox x:Name="SecurityKeyBox"
                                                  MinWidth="120" Height="40"
                                                  InputFontFamily="Consolas" InputFontSize="14"/>
                            <TextBlock x:Name="SecurityHintText" Text="多台电脑必须使用相同的安全密钥才能连接（最多支持 4 台）。"
                                       Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SecuritySyncHintText"
                                       Text="生成或修改密钥后点「同步密钥」，布局内已连接与因密钥不同未连上的电脑都会收到并应用。"
                                       Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 基础设置（电脑布局） ===== -->
                <Grid x:Name="PageBasic" Visibility="Visible">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Dock=Right 须先于填充子项声明，否则 LastChildFill 会把分段控件拉满 -->
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource SubtleBg}" CornerRadius="8" Padding="3"
                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Layout1x4" Style="{StaticResource SegBtn}" GroupName="LayoutMode"
                                 Content="1×4" Checked="LayoutMode_Changed"/>
                                        <RadioButton x:Name="Layout2x2" Style="{StaticResource SegBtn}" GroupName="LayoutMode"
                                 Content="2×2" IsChecked="True" Checked="LayoutMode_Changed"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="LayoutTitleText" Text="电脑布局" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <TextBlock x:Name="LayoutHintText" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"
                         Margin="0,0,0,10"
                         Text="格子代表真实摆放位置。拖拽互换；添加/移除后点「应用」会同步到已连接电脑。双击对端卡片可移除，之后可从发现再添加。"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource MatrixBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="4">
                                    <Grid>
                                        <Canvas x:Name="ArrowCanvas" IsHitTestVisible="False"/>
                                        <ItemsControl x:Name="MachineMatrix"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="Matrix_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="Matrix_PreviewMouseMove"
                                  Drop="Matrix_Drop"
                                  DragOver="Matrix_DragOver"
                                  DragLeave="Matrix_DragLeave"
                                  SizeChanged="MachineMatrix_SizeChanged">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 小间隔；2×2 更紧凑，给状态文字留空间 -->
                                                    <Border Cursor="SizeAll" Tag="{Binding}"
                                  CornerRadius="8" Background="{DynamicResource CardBg}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  SnapsToDevicePixels="True" UseLayoutRounding="True"
                                  MouseLeftButtonDown="SlotCard_MouseLeftButtonDown"
                                  ToolTip="单击选中；双击移除对端电脑">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Margin" Value="4"/>
                                                                <Style.Triggers>
                                                                    <!-- 本机：绿框（与选中蓝框区分）；后写的选中/落点覆盖本机 -->
                                                                    <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="BorderBrush" Value="#94A3B8"/>
                                                                        <Setter Property="Opacity" Value="0.9"/>
                                                                        <Setter Property="Background" Value="{DynamicResource MatrixBg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                        <Setter Property="Background" Value="{DynamicResource BlueHover}"/>
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                    <!-- 拖拽悬停：准备交换 -->
                                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
                                                                        <Setter Property="BorderThickness" Value="3"/>
                                                                        <Setter Property="Background" Value="{DynamicResource BlueSoft}"/>
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsTwoRow}" Value="True">
                                                                        <Setter Property="Margin" Value="3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ContentControl Content="{Binding}" HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource MachineCard1x4}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTwoRow}" Value="True">
                                                                            <Setter Property="ContentTemplate" Value="{StaticResource MachineCard2x2}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top" Width="100">
                                    <TextBlock x:Name="LayoutDragTipText" Text="拖拽互换位置" Foreground="{DynamicResource Blue}" FontSize="12"
                             TextAlignment="Center" Margin="0,0,0,12"/>
                                    <Button x:Name="AddMachineBtn" Content="添加电脑" Click="AddMachine_Click" Margin="0,0,0,8" Width="100"
                          HorizontalAlignment="Center"/>
                                    <Button x:Name="RemoveMachineBtn" Content="移除电脑" Click="RemoveSelectedMachine_Click" Margin="0,0,0,8" Width="100"
                          HorizontalAlignment="Center"/>
                                    <Button x:Name="ReconnectBtn" Content="刷新连接" Click="Reconnect_Click" Margin="0" Width="100" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 其他选项 ===== -->
                <Grid x:Name="PageOptions" Visibility="Collapsed"
              ToolTipService.InitialShowDelay="400"
              ToolTipService.ShowDuration="20000"
              ToolTipService.BetweenShowDelay="200">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <!-- 宽屏三列；窄屏由 OptionsFeatGrid_SizeChanged 改为单列堆叠 -->
                        <Grid x:Name="OptionsFeatGrid" SizeChanged="OptionsFeatGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="FeatColumn" Margin="0,0,10,0">
                                <TextBlock x:Name="FeatTitleText" Text="功能" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="WrapMouseCheck" Content="环形鼠标（首尾相连）"
                          ToolTip="布局最左与最右（或最上与最下）首尾相连：鼠标从一侧移出可绕到另一侧有电脑的槽位。仅相邻槽位有电脑时才会切换。"/>
                                <CheckBox x:Name="ShareClipboardCheck" Content="共享剪贴板"
                          ToolTip="在已连接电脑之间共享剪贴板。复制文本、图片等内容后，鼠标移到目标机再粘贴。"/>
                                <CheckBox x:Name="TransferFileCheck" Content="启用文件传输" Margin="20,4,0,4"
                          ToolTip="允许通过剪贴板按需传输文件，以及「文件传输」页的直接推送。关闭后仍可共享文本/图片剪贴板。"/>
                                <CheckBox x:Name="HideMouseCheck" Content="隐藏光标"
                          ToolTip="启用后已连接电脑同一时间只有 1 台活动并显示光标，其余隐藏；某台物理鼠标活动时立即成为活动机。关闭后非活动电脑光标居中显示。"/>
                                <CheckBox x:Name="DrawCursorCheck" Content="绘制鼠标光标（预留）"
                          ToolTip="预留选项：在远端屏幕上绘制虚拟光标。当前版本尚未启用实际绘制逻辑。"/>
                                <CheckBox x:Name="SameSubnetCheck" Content="仅同网段连接"
                          ToolTip="仅允许与本机同一网段的电脑建立连接，可减少误连，但跨网段（如 VPN）将无法连接。"/>
                                <CheckBox x:Name="ShowStatusCheck" Content="显示状态消息"
                          ToolTip="在窗口底部显示连接、传输等状态提示信息。"/>
                            </StackPanel>
                            <StackPanel x:Name="BehColumn" Grid.Column="1" Margin="5,0">
                                <TextBlock x:Name="BehTitleText" Text="行为" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="AutoStartCheck" Content="开机自动启动并连接"
                          ToolTip="登录后约 15 秒以管理员权限启动（任务计划程序）。因需提权，不能用普通启动项。"/>
                                <CheckBox x:Name="BlockSaverCheck" Content="阻止其他机器屏保"
                          ToolTip="开启后，只要集群中有已连接电脑，各端会抑制本机屏保/空闲熄屏，避免切回时已黑屏或锁屏。"/>
                                <CheckBox x:Name="MoveRelCheck" Content="相对移动鼠标"
                          ToolTip="使用相对位移转发鼠标移动。部分游戏或远程桌面场景可能更流畅，一般办公建议关闭。"/>
                                <CheckBox x:Name="BlockCornerCheck" Content="屏幕四角阻挡切换"
                          ToolTip="屏幕四角附近不触发边缘切换，减少误触（例如移向关闭按钮时）。"/>
                                <CheckBox x:Name="EasyMouseCheck" Content="轻松鼠标（移出边缘切换）"
                          ToolTip="启用后，将鼠标移出屏幕边缘即可切换到布局中相邻的电脑。"/>
                                <CheckBox x:Name="LockInputHelperCheck" Content="锁屏输入助手"
                          ToolTip="开启后安装本机解锁服务，允许其它电脑在本机锁屏/登录界面继续使用键鼠（需管理员；有额外安全风险）。关闭则卸载服务。"/>
                            </StackPanel>
                            <StackPanel x:Name="EdgeCrossColumn" Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock x:Name="EdgeCrossTitleText" Text="穿边模式" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <RadioButton x:Name="EdgeCrossBarrierRadio" Content="无障碍" GroupName="EdgeCross"
                                             Margin="0,0,0,4" Checked="EdgeCrossMode_Changed"/>
                                <RadioButton x:Name="EdgeCrossDoubleRadio" Content="双击" GroupName="EdgeCross"
                                             Margin="0,0,0,4" Checked="EdgeCrossMode_Changed"/>
                                <RadioButton x:Name="EdgeCrossSpeedRadio" Content="极速" GroupName="EdgeCross"
                                             Margin="0,0,0,4" Checked="EdgeCrossMode_Changed"/>
                                <RadioButton x:Name="EdgeCrossHotkeyRadio" Content="快捷键" GroupName="EdgeCross"
                                             Margin="0,0,0,8" Checked="EdgeCrossMode_Changed"/>
                                <TextBlock x:Name="EdgeCrossTipText" Text="" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 快捷键占剩余宽度，系统设置固定较窄 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="HotTitleText" Text="键盘快捷键" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="HotSwitchText" Text="切换机器（Ctrl+Alt+）"
                           Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="HotF" Content="F1–F4" GroupName="Sw" Margin="0,0,14,0" VerticalContentAlignment="Center" IsChecked="True"/>
                                    <RadioButton x:Name="HotNum" Content="1–4" GroupName="Sw" Margin="0,0,14,0" VerticalContentAlignment="Center"/>
                                    <RadioButton x:Name="HotOff" Content="禁用" GroupName="Sw" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <!-- 行高必须 Auto：StackPanel 内 * 行会被量成 0 -->
                                <!-- 标签 Auto 完整显示；输入框 * 填满剩余，避免 48px 被主题 Padding 挤没字符 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="36"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="HotSettingsLabel" Text="显示设置 (Ctrl+Alt+)" VerticalAlignment="Center" Margin="0,0,4,8"/>
                                    <TextBox x:Name="HkSettings" Grid.Column="1" Height="32" Margin="0,0,0,8" MaxLength="1"
                                             Padding="4,0" MinWidth="36"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="HotReconnectLabel" Grid.Column="3" Text="重新连接 (Ctrl+Alt+)"
                                               VerticalAlignment="Center" Margin="0,0,4,8"/>
                                    <TextBox x:Name="HkReconnect" Grid.Column="4" Height="32" Margin="0,0,0,8" MaxLength="1"
                                             Padding="4,0" MinWidth="36"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="HotExitLabel" Grid.Row="1" Text="退出程序 (Ctrl+Alt+)"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HkExit" Grid.Row="1" Grid.Column="1" Height="32" MaxLength="1"
                                             Padding="4,0" MinWidth="36"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="HotLockLabel" Grid.Row="1" Grid.Column="3" Text="锁定机器 (Ctrl+Alt+)"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HkLock" Grid.Row="1" Grid.Column="4" Height="32" MaxLength="1"
                                             Padding="4,0" MinWidth="36"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="SysTitleText" Text="系统设置" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <!-- 标签固定宽 + 控件同行垂直居中，三行标签左缘对齐 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SysStyleLabel" Text="样式"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinHeight="34"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SysLangLabel" Text="语言"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinHeight="34"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <StackPanel x:Name="WallpaperPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SysWallpaperLabel" Text="背景图"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="WallpaperPickBtn" Content="选择…"
                                                    Padding="10,0" MinWidth="64" Height="32"
                                                    Click="WallpaperPick_Click"/>
                                            <Button x:Name="WallpaperClearBtn" Content="清除"
                                                    Margin="8,0,0,0" Padding="10,0" MinWidth="56" Height="32"
                                                    Click="WallpaperClear_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="WallpaperPathText" Text="未选择" Margin="64,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== 网络设置：连接配置 / 设备管理 ===== -->
                <Grid x:Name="PageNetwork" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="NetworkBreadcrumbHost" Orientation="Horizontal" Margin="0,0,0,10"/>
                    <!-- 连接配置 -->
                    <Border x:Name="PanelConnConfig" Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Button x:Name="AddEndpointBtn" DockPanel.Dock="Right" Width="32" Height="28" Padding="0"
                                        ToolTip="添加配置" Click="AddEndpoint_Click" Margin="8,0,0,0"
                                        Background="{DynamicResource BlueSoft}" BorderBrush="{DynamicResource Blue}" BorderThickness="1"
                                        Foreground="{DynamicResource Blue}" FontWeight="SemiBold" FontSize="16" Content="+"/>
                                <StackPanel>
                                    <TextBlock x:Name="ConnConfigTitleText" Text="连接配置" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="ConnConfigHintText"
                                               Text="本机网卡用于局域网；可添加远程设备或服务地址（旧端忽略未知配置，局域网互通不受影响）。"
                                               Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="{DynamicResource ListBg}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,8">
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ConnColType" Text="类型" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                    <TextBlock x:Name="ConnColAddr" Grid.Column="1" Text="地址" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="ConnColOp" Grid.Column="2" Text="操作" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}" Width="96" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 固定：本机网卡；单操作钮拉满与双按钮同宽 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NicTitleText" Text="本机网卡" VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <ComboBox x:Name="NicCombo" Grid.Column="1" DisplayMemberPath="Display"
                                                      VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                            <Button x:Name="RefreshNicsBtn" Grid.Column="2" Style="{StaticResource NetIconOpBtn}"
                                                    Content="↻" ToolTip="刷新网卡" Click="RefreshNics_Click"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl x:Name="EndpointList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}"
                                                        BorderThickness="0,0,0,1" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="96"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- 不用 ComboBox：嵌在 ItemsControl 内时 SelectedIndex 易写回 -1，行看起来像没加上 -->
                                                        <Button Content="{Binding KindLabel}"
                                                                Tag="{Binding}"
                                                                Click="EndpointKind_Click"
                                                                FontWeight="SemiBold"
                                                                Margin="0"
                                                                MinWidth="0"
                                                                Padding="10,0"
                                                                HorizontalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                ToolTip="{Binding KindToggleTip}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,0,8,0" VerticalContentAlignment="Center"
                                                                 ToolTip="{Binding AddressTip}"/>
                                                        <Grid Grid.Column="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Style="{StaticResource NetIconOpBtn}"
                                                                    Content="⚡" ToolTip="测试（通过后才进入设备管理）" Click="TestEndpoint_Click" Tag="{Binding}"/>
                                                            <Button Grid.Column="2" Style="{StaticResource NetIconOpBtnWarn}"
                                                                    Content="−" ToolTip="删除" Click="DeleteEndpoint_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,8,0" FontSize="11"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   Text="{Binding StatusText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- 兼容：隐藏旧发现列表宿主，供代码迁移期引用 -->
                                    <ListBox x:Name="DiscoveryList" Visibility="Collapsed" Height="0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TcpPortLabel" Text="TCP" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBox x:Name="TcpPortBox" Grid.Column="1" Text="15155"/>
                                <TextBlock x:Name="UdpPortLabel" Grid.Column="2" Text="发现" VerticalAlignment="Center" Margin="20,0,8,0"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBox x:Name="UdpPortBox" Grid.Column="3" Text="15156"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- 设备管理 -->
                    <Border x:Name="PanelDeviceMgmt" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                <Button x:Name="RefreshDiscoveryBtn" DockPanel.Dock="Right" Width="32" Height="28" Padding="0"
                                        Content="↻" ToolTip="刷新发现" Click="RefreshDiscovery_Click"
                                        Foreground="{DynamicResource Blue}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="DiscoveryTitleText" Text="设备管理" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="DiscoveryHintText"
                                               Text="刷新：全网卡（含 Tailscale）广播并探测连接配置中的远程地址；发现到的以「本地」列出。设备管理无上限，布局最多 4 台。"
                                               Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="DevFilterAll" Content="全部" IsChecked="True" Margin="0,0,12,0"
                                             GroupName="DevFilter" Checked="DevFilter_Changed"/>
                                <RadioButton x:Name="DevFilterLocal" Content="本地" Margin="0,0,12,0"
                                             GroupName="DevFilter" Checked="DevFilter_Changed"/>
                                <RadioButton x:Name="DevFilterRemote" Content="远程" Margin="0,0,12,0"
                                             GroupName="DevFilter" Checked="DevFilter_Changed"/>
                                <RadioButton x:Name="DevFilterService" Content="服务"
                                             GroupName="DevFilter" Checked="DevFilter_Changed"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="{DynamicResource ListBg}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="8,8,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DevColName" Text="设备名称" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="DevColKind" Grid.Column="1" Text="类型" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="DevColAddr" Grid.Column="2" Text="地址" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="DevColStatus" Grid.Column="3" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="DevColOp" Grid.Column="4" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ListBox x:Name="DeviceInventoryList" Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,1,1"
                                     Background="{DynamicResource ListBg}" Foreground="{DynamicResource Text}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,10"
                                                Background="{DynamicResource CardBg}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="1">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="2">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Address}" Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                <Grid Grid.Column="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource NetIconOpBtn}"
                                                            Content="{Binding PrimaryActionIcon}"
                                                            ToolTip="{Binding PrimaryActionText}"
                                                            Click="DevicePrimaryAction_Click" Tag="{Binding}"
                                                            Grid.ColumnSpan="{Binding PrimaryActionColumnSpan}"
                                                            Visibility="{Binding PrimaryActionVisible, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Grid.Column="2" Style="{StaticResource NetIconOpBtnWarn}"
                                                            Content="{Binding SecondaryActionIcon}"
                                                            ToolTip="{Binding SecondaryActionText}"
                                                            Click="DeviceSecondaryAction_Click" Tag="{Binding}"
                                                            Visibility="{Binding SecondaryActionVisible, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <!-- 兼容旧本地化字段名（隐藏） -->
                    <TextBlock x:Name="NicHintText" Visibility="Collapsed"/>
                </Grid>

                <!-- ===== 文件传输 ===== -->
                <Grid x:Name="PageTransfer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="XferTitleText" Text="传输列表" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="XferHintText" Text="剪贴板粘贴：仅传到粘贴机。直接传输：推送到指定电脑的指定目录。清除只删接收缓存。"
                       Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DirectTransferBtn" Style="{StaticResource PrimaryBtn}" Content="直接传输…" Margin="0,0,8,0"
                      Click="DirectTransfer_Click"/>
                            <Rectangle Width="1" Height="22" Fill="{DynamicResource Line}" Margin="4,0,12,0"
                         VerticalAlignment="Center"/>
                            <Button x:Name="OpenInboxBtn" Content="打开收件箱" Margin="0,0,8,0" Click="OpenInbox_Click"/>
                            <Button x:Name="ReceiveClipboardBtn" Content="接收剪贴板文件" Margin="0,0,8,0" Click="ReceiveClipboardFiles_Click"/>
                            <Button x:Name="ClearTransfersBtn" Content="清除已完成" Margin="0" Click="ClearTransfers_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardList}" Background="{DynamicResource CardBg}">
                        <ListView x:Name="TransferList" BorderThickness="0"
                      Background="{DynamicResource ListBg}" Foreground="{DynamicResource Text}"
                      ItemContainerStyle="{StaticResource TransferListItemStyle}"
                      MouseDoubleClick="TransferList_MouseDoubleClick"
                      SizeChanged="TransferList_SizeChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn x:Name="ColDir" Header="方向" Width="56" DisplayMemberBinding="{Binding DirectionText}"/>
                                    <GridViewColumn x:Name="ColName" Header="文件名" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FileName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Cursor="Hand" ToolTip="打开所在文件夹"
                                                           MouseLeftButtonUp="TransferFileName_Click"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn x:Name="ColPeer" Header="对端" Width="120" DisplayMemberBinding="{Binding PeerName}"/>
                                    <GridViewColumn x:Name="ColSize" Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn x:Name="ColStatus" Header="状态" Width="88" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn x:Name="ColAction" Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconActionBtn}"
                                                        Click="DeleteTransfer_Click" Tag="{Binding}"
                                                        ToolTip="{Binding Value, Source={StaticResource Str.DeleteTip}}">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Fill="#EF4444" Data="{StaticResource GeoDelete}"/>
                                                    </Viewbox>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- ===== 程序 ===== -->
                <Grid x:Name="PagePrograms" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ProgTitleText" Text="程序" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ProgHintText" Grid.Row="1" Text="管理可单文件运行的脚本与程序。"
                                       Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Grid x:Name="ProgToolBarHost" Grid.Row="2" Margin="0,0,0,10"
                                  SizeChanged="ProgToolBarHost_SizeChanged">
                                <StackPanel x:Name="ProgToolBar" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="ProgAddBtn" Style="{StaticResource SoftBlueBtn}"
                                            MinWidth="36" Padding="10,0" Margin="0,0,8,0"
                                            Click="ProgAdd_Click" ToolTip="添加程序">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource ProgToolIcon}">
                                                <Path Data="{StaticResource GeoAdd}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="ProgAddBtnText" Text="添加程序" Style="{StaticResource ProgToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ProgDeleteBtn" Style="{StaticResource SoftBlueBtn}"
                                            MinWidth="36" Padding="10,0" Margin="0,0,8,0"
                                            Click="ProgDelete_Click" ToolTip="删除程序">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource ProgToolIcon}">
                                                <Path Data="{StaticResource GeoDelete}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="ProgDeleteBtnText" Text="删除程序" Style="{StaticResource ProgToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ProgStartBtn" Style="{StaticResource SoftBlueBtn}"
                                            MinWidth="36" Padding="10,0" Margin="0,0,8,0"
                                            Click="ProgStart_Click" ToolTip="启动程序">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource ProgToolIcon}">
                                                <Path Data="{StaticResource GeoPlay}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="ProgStartBtnText" Text="启动程序" Style="{StaticResource ProgToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ProgStopBtn" Style="{StaticResource SoftBlueBtn}"
                                            MinWidth="36" Padding="10,0" Margin="0"
                                            Click="ProgStop_Click" ToolTip="停止程序">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource ProgToolIcon}">
                                                <Path Data="{StaticResource GeoStop}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="ProgStopBtnText" Text="停止程序" Style="{StaticResource ProgToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="ProgList" Grid.Row="3" BorderThickness="0"
                                      Background="{DynamicResource ListBg}" Foreground="{DynamicResource Text}"
                                      SizeChanged="ProgList_SizeChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn x:Name="ProgColCheck" Width="36">
                                            <GridViewColumn.Header>
                                                <CheckBox x:Name="ProgSelectAll" Click="ProgSelectAll_Click"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <!-- 名称列宽度在 SizeChanged 中按剩余空间计算 -->
                                        <GridViewColumn x:Name="ProgColName" Header="程序名称" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn x:Name="ProgColLang" Header="语言" Width="110" DisplayMemberBinding="{Binding LanguageText}"/>
                                        <GridViewColumn x:Name="ProgColSize" Header="大小" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn x:Name="ProgColStatus" Header="状态" Width="70" DisplayMemberBinding="{Binding StatusText}"/>
                                        <GridViewColumn x:Name="ProgColActions" Header="操作" Width="176">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ProgIconBtn}"
                                                                Tag="{Binding}" Click="ProgRowStart_Click">
                                                            <Button.ToolTip>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding Value, Source={StaticResource Str.ProgActStart}}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActivelyRunning}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding Value, Source={StaticResource Str.ProgActStop}}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button.ToolTip>
                                                            <Viewbox Style="{StaticResource ProgRowIcon}">
                                                                <Path>
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Data" Value="{StaticResource GeoPlay}"/>
                                                                            <Setter Property="Fill" Value="#059669"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActivelyRunning}" Value="True">
                                                                                    <Setter Property="Data" Value="{StaticResource GeoStop}"/>
                                                                                    <Setter Property="Fill" Value="#DC2626"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Style="{StaticResource ProgIconBtn}"
                                                                ToolTip="{Binding Value, Source={StaticResource Str.ProgActEdit}}"
                                                                Tag="{Binding}" Click="ProgRowEdit_Click">
                                                            <Viewbox Style="{StaticResource ProgRowIcon}">
                                                                <Path Data="{StaticResource GeoEdit}" Fill="#2563EB"/>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Style="{StaticResource ProgIconBtn}"
                                                                ToolTip="{Binding Value, Source={StaticResource Str.ProgActLog}}"
                                                                Tag="{Binding}" Click="ProgRowLog_Click">
                                                            <Viewbox Style="{StaticResource ProgRowIcon}">
                                                                <Path Data="{StaticResource GeoLog}" Fill="#F97316"/>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Style="{StaticResource ProgIconBtn}"
                                                                ToolTip="{Binding Value, Source={StaticResource Str.ProgActShare}}"
                                                                Tag="{Binding}" Click="ProgRowShare_Click">
                                                            <Viewbox Style="{StaticResource ProgRowIcon}">
                                                                <Path Data="{StaticResource GeoShare}" Fill="#10B981"/>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Style="{StaticResource ProgIconBtn}"
                                                                ToolTip="{Binding Value, Source={StaticResource Str.ProgActSettings}}"
                                                                Tag="{Binding}" Click="ProgRowSettings_Click">
                                                            <Viewbox Style="{StaticResource ProgRowIcon}">
                                                                <Path Data="{StaticResource GeoAdvanced}" Fill="#6366F1"/>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Style="{StaticResource ProgIconBtn}" Margin="0"
                                                                ToolTip="{Binding Value, Source={StaticResource Str.ProgActDelete}}"
                                                                Tag="{Binding}" Click="ProgRowDelete_Click">
                                                            <Viewbox Style="{StaticResource ProgRowIcon}">
                                                                <Path Data="{StaticResource GeoDelete}" Fill="#EF4444"/>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 工具（目录卡片 + 内嵌工作区导航） ===== -->
                <Grid x:Name="PageTools" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <TextBlock x:Name="ToolsTitleText" Text="工具" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ToolsWorkspaceNavPanel" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="ToolsImportBtn" Content="导入" DockPanel.Dock="Right"
                                        Padding="12,4" Margin="8,0,0,0" Click="ToolsImport_Click"/>
                            </DockPanel>
                            <TextBlock x:Name="ToolsHintText" Grid.Row="1" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="ToolsShortcutHost" Grid.Row="2" Margin="0,0,0,12" MinHeight="72"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch">
                                <StackPanel x:Name="ToolsShortcutBar" Orientation="Horizontal"
                                            HorizontalAlignment="Left"/>
                            </ScrollViewer>
                            <ScrollViewer x:Name="ToolsCatalogHost" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          SizeChanged="ToolsCatalogHost_SizeChanged">
                                <!-- VerticalAlignment=Top：避免 ScrollViewer 拉伸后 UniformGrid 把卡片垂直居中 -->
                                <ItemsControl x:Name="ToolsList" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="104" Margin="6" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                    CornerRadius="10" BorderThickness="1"
                                                    ClipToBounds="True"
                                                    MouseLeftButtonDown="ToolCard_MouseLeftButtonDown"
                                                    MouseLeftButtonUp="ToolCard_MouseLeftButtonUp"
                                                    MouseMove="ToolCard_MouseMove"
                                                    MouseEnter="ToolCard_MouseEnter"
                                                    MouseLeave="ToolCard_MouseLeave"
                                                    Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- BorderBrush 必须在 Style 内，否则本地值会压过悬停 Trigger -->
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                                        <Setter Property="Background" Value="{DynamicResource ToolCardNotInstalledBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="Installed">
                                                                <Setter Property="Background" Value="{DynamicResource ToolCardInstalledBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="LocalProgram">
                                                                <Setter Property="Background" Value="{DynamicResource ToolCardInstalledBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="Running">
                                                                <Setter Property="Background" Value="{DynamicResource ToolCardRunningBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="Installing">
                                                                <Setter Property="Background" Value="{DynamicResource ToolCardInstallingBg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <!-- 安装进度：自左向右铺底 -->
                                                    <Border Background="{DynamicResource ToolCardProgress}" Opacity="0.55"
                                                            IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding InstallProgressRatio}"/>
                                                        </Border.RenderTransform>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <!-- 悬停淡罩（由 MouseEnter/Leave 控制，对齐 Maui-Win） -->
                                                    <Border Tag="ToolCardHoverWash"
                                                            Background="{DynamicResource BlueHover}" Opacity="0.32"
                                                            IsHitTestVisible="False" CornerRadius="10"
                                                            Visibility="Collapsed"/>
                                                    <Grid Margin="12,10,8,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 图标瓷砖：对齐 Maui-Win CreateToolCard -->
                                                        <Border Width="48" Height="48" CornerRadius="10"
                                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                                Background="{DynamicResource SubtleBg}"
                                                                VerticalAlignment="Center"
                                                                SnapsToDevicePixels="True">
                                                            <Image Width="36" Height="36" Stretch="Uniform"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Source="{Binding IconKey, Converter={x:Static helpers:ToolIconKeyToImageConverter.Instance}}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="8,0,0,0"
                                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="⋯"
                                                                Style="{StaticResource ToolCardMoreBtn}"
                                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                Click="ToolCardMore_Click"
                                                                PreviewMouseLeftButtonDown="ToolCardMore_PreviewMouseLeftButtonDown"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ContentControl x:Name="ToolsWorkspaceHost" Grid.Row="3" Visibility="Collapsed"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 日志 ===== -->
                <Grid x:Name="PageLog" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LogTitleText" Text="日志" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <Border x:Name="LogToolBarHost" Grid.Row="1" Margin="0,0,0,6"
                                    SizeChanged="LogToolBarHost_SizeChanged" ClipToBounds="True">
                                <StackPanel x:Name="LogToolBar" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ComboBox x:Name="LogLevelFilter" Width="96" Margin="0,0,4,0" Height="32"
                                              VerticalAlignment="Center" SelectionChanged="LogFilter_Changed"/>
                                    <Button x:Name="LogPrevBtn" Style="{StaticResource LogToolBtn}"
                                            Click="LogPrev_Click" ToolTip="上一页">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoChevronLeft}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogPrevBtnText" Text="上一页" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogNextBtn" Style="{StaticResource LogToolBtn}"
                                            Click="LogNext_Click" ToolTip="下一页">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoChevronRight}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogNextBtnText" Text="下一页" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogLatestBtn" Style="{StaticResource LogToolBtn}"
                                            Click="LogLatest_Click" ToolTip="实时">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoRefresh}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogLatestBtnText" Text="实时" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogDateBtn" Style="{StaticResource LogToolBtn}"
                                            Click="LogDate_Click" ToolTip="日期">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoCalendar}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogDateBtnText" Text="日期" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogDownloadBtn" Style="{StaticResource LogToolBtn}"
                                            Click="LogDownload_Click" ToolTip="下载">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoDownload}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogDownloadBtnText" Text="下载" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogCopyBtn" Style="{StaticResource LogToolBtn}"
                                            Click="LogCopy_Click" ToolTip="复制选中">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoCopy}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogCopyBtnText" Text="复制" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogClearBtn" Style="{StaticResource LogToolBtn}" Margin="0"
                                            Click="LogClear_Click" ToolTip="清除">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Style="{StaticResource LogToolIcon}">
                                                <Path Data="{StaticResource GeoDelete}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                            <TextBlock x:Name="LogClearBtnText" Text="清除" Style="{StaticResource LogToolLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock x:Name="LogPageText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="LogHintText" Text="收录运行中的状态与错误。新记录在底部。"
                                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                            <ListBox x:Name="LogList" Grid.Row="3" BorderThickness="0"
                                     Background="{DynamicResource ListBg}" Foreground="{DynamicResource Text}"
                                     SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.ScrollChanged="LogList_ScrollChanged"
                                     VirtualizingPanel.IsVirtualizing="False">
                                <ListBox.InputBindings>
                                    <KeyBinding Key="C" Modifiers="Control" Command="{x:Static ApplicationCommands.Copy}"/>
                                </ListBox.InputBindings>
                                <ListBox.CommandBindings>
                                    <CommandBinding Command="{x:Static ApplicationCommands.Copy}"
                                                    Executed="LogCopy_Executed"/>
                                </ListBox.CommandBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Muted}" FontFamily="Consolas, Cascadia Mono, Courier New"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LevelText}" MinWidth="40"
                                                       Margin="0,0,8,0" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Foreground" Value="#F87171"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                                <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
                                                            </DataTrigger>
                                                            <!-- 选中行：级别色改为主题文字，避免深色 BlueSoft 底上发灰发糊 -->
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 关于 ===== -->
                <Grid x:Name="PageAbout" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="AboutTitleText" Text="关于" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock x:Name="AboutBodyText" TextWrapping="Wrap" LineHeight="22"
                           Foreground="{DynamicResource Text}" FontSize="13"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== 帮助（工具栏 + 富文本区） ===== -->
                <Grid x:Name="PageHelp" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="HelpDocBtn" Style="{StaticResource NormalBtn}" Content="帮助文本"
                        Click="HelpDoc_Click" Margin="0,0,8,0"/>
                                <Button x:Name="HelpUpdateBtn" Style="{StaticResource SoftBlueBtn}" Content="检查更新"
                        Click="HelpUpdate_Click" Margin="0,0,8,0"/>
                                <Button x:Name="HelpDiagBtn" Style="{StaticResource SoftWarnBtn}" Content="问题检查"
                        Click="HelpDiag_Click" Margin="0"/>
                            </WrapPanel>
                            <ProgressBar x:Name="HelpUpdateProgressBar" Height="10" Minimum="0" Maximum="100"
                           Margin="0,10,0,0" Visibility="Collapsed"
                           Background="{DynamicResource ControlBorder}" Foreground="{DynamicResource Blue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <RichTextBox x:Name="HelpRich"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         IsUndoEnabled="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Text}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="12,10"
                         Focusable="True"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部按钮：应用 / 隐藏 / 退出 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryBtn}" Content="应用" Click="Apply_Click" IsDefault="True"/>
                <Button x:Name="HideTrayBtn" Content="隐藏到托盘" Click="Hide_Click"/>
                <Button x:Name="ExitBtn" Content="退出" Click="Exit_Click"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
