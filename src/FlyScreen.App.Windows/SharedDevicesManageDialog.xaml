<Window x:Class="FlyScreen.SharedDevicesManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享设备管理"
        Width="480" Height="420"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="BluePress" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BlueHover" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Text" Color="#111827"/>
    <SolidColorBrush x:Key="WinBg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>

    <Style x:Key="DlgBtn" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
      <Setter Property="Background" Value="{DynamicResource Blue}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource Muted}"
               TextWrapping="Wrap" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="1">
      <TextBlock x:Name="SpeakerLabel" Margin="0,0,0,4"/>
      <ComboBox x:Name="SpeakerCombo" Height="30" Margin="0,0,0,12"/>
      <TextBlock x:Name="MicLabel" Margin="0,0,0,4"/>
      <ComboBox x:Name="MicCombo" Height="30" Margin="0,0,0,12"/>
      <TextBlock x:Name="CameraLabel" Margin="0,0,0,4"/>
      <ComboBox x:Name="CameraCombo" Height="30" Margin="0,0,0,12"/>
      <Button x:Name="ClearRememberBtn" Style="{StaticResource DlgBtn}" HorizontalAlignment="Left"
              Click="ClearRemember_Click"/>
      <TextBlock x:Name="ClearStatus" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="SaveBtn" Style="{StaticResource DlgPrimaryBtn}" Margin="0,0,8,0" Click="Save_Click"/>
      <Button x:Name="CloseBtn" Style="{StaticResource DlgBtn}" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
