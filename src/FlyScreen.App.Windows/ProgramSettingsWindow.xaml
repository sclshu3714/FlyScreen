<Window x:Class="FlyScreen.ProgramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="520" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" Width="88" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Content="保存" Width="88" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="FieldsHost"/>
    </ScrollViewer>
  </DockPanel>
</Window>
