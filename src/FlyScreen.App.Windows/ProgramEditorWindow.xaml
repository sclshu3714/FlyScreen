<Window x:Class="FlyScreen.ProgramEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑程序"
        Height="560" Width="780"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        FontFamily="Consolas, Microsoft YaHei UI, Cascadia Mono"
        FontSize="13">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
      <TextBlock x:Name="TitleText" DockPanel.Dock="Left" FontSize="14" FontWeight="SemiBold"
                 FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock x:Name="BpHintText" DockPanel.Dock="Right" FontFamily="Microsoft YaHei UI"
                 Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="BtnSave" Content="保存" Margin="0,0,6,0" Padding="10,4" Click="Save_Click"/>
        <Button x:Name="BtnDebug" Content="调试" Margin="0,0,6,0" Padding="10,4" Click="Debug_Click"/>
        <Button x:Name="BtnBreakpoint" Content="断点" Margin="0,0,6,0" Padding="10,4" Click="Breakpoint_Click"/>
        <Button x:Name="BtnClearBp" Content="取消断点" Margin="0,0,6,0" Padding="10,4" Click="ClearBp_Click"/>
        <Button x:Name="BtnClearAllBp" Content="清除断点" Margin="0,0,6,0" Padding="10,4" Click="ClearAllBp_Click"/>
        <Button x:Name="BtnRun" Content="运行" Margin="0,0,6,0" Padding="10,4" Click="Run_Click"
                Background="#2563EB" Foreground="White" BorderThickness="0"/>
        <Button x:Name="BtnStop" Content="停止" Padding="10,4" Click="Stop_Click"/>
      </StackPanel>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="LineNumbers" Grid.Column="0" IsReadOnly="True" IsTabStop="False"
               Background="#F3F4F6" Foreground="#9CA3AF" BorderThickness="1,1,0,1"
               BorderBrush="#D1D5DB" Padding="4,8" TextAlignment="Right"
               VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
               FontFamily="Consolas, Cascadia Mono"/>
      <TextBox x:Name="CodeBox" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True"
               TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto" BorderBrush="#D1D5DB"
               Padding="8" FontFamily="Consolas, Cascadia Mono"
               SelectionChanged="CodeBox_SelectionChanged"
               TextChanged="CodeBox_TextChanged"/>
    </Grid>
  </DockPanel>
</Window>
