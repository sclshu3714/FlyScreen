<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\FlyScreen.Assets.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10：共享设备摄像头走 MediaCapture（与 Maui-Win 对齐；MF 枚举在本机常失败） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FlyScreen</RootNamespace>
    <!-- 产物仍为 FlyScreen.exe，便于更新替换与开机自启任务名不变 -->
    <AssemblyName>FlyScreen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(FlyScreenAppIco)</ApplicationIcon>
    <AssemblyTitle>玄鸟</AssemblyTitle>
    <Product>玄鸟</Product>
    <Authors>sclshu3714</Authors>
    <Company>玄鸟</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Description>玄鸟 — 跨电脑键鼠与剪贴板共享（灵感来源 Mouse without Borders，中文增强版）</Description>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' == ''">true</SelfContained>
  </PropertyGroup>

  <!-- WPF pack:// URI 需要「资源」(Resource)。Link 保持 Assets/wlogo_tu.ico，窗口代码不用改。 -->
  <ItemGroup>
    <Resource Include="$(FlyScreenAppIco)">
      <Link>Assets\wlogo_tu.ico</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Assets\FlyScreen.Assets.csproj" />
    <ProjectReference Include="..\FlyScreen.Core\FlyScreen.Core.csproj" />
    <ProjectReference Include="..\FlyScreen.ToolSdk\FlyScreen.ToolSdk.csproj" />
    <ProjectReference Include="..\FlyScreen.Windows\FlyScreen.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <Import Project="..\..\build\FlyScreen.Version.targets" />
  <Import Project="..\..\build\FlyScreen.BundleTopologyGuard.targets" />
  <!-- VddOffline → zip 放入发布目录 VddOffline\；单文件则打进包，运行时再落到同路径并展开到 AppData -->
  <Import Project="..\..\build\FlyScreen.BundleVddOffline.targets" />
  <Import Project="..\..\build\FlyScreen.BundleFlyTools.targets" />

</Project>
