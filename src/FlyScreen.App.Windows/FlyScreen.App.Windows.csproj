<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FlyScreen</RootNamespace>
    <!-- 产物仍为 FlyScreen.exe，便于更新替换与开机自启任务名不变 -->
    <AssemblyName>FlyScreen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wlogo_tu.ico</ApplicationIcon>
    <Product>玄鸟</Product>
    <Authors>sclshu3714</Authors>
    <Company>玄鸟</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Description>玄鸟 — 跨电脑键鼠与剪贴板共享（灵感来源 Mouse without Borders，中文增强版）</Description>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' == ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\wlogo_tu.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Core\FlyScreen.Core.csproj" />
    <ProjectReference Include="..\FlyScreen.Windows\FlyScreen.Windows.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\FlyScreen.Version.targets" />

</Project>
