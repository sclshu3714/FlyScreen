<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 与 ThemeService 对齐的默认淡色；深色由 ThemeService 覆盖 -->
  <SolidColorBrush x:Key="ScrollTrack" Color="#00000000"/>
  <SolidColorBrush x:Key="ScrollThumb" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#94A3B8"/>
  <SolidColorBrush x:Key="ScrollThumbDrag" Color="#64748B"/>

  <Style x:Key="FlyScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd"
                  Background="{DynamicResource ScrollThumb}"
                  CornerRadius="4"
                  Margin="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 隐藏上下箭头，只留细滑块，贴近卡片 UI -->
  <Style x:Key="FlyScrollRepeater" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" Height="0" Width="0"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="FlyVerticalScrollBar" TargetType="ScrollBar">
    <Grid Width="10" Background="{DynamicResource ScrollTrack}">
      <Border CornerRadius="5" Background="{DynamicResource ScrollTrack}" Margin="1,0"/>
      <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource FlyScrollRepeater}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource FlyScrollThumb}" MinHeight="28"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource FlyScrollRepeater}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="FlyHorizontalScrollBar" TargetType="ScrollBar">
    <Grid Height="10" Background="{DynamicResource ScrollTrack}">
      <Border CornerRadius="5" Background="{DynamicResource ScrollTrack}" Margin="0,1"/>
      <Track x:Name="PART_Track" Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource FlyScrollRepeater}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource FlyScrollThumb}" MinWidth="28"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource FlyScrollRepeater}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource ScrollTrack}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template" Value="{StaticResource FlyVerticalScrollBar}"/>
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template" Value="{StaticResource FlyHorizontalScrollBar}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
