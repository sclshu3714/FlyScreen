<Window x:Class="FlyScreen.SharedDevicesTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享设备测试"
        Width="560" Height="560"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Closed="Window_Closed">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="BluePress" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BlueHover" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Text" Color="#111827"/>
    <SolidColorBrush x:Key="WinBg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="SubtleBg" Color="#F3F4F6"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style x:Key="DlgBtn" TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
      <Setter Property="Background" Value="{DynamicResource Blue}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BluePress}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BluePress}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Text="共享设备测试" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- 摄像头 -->
        <Border Margin="0,0,0,12" Padding="12" CornerRadius="10"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="220"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="CameraTitle" Text="测试摄像头" FontWeight="SemiBold"/>
            <TextBlock x:Name="CameraHint" Grid.Row="1" FontSize="12" Foreground="{DynamicResource Muted}"
                       Margin="0,4,0,8" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
              <ComboBox x:Name="CameraCombo" MinWidth="220" Height="30" Margin="0,0,8,0"/>
              <Button x:Name="CameraStartBtn" Content="开始" Style="{StaticResource DlgPrimaryBtn}"
                      Click="CameraStart_Click" Margin="0,0,8,0"/>
              <Button x:Name="CameraStopBtn" Content="停止" Style="{StaticResource DlgBtn}"
                      Click="CameraStop_Click" IsEnabled="False"/>
            </StackPanel>
            <Border Grid.Row="3" Background="{DynamicResource SubtleBg}" CornerRadius="8"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <Image x:Name="CameraPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="CameraStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" Text="尚未开始预览"/>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- 扬声器 -->
        <Border Margin="0,0,0,12" Padding="12" CornerRadius="10"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="SpeakerTitle" Text="测试扬声器" FontWeight="SemiBold"/>
            <TextBlock x:Name="SpeakerHint" FontSize="12" Foreground="{DynamicResource Muted}"
                       Margin="0,4,0,8" TextWrapping="Wrap"
                       Text="播放短促测试音，确认本机扬声器可出声。"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SpeakerPlayBtn" Content="播放测试音" Style="{StaticResource DlgPrimaryBtn}"
                      Click="SpeakerPlay_Click"/>
              <TextBlock x:Name="SpeakerStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 麦克风 -->
        <Border Padding="12" CornerRadius="10"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="MicTitle" Text="测试麦克风" FontWeight="SemiBold"/>
            <TextBlock x:Name="MicHint" FontSize="12" Foreground="{DynamicResource Muted}"
                       Margin="0,4,0,8" TextWrapping="Wrap"
                       Text="对着麦克风说话，观察电平条是否跳动。"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="MicStartBtn" Content="开始" Style="{StaticResource DlgPrimaryBtn}"
                      Click="MicStart_Click" Margin="0,0,8,0"/>
              <Button x:Name="MicStopBtn" Content="停止" Style="{StaticResource DlgBtn}"
                      Click="MicStop_Click" IsEnabled="False"/>
              <TextBlock x:Name="MicStatus" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
            <ProgressBar x:Name="MicLevel" Height="12" Minimum="0" Maximum="100" Value="0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Button x:Name="CloseBtn" Grid.Row="2" Content="关闭" HorizontalAlignment="Right"
            Margin="0,14,0,0" Style="{StaticResource DlgBtn}" Click="Close_Click"/>
  </Grid>
</Window>
