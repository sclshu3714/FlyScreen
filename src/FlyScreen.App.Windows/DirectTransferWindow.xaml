<Window x:Class="FlyScreen.DirectTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="直接传输"
        Height="520" Width="640"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource DlgNormalBtn}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DlgFooter}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource DlgNormalBtn}"
                  IsCancel="True" Click="Cancel_Click"/>
          <Button x:Name="StartBtn" Style="{StaticResource DlgPrimaryBtn}" Content="开始传输"
                  IsDefault="True" Click="Start_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>

    <Grid Margin="20,16,20,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource Line}"
              BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AddFilesBtn" Style="{StaticResource ToolBtn}" Content="添加文件…" Click="AddFiles_Click"/>
          <Button x:Name="AddFolderBtn" Style="{StaticResource ToolBtn}" Content="添加文件夹…" Click="AddFolder_Click"/>
          <Button x:Name="RemoveSelectedBtn" Style="{StaticResource ToolBtn}" Content="移除所选" Click="RemoveSelected_Click"/>
          <Button x:Name="ClearPathsBtn" Style="{StaticResource ToolBtn}" Content="清空" Click="ClearPaths_Click" Margin="0"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="ContentHintText" Grid.Row="1" Text="待传内容：选择本机文件或文件夹"
                 Style="{StaticResource DlgHint}" Margin="0,0,0,6"/>

      <Border x:Name="PathDropBorder" Grid.Row="2" Style="{StaticResource DlgCard}" Margin="0,0,0,12">
        <Grid>
          <TextBlock x:Name="PathDropHint" Text="将文件或文件夹拖到此处"
                     Foreground="{DynamicResource Muted}" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Visibility="Visible"/>
          <ListBox x:Name="PathList" SelectionMode="Extended"
                   Background="Transparent" BorderThickness="0"/>
        </Grid>
      </Border>

      <TextBlock x:Name="TargetHintText" Grid.Row="3" Text="传输到：指定已连接电脑及保存位置"
                 Style="{StaticResource DlgHint}" Margin="0,0,0,6"/>

      <Border Grid.Row="4" Style="{StaticResource DlgCard}" Margin="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="PeerLabel" Text="目标电脑" VerticalAlignment="Center"/>
          <ComboBox x:Name="PeerCombo" Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="PeerCombo_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock x:Name="PresetLabel" Grid.Row="1" Text="常用位置" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <ComboBox x:Name="FolderPresetCombo" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="FolderPreset_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock x:Name="PathLabel" Grid.Row="2" Text="保存路径" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <TextBox x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0"
                   VerticalContentAlignment="Center" Padding="8,0"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
