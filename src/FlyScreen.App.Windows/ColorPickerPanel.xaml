<UserControl x:Class="FlyScreen.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <!-- 上方预览区固定，仅下方格式列表滚动 -->
  <Grid Margin="4,0,4,4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Border x:Name="PreviewBorder" Width="72" Height="72" CornerRadius="10"
                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                Background="#2563EB" VerticalAlignment="Center"/>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="PreviewLabel" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
          <TextBlock x:Name="PreviewHex" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" FontFamily="Consolas"/>
          <Button x:Name="PickBtn" Style="{DynamicResource PrimaryBtn}"
                  Margin="0,10,0,0" MinWidth="140" HorizontalAlignment="Left"
                  Click="PickBtn_Click" Cursor="Hand"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="FormatsTitle" FontWeight="SemiBold" FontSize="13"
                 Margin="0,0,0,8" Foreground="{DynamicResource Text}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
      <ItemsControl x:Name="FormatsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8" Cursor="Hand"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    Background="{DynamicResource SubtleBg}"
                    MouseLeftButtonUp="FormatRow_Click" Tag="{Binding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                           FontFamily="Consolas" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
