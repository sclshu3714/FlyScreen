<Window x:Class="FlyScreen.Services.ScreenExtend.ScreenExtendSinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="玄鸟投影"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Topmost="True"
        Background="#0B0B0C"
        ShowInTaskbar="True"
        Focusable="True"
        MinWidth="640"
        MinHeight="400"
        KeyDown="Window_KeyDown">
  <!-- 无边框窗最大化时若保留 ResizeBorder 会四周露桌面；最大化/全屏时厚度在代码里改为 0 -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome x:Name="WinChrome"
                        CaptionHeight="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="4"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#D1D5DB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeCloseBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FsToolBtn" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A40"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleRow" Height="36"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 自定义标题栏（向日葵式 Tab + 窗控） -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="#1A1A1D"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
            MouseMove="TitleBar_MouseMove"
            MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
            LostMouseCapture="TitleBar_LostMouseCapture">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 多 Tab：信号 + 对端名 | 分隔 | + -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom"
                    Margin="8,4,0,0">
          <StackPanel x:Name="TabsHost" Orientation="Horizontal"/>
          <Border Width="1" Height="18" Background="#3F3F46" Margin="6,0,4,4" VerticalAlignment="Bottom"/>
          <Button x:Name="AddTabBtn" Width="28" Height="28" Margin="0,0,4,4"
                  Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="AddTab_Click" ToolTip="添加投影" VerticalAlignment="Bottom">
            <TextBlock Text="+" FontSize="16" Foreground="#9CA3AF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <!-- 中间空白：显式命中层（Grid 空列无背景时拖窗不稳） -->
        <Border Grid.Column="1" Background="#01000000"/>

        <!-- 窗控：全屏 | 最小化 | 最大化 | 关闭 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FullscreenBtn" Style="{StaticResource ChromeBtn}"
                  Click="Fullscreen_Click" ToolTip="全屏">
            <Path x:Name="FullscreenIcon" Stroke="#D1D5DB" StrokeThickness="1.4"
                  Data="M 3,8 L 3,3 L 8,3 M 12,3 L 17,3 L 17,8 M 17,12 L 17,17 L 12,17 M 8,17 L 3,17 L 3,12"
                  Width="14" Height="14" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource ChromeBtn}" Click="Minimize_Click" ToolTip="最小化">
            <Path Stroke="#D1D5DB" StrokeThickness="1.4" Data="M 2,9 L 14,9" Width="14" Height="14"
                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="MaxBtn" Style="{StaticResource ChromeBtn}" Click="Maximize_Click" ToolTip="最大化">
            <Path x:Name="MaxIcon" Stroke="#D1D5DB" StrokeThickness="1.4"
                  Data="M 3,3 H 13 V 13 H 3 Z" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource ChromeCloseBtn}" Click="WindowClose_Click" ToolTip="关闭">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4" Data="M 3,3 L 13,13 M 13,3 L 3,13" Width="12" Height="12"
                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 画面区 -->
    <Grid x:Name="ContentHost" Grid.Row="1" Background="Black"
          MouseMove="ContentHost_MouseMove">
      <Image x:Name="FrameImage" Stretch="Uniform"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <TextBlock x:Name="WaitingText" Text="等待投影画面…" Foreground="#AAFFFFFF"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
    </Grid>

    <!-- 全屏浮动工具条：默认顶部居中；握把可拖/点展开；悬停握把看延迟 -->
    <Canvas x:Name="FsToolbarLayer" Grid.RowSpan="2" Visibility="Collapsed"
            Panel.ZIndex="100" ClipToBounds="True"
            MouseMove="FsToolbarLayer_MouseMove"
            MouseLeftButtonUp="FsToolbarLayer_MouseLeftButtonUp"
            MouseLeave="FsToolbarLayer_MouseLeave">
      <Border x:Name="FsToolbar" Background="#E01A1A1D" CornerRadius="6"
              BorderBrush="#33FFFFFF" BorderThickness="1" Padding="2"
              Cursor="Arrow"
              MouseEnter="FsToolbar_MouseEnter" MouseLeave="FsToolbar_MouseLeave">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="FsGripBtn" Style="{StaticResource FsToolBtn}" Cursor="SizeAll"
                  PreviewMouseLeftButtonDown="FsGrip_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="FsGrip_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="FsGrip_PreviewMouseLeftButtonUp"
                  ToolTip="延迟测量中…">
            <!-- 双向三角：展开/拖拽握把 -->
            <Path Fill="#C8C8CE" Stretch="Uniform" Width="12" Height="10"
                  Data="M 0,5 L 5,1 L 5,9 Z M 12,5 L 7,1 L 7,9 Z"/>
          </Button>
          <StackPanel x:Name="FsToolbarExtra" Orientation="Horizontal">
            <Button x:Name="FsNextTabBtn" Style="{StaticResource FsToolBtn}" Click="NextTab_Click" ToolTip="切换标签">
              <TextBlock Text="⇄" FontSize="12" Foreground="#C8C8CE"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Style="{StaticResource FsToolBtn}" Click="Fullscreen_Click" ToolTip="退出全屏">
              <Path Stroke="#C8C8CE" StrokeThickness="1.3" Stretch="Uniform" Width="12" Height="12"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 4,0 L 4,4 L 0,4 M 8,0 L 8,4 L 12,4 M 12,8 L 8,8 L 8,12 M 0,8 L 4,8 L 4,12"/>
            </Button>
            <Button Style="{StaticResource FsToolBtn}" Click="CloseCurrentTab_Click" ToolTip="结束投影">
              <Grid Width="14" Height="14">
                <Ellipse Stroke="#C8C8CE" StrokeThickness="1.2"/>
                <Path Stroke="#C8C8CE" StrokeThickness="1.3" Stretch="Uniform" Width="7" Height="7"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 0,0 L 8,8 M 8,0 L 0,8"/>
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Window>
