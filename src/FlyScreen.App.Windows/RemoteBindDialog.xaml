<Window x:Class="FlyScreen.RemoteBindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投影到电脑"
        Width="440"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DlgFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelBtn" Style="{StaticResource DlgNormalBtn}" Content="取消"
                IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Style="{StaticResource DlgPrimaryBtn}" Content="投影"
                IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </Border>
    <ScrollViewer Padding="20,16,20,8" VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource DlgCard}" Margin="0">
        <StackPanel>
          <TextBlock x:Name="HintText" Style="{StaticResource DlgHint}" Margin="0,0,0,14"/>
          <TextBlock x:Name="TargetLabel" Text="布局电脑" Style="{StaticResource DlgSectionTitle}"/>
          <ComboBox x:Name="TargetCombo" DisplayMemberPath="Label" Margin="0,0,0,14"/>

          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ResolutionLabel" Text="投影分辨率" FontSize="11"
                       Foreground="{DynamicResource Muted}" Grid.Row="0" Grid.Column="0" Margin="0,0,0,3"/>
            <TextBlock x:Name="BitrateLabel" Text="码率" FontSize="11"
                       Foreground="{DynamicResource Muted}" Grid.Row="0" Grid.Column="2" Margin="0,0,0,3"/>
            <ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="0"/>
            <ComboBox x:Name="BitrateCombo" Grid.Row="1" Grid.Column="2"/>
            <TextBlock x:Name="QualityLabel" Text="质量" FontSize="11"
                       Foreground="{DynamicResource Muted}" Grid.Row="3" Grid.Column="0" Margin="0,0,0,3"/>
            <ComboBox x:Name="QualityCombo" Grid.Row="4" Grid.Column="0"/>
          </Grid>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
