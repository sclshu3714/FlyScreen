<Window x:Class="FlyScreen.ProgramAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加程序"
        Height="400" Width="440"
        MinHeight="360" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DlgFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource DlgNormalBtn}"
                IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource DlgPrimaryBtn}"
                IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </Border>
    <ScrollViewer Padding="20,16,20,8" VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource DlgCard}" Margin="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="LblName" Grid.Row="0" Text="程序名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="32"
                   VerticalContentAlignment="Center" TextChanged="NameBox_TextChanged"/>

          <TextBlock x:Name="LblLang" Grid.Row="1" Text="开发语言" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" LastChildFill="True">
            <Button x:Name="DetectBtn" DockPanel.Dock="Right" Content="环境检测"
                    Style="{StaticResource DlgNormalBtn}" Margin="8,0,0,0" Height="32"
                    Click="Detect_Click" VerticalAlignment="Center"/>
            <ComboBox x:Name="LangCombo" Height="32" VerticalAlignment="Center"
                      SelectionChanged="LangCombo_SelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>

          <TextBlock x:Name="LblNs" Grid.Row="2" Text="命名空间" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <TextBox x:Name="NamespaceBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="32"
                   VerticalContentAlignment="Center"/>

          <TextBlock x:Name="LblFile" Grid.Row="3" Text="文件名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
          <TextBox x:Name="FileNameBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="32"
                   VerticalContentAlignment="Center"/>

          <TextBlock x:Name="ExternalDevHint" Grid.Row="4" Grid.ColumnSpan="2"
                     TextWrapping="Wrap" Style="{StaticResource DlgHint}" Margin="0,0,0,10"/>

          <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
            <TextBlock x:Name="DetectStatus" TextWrapping="Wrap" Style="{StaticResource DlgHint}" Margin="0"/>
            <StackPanel x:Name="DetectActions" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
              <Button x:Name="DetectAutoBtn" Content="自动修复" Style="{StaticResource DlgNormalBtn}"
                      Height="28" Click="DetectAuto_Click"/>
              <Button x:Name="DetectOpenBtn" Content="打开安装页" Style="{StaticResource DlgNormalBtn}"
                      Height="28" Margin="0" Click="DetectOpen_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
