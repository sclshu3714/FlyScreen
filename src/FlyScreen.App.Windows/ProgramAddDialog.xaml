<Window x:Class="FlyScreen.ProgramAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加程序"
        Height="360" Width="440"
        MinHeight="320" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="LblName" Grid.Row="0" Text="程序名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="28"
             VerticalContentAlignment="Center" TextChanged="NameBox_TextChanged"/>

    <TextBlock x:Name="LblLang" Grid.Row="1" Text="开发语言" VerticalAlignment="Center" Margin="0,0,0,10"/>
    <ComboBox x:Name="LangCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="28"
              SelectionChanged="LangCombo_SelectionChanged"/>

    <TextBlock x:Name="LblNs" Grid.Row="2" Text="命名空间" VerticalAlignment="Center" Margin="0,0,0,10"/>
    <TextBox x:Name="NamespaceBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="28"
             VerticalContentAlignment="Center"/>

    <TextBlock x:Name="LblFile" Grid.Row="3" Text="文件名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
    <TextBox x:Name="FileNameBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="28"
             VerticalContentAlignment="Center"/>

    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelBtn" Content="取消" Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="SaveBtn" Content="保存" Width="88" Height="32" IsDefault="True" Click="Save_Click"
              Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
