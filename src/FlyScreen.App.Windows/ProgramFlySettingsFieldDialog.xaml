<Window x:Class="FlyScreen.ProgramFlySettingsFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字段"
        Height="560" Width="820"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theme:WpfTheme xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Wpf;assembly=FlyScreen.Ui.Theme.Wpf"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnCancel" Content="取消" Height="32" Padding="14,0" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="BtnOk" Content="确定" Height="32" Padding="14,0" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="260"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="260"/>
      </Grid.ColumnDefinitions>

      <!-- 左：编辑 -->
      <Border Grid.Column="0" Style="{StaticResource DlgCard}" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="字段属性" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                       Foreground="{DynamicResource Muted}"/>
            <TextBlock Text="键 (key)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="EdKey" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
            <TextBlock Text="标签" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="EdLabel" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
            <TextBlock Text="类型" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <ComboBox x:Name="EdKind" Height="28" Margin="0,0,0,8" SelectionChanged="Kind_Changed"/>
            <TextBlock x:Name="LblDefault" Text="默认值" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="EdDefault" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
            <StackPanel x:Name="PanelOptions" Visibility="Collapsed">
              <TextBlock Text="选项（逗号分隔）" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBox x:Name="EdOptions" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
            </StackPanel>
            <StackPanel x:Name="PanelFilter" Visibility="Collapsed">
              <TextBlock Text="文件过滤器（如 *.json;*.txt）" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBox x:Name="EdFilter" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
            </StackPanel>
            <StackPanel x:Name="PanelEvent" Visibility="Collapsed">
              <TextBlock Text="事件名 (event)" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBox x:Name="EdEvent" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
            </StackPanel>
            <StackPanel x:Name="PanelTable" Visibility="Collapsed">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="列数" FontWeight="SemiBold" Margin="0,0,0,2"/>
                  <TextBox x:Name="EdCols" Height="28" TextChanged="Field_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="行数" FontWeight="SemiBold" Margin="0,0,0,2"/>
                  <TextBox x:Name="EdRows" Height="28" TextChanged="Field_Changed"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="列名（逗号分隔）" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBox x:Name="EdColNames" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
              <TextBlock Text="行名（逗号分隔）" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBox x:Name="EdRowNames" Height="28" Margin="0,0,0,8" TextChanged="Field_Changed"/>
              <CheckBox x:Name="EdRowHeader" Content="第一列作为行头" Margin="0,0,0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
              <CheckBox x:Name="EdCellButton" Content="单元格嵌入按钮" Margin="0,0,0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
              <TextBlock Text="单元格按钮事件" FontWeight="SemiBold" Margin="0,4,0,2"/>
              <TextBox x:Name="EdButtonEvent" Height="28" TextChanged="Field_Changed"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 右：类型说明与取值示例 -->
      <Border Grid.Column="2" Style="{StaticResource DlgCard}" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="类型说明与取值示例" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                       Foreground="{DynamicResource Muted}"/>
            <TextBlock Text="类型说明" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtKindDesc" TextWrapping="Wrap" Margin="0,0,0,14"
                       Foreground="{DynamicResource Text}" LineHeight="20"/>
            <TextBlock Text="取值示例" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtKindExample"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                     FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
