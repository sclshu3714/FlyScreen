<Window x:Class="FlyScreen.LogDateRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择时间范围"
        Width="440"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <Geometry x:Key="GeoClock">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>

    <Style x:Key="TimeTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0,28,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TimePickIconBtn" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DlgFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ClearBtn" Style="{StaticResource DlgNormalBtn}" Content="清除筛选"
                Click="Clear_Click"/>
        <Button x:Name="CancelBtn" Style="{StaticResource DlgNormalBtn}" Content="取消"
                IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Style="{StaticResource DlgPrimaryBtn}" Content="确定"
                IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource DlgCard}" Margin="20,16,20,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="118"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="FromLabel" Text="起始" VerticalAlignment="Center"
                     Foreground="{DynamicResource Muted}"/>
          <DatePicker x:Name="FromDate" Grid.Column="1" Margin="0,0,8,0" Height="32"
                      VerticalContentAlignment="Center" SelectedDateFormat="Short"/>
          <Grid Grid.Column="2" Height="32">
            <TextBox x:Name="FromTime" Style="{StaticResource TimeTextBox}"
                     MaxLength="5" ToolTip="HH:mm（可输入或点右侧选择）"/>
            <Button Style="{StaticResource TimePickIconBtn}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="FromTimePick_Click" ToolTip="选择时间">
              <Viewbox Width="14" Height="14">
                <Path Fill="{DynamicResource Muted}" Data="{StaticResource GeoClock}"/>
              </Viewbox>
            </Button>
            <Popup x:Name="FromTimePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FromTime}"
                   StaysOpen="False" AllowsTransparency="True">
              <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}"
                      BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="FromHour" Width="68" Height="32" SelectionChanged="FromTimeCombo_Changed"/>
                  <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold"/>
                  <ComboBox x:Name="FromMinute" Width="68" Height="32" SelectionChanged="FromTimeCombo_Changed"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="118"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ToLabel" Text="结束" VerticalAlignment="Center"
                     Foreground="{DynamicResource Muted}"/>
          <DatePicker x:Name="ToDate" Grid.Column="1" Margin="0,0,8,0" Height="32"
                      VerticalContentAlignment="Center" SelectedDateFormat="Short"/>
          <Grid Grid.Column="2" Height="32">
            <TextBox x:Name="ToTime" Style="{StaticResource TimeTextBox}"
                     MaxLength="5" ToolTip="HH:mm（可输入或点右侧选择）"/>
            <Button Style="{StaticResource TimePickIconBtn}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="ToTimePick_Click" ToolTip="选择时间">
              <Viewbox Width="14" Height="14">
                <Path Fill="{DynamicResource Muted}" Data="{StaticResource GeoClock}"/>
              </Viewbox>
            </Button>
            <Popup x:Name="ToTimePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ToTime}"
                   StaysOpen="False" AllowsTransparency="True">
              <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}"
                      BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="ToHour" Width="68" Height="32" SelectionChanged="ToTimeCombo_Changed"/>
                  <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold"/>
                  <ComboBox x:Name="ToMinute" Width="68" Height="32" SelectionChanged="ToTimeCombo_Changed"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC2626" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
