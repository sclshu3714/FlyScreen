<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\FlyScreen.Assets.props" />

  <PropertyGroup>
    <!-- Avalonia 共用 UI 类库（Mac/Linux 引用）；非独立端应用 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.DesktopUi</RootNamespace>
    <AssemblyName>FlyScreen.App.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Assets\FlyScreen.Assets.csproj" />
    <ProjectReference Include="..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="$(FlyScreenAppPng64)">
      <Link>Assets\app_icon.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="$(FlyScreenAppIco)">
      <Link>Assets\wlogo_tu.ico</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>

</Project>
