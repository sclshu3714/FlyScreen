<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.ConfirmDialog"
        Title="确认"
        Width="420"
        MinWidth="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13">
  <Window.Styles>
    <StyleInclude Source="avares://FlyScreen.App.Desktop/Themes/DialogStyles.axaml"/>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="dlgTitleBar">
      <TextBlock x:Name="TitleText" Text="确认" Classes="dlgTitleText"/>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="dlgFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
        <Button x:Name="CancelBtn" Classes="dlgNormal" Content="取消" Click="Cancel_Click"/>
        <Button x:Name="SecondaryBtn" Classes="dlgNormal" Content="否" Click="Secondary_Click"/>
        <Button x:Name="PrimaryBtn" Classes="dlgPrimary" Content="是" Click="Primary_Click"/>
      </StackPanel>
    </Border>
    <Border Classes="dlgCard" Margin="20,16,20,8">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="22"/>
    </Border>
  </DockPanel>
</Window>
