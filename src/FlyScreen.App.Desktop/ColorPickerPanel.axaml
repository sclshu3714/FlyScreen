<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlyScreen.DesktopUi.ColorPickerPanel"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <!-- 上方预览区固定，仅下方格式列表滚动 -->
  <Grid Margin="4,0,4,4" RowDefinitions="Auto,*">
    <StackPanel>
      <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Spacing="14">
        <Border x:Name="PreviewBorder" Width="72" Height="72" CornerRadius="10"
                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                Background="#2563EB" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center" Spacing="6">
          <TextBlock x:Name="PreviewLabel" FontSize="12" Foreground="{DynamicResource Muted}"/>
          <TextBlock x:Name="PreviewHex" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" FontFamily="Consolas"/>
          <Button x:Name="PickBtn" Padding="14,6" MinWidth="140" HorizontalAlignment="Left"
                  Click="PickBtn_Click" Background="{DynamicResource Blue}" Foreground="White"
                  BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="FormatsTitle" FontWeight="SemiBold" FontSize="13"
                 Margin="0,0,0,8" Foreground="{DynamicResource Text}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="FormatsList" x:CompileBindings="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:CompileBindings="False">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8" Cursor="Hand"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    Background="{DynamicResource SubtleBg}"
                    PointerReleased="FormatRow_Click" Tag="{Binding}">
              <Grid ColumnDefinitions="140,*">
                <TextBlock Text="{Binding Label}" FontSize="12"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                           FontFamily="Consolas" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
