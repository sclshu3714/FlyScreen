<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.DirectTransferWindow"
        Title="直接传输"
        Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource Text}">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
    <Border Grid.Row="0" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddFilesBtn" Classes="normal" Content="添加文件…" Click="AddFiles_Click" Margin="0" Padding="10,5" MinWidth="0" Height="30"/>
        <Button x:Name="AddFolderBtn" Classes="normal" Content="添加文件夹…" Click="AddFolder_Click" Margin="0" Padding="10,5" MinWidth="0" Height="30"/>
        <Button x:Name="RemoveSelectedBtn" Classes="normal" Content="移除所选" Click="RemoveSelected_Click" Margin="0" Padding="10,5" MinWidth="0" Height="30"/>
        <Button x:Name="ClearPathsBtn" Classes="normal" Content="清空" Click="ClearPaths_Click" Margin="0" Padding="10,5" MinWidth="0" Height="30"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="ContentHintText" Grid.Row="1" Text="待传内容：选择或拖入本机文件/文件夹"
               Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>

    <Border x:Name="PathDropBorder" Grid.Row="2" Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="12"
            DragDrop.AllowDrop="True">
      <Grid>
        <TextBlock x:Name="PathDropHint" Text="将文件或文件夹拖到此处"
                   Foreground="{DynamicResource Muted}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
        <ListBox x:Name="PathList" Background="Transparent" BorderThickness="0"
                 SelectionMode="Multiple"
                 DragDrop.AllowDrop="False"/>
      </Grid>
    </Border>

    <TextBlock x:Name="TargetHintText" Grid.Row="3" Text="传输到：指定已连接电脑及保存位置"
               Foreground="{DynamicResource Muted}" Margin="0,14,0,6"/>

    <Border Grid.Row="4" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" CornerRadius="8" Padding="12">
      <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="PeerLabel" Text="目标电脑" VerticalAlignment="Center"/>
        <ComboBox x:Name="PeerCombo" Grid.Column="1" SelectionChanged="PeerCombo_SelectionChanged"/>

        <TextBlock x:Name="PresetLabel" Grid.Row="1" Text="常用位置" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox x:Name="FolderPresetCombo" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                  SelectionChanged="FolderPreset_SelectionChanged"/>

        <TextBlock x:Name="PathLabel" Grid.Row="2" Text="保存路径" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0"
                 VerticalContentAlignment="Center" Padding="8,0"/>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="{DynamicResource Muted}"
               Margin="0,10,0,0" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelBtn" Classes="normal" Content="取消" Click="Cancel_Click" Margin="0"/>
      <Button x:Name="StartBtn" Classes="primary" Content="开始传输" Click="Start_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
