<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.DirectTransferWindow"
        Title="直接传输"
        Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource Text}">
  <Window.Styles>
    <StyleInclude Source="avares://FlyScreen.App.Desktop/Themes/DialogStyles.axaml"/>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="dlgTitleBar">
      <TextBlock Text="直接传输" Classes="dlgTitleText"/>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="dlgFooter">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
          <Button x:Name="CancelBtn" Classes="dlgNormal" Content="取消" Click="Cancel_Click"/>
          <Button x:Name="StartBtn" Classes="dlgPrimary" Content="开始传输" Click="Start_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>

    <Grid Margin="20,16,20,8" RowDefinitions="Auto,Auto,*,Auto,Auto">
      <Border Grid.Row="0" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource Line}"
              BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <Button x:Name="AddFilesBtn" Classes="dlgNormal" Content="添加文件…" Click="AddFiles_Click"
                  Padding="10,5" MinWidth="0" Height="30"/>
          <Button x:Name="AddFolderBtn" Classes="dlgNormal" Content="添加文件夹…" Click="AddFolder_Click"
                  Padding="10,5" MinWidth="0" Height="30"/>
          <Button x:Name="RemoveSelectedBtn" Classes="dlgNormal" Content="移除所选" Click="RemoveSelected_Click"
                  Padding="10,5" MinWidth="0" Height="30"/>
          <Button x:Name="ClearPathsBtn" Classes="dlgNormal" Content="清空" Click="ClearPaths_Click"
                  Padding="10,5" MinWidth="0" Height="30" Margin="0"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="ContentHintText" Grid.Row="1" Text="待传内容：选择或拖入本机文件/文件夹"
                 Classes="dlgHint" Margin="0,0,0,6"/>

      <Border x:Name="PathDropBorder" Grid.Row="2" Classes="dlgCard" Margin="0,0,0,12"
              DragDrop.AllowDrop="True">
        <Grid>
          <TextBlock x:Name="PathDropHint" Text="将文件或文件夹拖到此处"
                     Foreground="{DynamicResource Muted}" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
          <ListBox x:Name="PathList" Background="Transparent" BorderThickness="0"
                   SelectionMode="Multiple"
                   DragDrop.AllowDrop="False"/>
        </Grid>
      </Border>

      <TextBlock x:Name="TargetHintText" Grid.Row="3" Text="传输到：指定已连接电脑及保存位置"
                 Classes="dlgHint" Margin="0,0,0,6"/>

      <Border Grid.Row="4" Classes="dlgCard" Margin="0">
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock x:Name="PeerLabel" Text="目标电脑" VerticalAlignment="Center"/>
          <ComboBox x:Name="PeerCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                    MinWidth="0" SelectionChanged="PeerCombo_SelectionChanged"/>

          <TextBlock x:Name="PresetLabel" Grid.Row="1" Text="常用位置" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <ComboBox x:Name="FolderPresetCombo" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                    HorizontalAlignment="Stretch" MinWidth="0"
                    SelectionChanged="FolderPreset_SelectionChanged"/>

          <TextBlock x:Name="PathLabel" Grid.Row="2" Text="保存路径" VerticalAlignment="Center" Margin="0,10,0,0"/>
          <TextBox x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0"
                   HorizontalAlignment="Stretch"
                   VerticalContentAlignment="Center" Padding="8,0"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
