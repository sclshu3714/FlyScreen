<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.DirectTransferWindow"
        Title="直接传输"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource Text}">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto">
    <StackPanel Spacing="8">
      <TextBlock Text="选择文件或文件夹推送到对端指定目录。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddFilesBtn" Classes="normal" Content="添加文件…" Click="AddFiles_Click" Margin="0"/>
        <Button x:Name="AddFolderBtn" Classes="normal" Content="添加文件夹…" Click="AddFolder_Click" Margin="0"/>
        <Button x:Name="ClearPathsBtn" Classes="normal" Content="清空" Click="ClearPaths_Click" Margin="0"/>
      </StackPanel>
    </StackPanel>

    <ListBox x:Name="PathList" Grid.Row="1" Margin="0,12,0,12" MinHeight="140"/>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Text="目标电脑" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <ComboBox x:Name="PeerCombo" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                SelectionChanged="PeerCombo_SelectionChanged"/>
      <TextBlock Grid.Row="1" Text="常用目录" VerticalAlignment="Center" Margin="0,0,10,8"/>
      <ComboBox x:Name="FolderPresetCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                SelectionChanged="FolderPreset_SelectionChanged"/>
      <TextBlock Grid.Row="2" Text="目标路径" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"/>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="normal" Content="取消" Click="Cancel_Click" Margin="0"/>
      <Button x:Name="StartBtn" Classes="primary" Content="开始传输" Click="Start_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
