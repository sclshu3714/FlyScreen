<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 与 Win 细圆角滚动条对齐：无粗箭头，滑块随主题色 -->
  <Style Selector="ScrollBar">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10"/>
    <Setter Property="MinHeight" Value="10"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Width" Value="0"/>
    <Setter Property="Height" Value="0"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollThumb}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="Margin" Value="1"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbDrag}"/>
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource ScrollTrack}"/>
  </Style>
  <Style Selector="ScrollBar:horizontal /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource ScrollTrack}"/>
  </Style>
</Styles>
