<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:FlyScreen.DesktopUi.Helpers">
  <!-- 收起时滚轮不改选，交给外层滚动条 -->
  <Style Selector="ComboBox">
    <Setter Property="(h:ComboBoxWheelGuard.SuppressSelection)" Value="True"/>
  </Style>
</Styles>
