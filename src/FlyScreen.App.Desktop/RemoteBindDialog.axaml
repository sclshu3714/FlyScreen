<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.RemoteBindDialog"
        Title="投影到电脑"
        Width="440"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13">
  <Border Padding="20" Background="{DynamicResource WinBg}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
      <TextBlock x:Name="TitleText" Text="投影到电脑" FontSize="15" FontWeight="SemiBold"
                 TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="HintText" Grid.Row="1" TextWrapping="Wrap"
                 Foreground="{DynamicResource Muted}" LineHeight="20" Margin="0,0,0,14"/>
      <TextBlock x:Name="TargetLabel" Grid.Row="2" Text="布局电脑" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <!-- ToString()=Label；主题色走 DynamicResource，避免系统浅底深字错位 -->
      <ComboBox x:Name="TargetCombo" Grid.Row="3" Margin="0,0,0,14" MinHeight="36"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource ControlBg}"
                Foreground="{DynamicResource Text}"
                BorderBrush="{DynamicResource ControlBorder}"/>

      <Grid Grid.Row="4" Margin="0,0,0,18" ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto,10,Auto,Auto">
        <TextBlock x:Name="ResolutionLabel" Text="投影分辨率" FontSize="11"
                   Foreground="{DynamicResource Muted}" Grid.Row="0" Grid.Column="0" Margin="0,0,0,3"/>
        <TextBlock x:Name="BitrateLabel" Text="码率" FontSize="11"
                   Foreground="{DynamicResource Muted}" Grid.Row="0" Grid.Column="2" Margin="0,0,0,3"/>
        <ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="0" MinHeight="36"
                  Background="{DynamicResource ControlBg}" Foreground="{DynamicResource Text}"
                  BorderBrush="{DynamicResource ControlBorder}"/>
        <ComboBox x:Name="BitrateCombo" Grid.Row="1" Grid.Column="2" MinHeight="36"
                  Background="{DynamicResource ControlBg}" Foreground="{DynamicResource Text}"
                  BorderBrush="{DynamicResource ControlBorder}"/>
        <TextBlock x:Name="QualityLabel" Text="质量" FontSize="11"
                   Foreground="{DynamicResource Muted}" Grid.Row="3" Grid.Column="0" Margin="0,0,0,3"/>
        <ComboBox x:Name="QualityCombo" Grid.Row="4" Grid.Column="0" MinHeight="36"
                  Background="{DynamicResource ControlBg}" Foreground="{DynamicResource Text}"
                  BorderBrush="{DynamicResource ControlBorder}"/>
      </Grid>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelBtn" Classes="normal" Content="取消" MinWidth="88" Margin="0"
                Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Classes="primary" Content="投影" MinWidth="96" Margin="0"
                Click="Ok_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
