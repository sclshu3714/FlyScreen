<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.RemoteBindDialog"
        Title="投影到电脑"
        Width="440"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13">
  <Window.Styles>
    <StyleInclude Source="avares://FlyScreen.App.Desktop/Themes/DialogStyles.axaml"/>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0,8,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="dlgTitleBar">
      <TextBlock x:Name="TitleText" Text="投影到电脑" Classes="dlgTitleText"/>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="dlgFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
        <Button x:Name="CancelBtn" Classes="dlgNormal" Content="取消" Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Classes="dlgPrimary" Content="投影" Click="Ok_Click"/>
      </StackPanel>
    </Border>
    <ScrollViewer Padding="20,16,20,8">
      <Border Classes="dlgCard" Margin="0">
        <StackPanel Spacing="0">
          <TextBlock x:Name="HintText" Classes="dlgHint" Margin="0,0,0,14"/>
          <TextBlock x:Name="TargetLabel" Text="布局电脑" Classes="dlgSectionTitle"/>
          <ComboBox x:Name="TargetCombo" Margin="0,0,0,14"/>

          <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto,10,Auto,Auto">
            <TextBlock x:Name="ResolutionLabel" Text="投影分辨率" FontSize="11"
                       Foreground="{DynamicResource Muted}" Grid.Row="0" Grid.Column="0" Margin="0,0,0,3"/>
            <TextBlock x:Name="BitrateLabel" Text="码率" FontSize="11"
                       Foreground="{DynamicResource Muted}" Grid.Row="0" Grid.Column="2" Margin="0,0,0,3"/>
            <ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="0"/>
            <ComboBox x:Name="BitrateCombo" Grid.Row="1" Grid.Column="2"/>
            <TextBlock x:Name="QualityLabel" Text="质量" FontSize="11"
                       Foreground="{DynamicResource Muted}" Grid.Row="3" Grid.Column="0" Margin="0,0,0,3"/>
            <ComboBox x:Name="QualityCombo" Grid.Row="4" Grid.Column="0"/>
          </Grid>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
