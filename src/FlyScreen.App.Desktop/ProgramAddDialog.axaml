<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.ProgramAddDialog"
        Title="添加程序"
        Width="440" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}">
  <Window.Styles>
    <Style Selector="Button.titleBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
  </Window.Styles>

  <Border x:Name="WindowFrame" Background="{DynamicResource WinBg}" BorderBrush="{DynamicResource Line}">
    <DockPanel>
      <Border x:Name="ClientTitleBar" DockPanel.Dock="Top" Height="40" IsVisible="False"
              Background="{DynamicResource PaneBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
              Cursor="SizeAll">
        <Grid ColumnDefinitions="*,Auto" Margin="12,0,4,0">
          <TextBlock x:Name="ClientTitleText" Text="添加程序" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="TitleCloseBtn" Classes="titleBtn" Content="×"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="100,*">
        <TextBlock x:Name="LblName" Text="程序名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,10" Height="28" TextChanged="NameBox_TextChanged"/>

        <TextBlock x:Name="LblLang" Grid.Row="1" Text="开发语言" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <ComboBox x:Name="LangCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="28"
                  SelectionChanged="LangCombo_SelectionChanged"/>

        <TextBlock x:Name="LblNs" Grid.Row="2" Text="命名空间" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="NamespaceBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="28"/>

        <TextBlock x:Name="LblFile" Grid.Row="3" Text="文件名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="FileNameBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="28"/>

        <Grid Grid.Row="5" Grid.ColumnSpan="2">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="DetectBtn" Content="检测" Width="88" Height="32" Click="Detect_Click"/>
            <TextBlock x:Name="DetectStatus" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Muted}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelBtn" Content="取消" Width="88" Height="32" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="保存" Width="88" Height="32" Classes="accent" Click="Save_Click"/>
          </StackPanel>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</Window>
