<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.ProgramAddDialog"
        Title="添加程序"
        Width="440" Height="440"
        MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SizeToContent="Height"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}">
  <Window.Styles>
    <StyleInclude Source="avares://FlyScreen.App.Desktop/Themes/DialogStyles.axaml"/>
    <Style Selector="Button.titleBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
  </Window.Styles>

  <Border x:Name="WindowFrame" Background="{DynamicResource WinBg}" BorderBrush="{DynamicResource Line}">
    <DockPanel>
      <Border x:Name="ClientTitleBar" DockPanel.Dock="Top" Classes="dlgTitleBar" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ClientTitleText" Text="添加程序" Classes="dlgTitleText"
                     IsHitTestVisible="False"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="TitleCloseBtn" Classes="titleBtn" Content="×"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border DockPanel.Dock="Bottom" Classes="dlgFooter">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
          <Button x:Name="CancelBtn" Classes="dlgNormal" Content="取消" Click="Cancel_Click"/>
          <Button x:Name="SaveBtn" Classes="dlgPrimary" Content="保存" Click="Save_Click"/>
        </StackPanel>
      </Border>

      <ScrollViewer Padding="20,16,20,8">
        <Border Classes="dlgCard" Margin="0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="100,*">
            <TextBlock x:Name="LblName" Text="程序名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,10" Height="28" TextChanged="NameBox_TextChanged"/>

            <TextBlock x:Name="LblLang" Grid.Row="1" Text="开发语言" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" LastChildFill="True">
              <Button x:Name="DetectBtn" DockPanel.Dock="Right" Classes="dlgNormal" Content="环境检测"
                      Margin="8,0,0,0" VerticalAlignment="Center" Click="Detect_Click"/>
              <ComboBox x:Name="LangCombo" Height="28" VerticalAlignment="Center"
                        SelectionChanged="LangCombo_SelectionChanged"/>
            </DockPanel>

            <TextBlock x:Name="LblNs" Grid.Row="2" Text="命名空间" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox x:Name="NamespaceBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="28"/>

            <TextBlock x:Name="LblFile" Grid.Row="3" Text="文件名称" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox x:Name="FileNameBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="28"/>

            <StackPanel x:Name="UiOptionsPanel" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10" IsVisible="False" Spacing="4">
              <CheckBox x:Name="EnableUiCheck" Content="启用 UI" IsCheckedChanged="EnableUi_Changed"/>
              <TextBlock x:Name="UiKindHint" Classes="dlgHint" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="ExternalDevHint" Grid.Row="5" Grid.ColumnSpan="2"
                       Classes="dlgHint" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Spacing="6">
              <TextBlock x:Name="DetectStatus" Classes="dlgHint" Margin="0"/>
              <StackPanel x:Name="DetectActions" Orientation="Horizontal" Spacing="0" IsVisible="False">
                <Button x:Name="DetectAutoBtn" Classes="dlgNormal" Content="自动修复" Height="28" Click="DetectAuto_Click"/>
                <Button x:Name="DetectOpenBtn" Classes="dlgNormal" Content="打开安装页" Height="28" Margin="0" Click="DetectOpen_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
