<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.ProgramSettingsWindow"
        Title="设置" Width="420" Height="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="取消" Width="88" Click="Cancel_Click"/>
      <Button Content="保存" Width="88" Click="Save_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="FieldsHost" Spacing="6"/>
    </ScrollViewer>
  </DockPanel>
</Window>
