<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlyScreen.DesktopUi.ProjectionDialog"
        Title="投影"
        Icon="/Assets/app_icon.png"
        Width="520" MinWidth="520" MaxWidth="520"
        Height="480" MinHeight="480" MaxHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Manual"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontSize="13">
  <Window.Styles>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Height" Value="36"/>
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- 与主窗标题栏同高 36 -->
    <Border DockPanel.Dock="Top" Height="36" Padding="12,0,12,0"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            Background="{DynamicResource WinBg}">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="投影" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="EnvTitleStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" Text="正在检查…" Cursor="Hand"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="20,12,20,16"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
            Background="{DynamicResource WinBg}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="取消" MinWidth="88" Height="34" Click="Cancel_Click"/>
        <Button x:Name="StartBtn" Content="开始投影" MinWidth="100" Height="34" Click="Start_Click"
                IsEnabled="False" Opacity="0.5"
                Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>
    <!-- 单列 Grid：子项按格宽排列。StackPanel 会把比自己更宽的子项再撑开，选项展开后卡片会比上面两张宽。 -->
    <ScrollViewer x:Name="BodyScroll" Padding="20,16,20,8" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
      <Grid x:Name="BodyGrid" ColumnDefinitions="*" RowDefinitions="Auto,12,Auto,12,Auto" ClipToBounds="True">
        <Border Grid.Row="0" Padding="14,12" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
          <StackPanel Spacing="8">
            <TextBlock Text="投影方式" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModeCombo" SelectionChanged="Mode_Changed"/>
            <TextBlock x:Name="ModeHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="14,12" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
          <StackPanel Spacing="8">
            <TextBlock Text="目标" FontWeight="SemiBold"/>
            <ComboBox x:Name="TargetCombo" SelectionChanged="Target_Changed"/>
            <TextBlock x:Name="TargetHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="4" Padding="14,12" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
          <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="选项" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
              <TextBlock x:Name="OptionsSummary" Grid.Column="1" FontSize="11"
                         Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
              <Button x:Name="OptionsToggleBtn" Grid.Column="2" Content="▸" FontSize="18" FontWeight="SemiBold"
                      Padding="12,0" MinWidth="36" Background="Transparent" BorderThickness="0"
                      Click="OptionsToggle_Click"/>
            </Grid>
            <Grid x:Name="OptionsBody" Grid.Row="1" IsVisible="False" Margin="0,8,0,0"
                  ColumnDefinitions="*" RowDefinitions="Auto,10,Auto,10,Auto">
              <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource SubtleBg}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                      ClipToBounds="True">
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,8,Auto,8,Auto">
                  <TextBlock Text="画面" FontWeight="SemiBold"/>
                  <Grid Grid.Row="2" ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto,8,Auto,Auto">
                    <TextBlock Text="分辨率" FontSize="11" Foreground="{DynamicResource Muted}"
                               Grid.Row="0" Grid.Column="0" Margin="0,0,0,3"/>
                    <TextBlock Text="缩放" FontSize="11" Foreground="{DynamicResource Muted}"
                               Grid.Row="0" Grid.Column="2" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="0"/>
                    <ComboBox x:Name="ScaleCombo" Grid.Row="1" Grid.Column="2"/>
                    <TextBlock Text="帧率" FontSize="11" Foreground="{DynamicResource Muted}"
                               Grid.Row="3" Grid.Column="0" Margin="0,0,0,3"/>
                    <TextBlock Text="画质" FontSize="11" Foreground="{DynamicResource Muted}"
                               Grid.Row="3" Grid.Column="2" Margin="0,0,0,3"/>
                    <ComboBox x:Name="FpsCombo" Grid.Row="4" Grid.Column="0"/>
                    <ComboBox x:Name="QualityCombo" Grid.Row="4" Grid.Column="2"/>
                  </Grid>
                  <TextBlock x:Name="DisplayHint" Grid.Row="4" FontSize="11" Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"
                             Text="分辨率、帧率、画质与 Windows 对齐。Mac/Linux 本期不发起投影。"/>
                </Grid>
              </Border>
              <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource SubtleBg}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                      ClipToBounds="True">
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,8,Auto,8,Auto">
                  <TextBlock Text="功能" FontWeight="SemiBold"/>
                  <Grid Grid.Row="2" ColumnDefinitions="*,*,*">
                    <CheckBox x:Name="AudioSyncCheck" Content="声音同步" FontWeight="SemiBold" IsChecked="False"
                              Grid.Column="0" MinWidth="0" HorizontalAlignment="Stretch"
                              ToolTip.Tip="投影端静音，由目标播放声音"/>
                    <CheckBox x:Name="RemoteControlCheck" Content="远程控制" FontWeight="SemiBold" IsChecked="False"
                              Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch"
                              ToolTip.Tip="仅本机全屏播放器内键鼠可回控投影端"/>
                    <CheckBox x:Name="CropBlackBarsCheck" Content="去黑边" FontWeight="SemiBold" IsChecked="False"
                              Grid.Column="2" MinWidth="0" HorizontalAlignment="Stretch"
                              ToolTip.Tip="裁掉四周黑边"/>
                  </Grid>
                  <TextBlock x:Name="FeatureHint" Grid.Row="4" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                             Text="默认关闭。声音同步：目标播本地音；远程控制：全屏播放器内回控；去黑边：裁四周黑边。"/>
                </Grid>
              </Border>
              <Border x:Name="EnvPanel" Grid.Row="4" Padding="12,10" Background="{DynamicResource SubtleBg}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                      ClipToBounds="True">
                <StackPanel Spacing="6">
                  <TextBlock Text="环境" FontWeight="SemiBold"/>
                  <TextBlock x:Name="EnvHint" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                             Text="正在检查环境…"/>
                  <TextBlock x:Name="EnvStatus" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
