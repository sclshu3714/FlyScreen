{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FlyScreen.Relay": "Information"
    }
  },
  "Relay": {
    "ServerName": "flyscreen-relay",
    "EdgeListen": "0.0.0.0:8443",
    "AdminListen": "0.0.0.0:9080",
    "PublicEdgeUrl": "",
    "StunUdpPort": 8443,
    "PeerTcpPort": 15155,
    "DiscoveryUdpPort": 15156,
    "DiscoveryBroadcastAnnounce": true,
    "AdminToken": "change-me",
    "DeviceOfflineAfterSeconds": 90,
    "RelayIdleTimeoutSeconds": 600,
    "MaxDevicesPerRoom": 64,
    "MaxRelaySessions": 128,
    "MaxRelayFrameBytes": 1048576,
    "AllowAnonymousAdminRead": false
  }
}
