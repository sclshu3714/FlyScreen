<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="BackgroundColor" Value="{DynamicResource ControlBg}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource Placeholder}" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="SideSearchEntry" TargetType="Entry">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
    <Setter Property="HeightRequest" Value="36" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style TargetType="Picker">
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="BackgroundColor" Value="{DynamicResource ControlBg}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="MinimumHeightRequest" Value="34" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
</ResourceDictionary>
