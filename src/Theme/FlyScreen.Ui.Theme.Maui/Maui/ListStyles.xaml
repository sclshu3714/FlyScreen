<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <!-- CollectionView / ProgressBar：对齐 WPF ListView 表格色板 -->

  <Style TargetType="CollectionView">
    <Setter Property="BackgroundColor" Value="{DynamicResource ListBg}" />
  </Style>

  <Style x:Key="ListRow" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{DynamicResource ListBg}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style x:Key="ListHeader" TargetType="Grid">
    <Setter Property="BackgroundColor" Value="{DynamicResource SubtleBg}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="BackgroundColor" Value="{DynamicResource SubtleBg}" />
    <Setter Property="ProgressColor" Value="{DynamicResource Blue}" />
    <Setter Property="HeightRequest" Value="12" />
  </Style>

  <Style x:Key="XferRowProgressBar" TargetType="ProgressBar">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="ProgressColor" Value="#402563EB" />
    <Setter Property="HeightRequest" Value="4" />
    <Setter Property="InputTransparent" Value="True" />
  </Style>
</ResourceDictionary>
