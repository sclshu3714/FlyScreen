<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono, monospace</FontFamily>
  <sys:Double x:Key="Font.Body">13</sys:Double>
  <sys:Double x:Key="Font.Caption">12</sys:Double>
  <sys:Double x:Key="Font.Title">15</sys:Double>
  <sys:Double x:Key="Font.TitleLarge">17</sys:Double>
</ResourceDictionary>
