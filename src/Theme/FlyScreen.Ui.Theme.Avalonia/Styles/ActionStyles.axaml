<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 表格/列表行内操作图标钮（对齐 WPF NetIconOpBtn / ProgIconBtn） -->

  <Style Selector="Button.netIconOp">
    <Setter Property="Background" Value="{DynamicResource BlueSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="MaxHeight" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.netIconOp:pointerover">
    <Setter Property="Background" Value="{DynamicResource BlueHover}"/>
  </Style>
  <Style Selector="Button.netIconOp:pressed">
    <Setter Property="Background" Value="{DynamicResource Blue}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <Style Selector="Button.netIconOpWarn">
    <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="MaxHeight" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.netIconOpWarn:pointerover">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
  <Style Selector="Button.netIconOpWarn:pressed">
    <Setter Property="Background" Value="{DynamicResource Warn}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- 程序列表行内图标：透明底、无边框，悬停浅蓝底（覆盖宿主全局 Button 铬） -->
  <Style Selector="Button.progIcon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MaxHeight" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.progIcon:pointerover">
    <Setter Property="Background" Value="{DynamicResource BlueSoft}"/>
  </Style>
  <Style Selector="Button.progIcon:pressed">
    <Setter Property="Background" Value="{DynamicResource BlueHover}"/>
  </Style>
  <Style Selector="Button.progIcon:disabled">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>

  <!-- 传输列表等透明图标钮（对齐 WPF IconActionBtn） -->
  <Style Selector="Button.icon-action">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MaxHeight" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.icon-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource BlueSoft}"/>
  </Style>
  <Style Selector="Button.icon-action:pressed">
    <Setter Property="Background" Value="{DynamicResource BlueHover}"/>
  </Style>
</Styles>

