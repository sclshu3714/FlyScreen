<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.Ui.Theme.Avalonia</RootNamespace>
    <AssemblyName>FlyScreen.Ui.Theme.Avalonia</AssemblyName>
    <Description>Avalonia 主题样式源（ActionStyles / DialogStyles / ScrollBar；由宿主 App.Desktop Link 编译）</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Ui.Theme\FlyScreen.Ui.Theme.csproj" />
    <ProjectReference Include="..\..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Styles\**\*.axaml" />
  </ItemGroup>
</Project>
