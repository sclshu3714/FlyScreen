<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.Ui.Maui</RootNamespace>
    <AssemblyName>FlyScreen.Ui.Maui</AssemblyName>
    <Description>玄鸟 MAUI 共享控件（安全密码、路径条、多按钮编辑框、加载遮罩等）</Description>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <DefineConstants>$(DefineConstants);MAUI_WINDOWS</DefineConstants>
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <!-- Core 引用会拉起 WinRT AOT 生成器，需 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Theme\FlyScreen.Ui.Theme\FlyScreen.Ui.Theme.csproj" />
    <ProjectReference Include="..\..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>
</Project>
