<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlyScreen.Ui.Avalonia</RootNamespace>
    <AssemblyName>FlyScreen.Ui.Avalonia</AssemblyName>
    <Description>玄鸟 Avalonia 共享控件（安全密码、路径条、多按钮编辑框、加载遮罩等）</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Theme\FlyScreen.Ui.Theme\FlyScreen.Ui.Theme.csproj" />
    <ProjectReference Include="..\..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>
</Project>
