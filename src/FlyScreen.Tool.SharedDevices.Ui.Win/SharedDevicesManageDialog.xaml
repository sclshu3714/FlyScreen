<Window x:Class="FlyScreen.Tool.SharedDevices.Ui.Win.SharedDevicesManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享设备管理"
        Width="520" Height="560"
        MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WinBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="BlueHover" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Text" Color="#111827"/>
    <SolidColorBrush x:Key="WinBg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>

    <Style x:Key="DlgBtn" TargetType="Button">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlueHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
      <Setter Property="Background" Value="{DynamicResource Blue}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="DeviceCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
    <StackPanel MaxWidth="420" HorizontalAlignment="Center">
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,0,0,6"/>
      <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource Muted}"
                 TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                 Margin="0,0,0,16"/>

      <Border Margin="0,0,0,12" Padding="14" CornerRadius="12"
              Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="SpeakerLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ComboBox x:Name="SpeakerCombo" Style="{StaticResource DeviceCombo}"/>
        </StackPanel>
      </Border>

      <Border Margin="0,0,0,12" Padding="14" CornerRadius="12"
              Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="MicLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ComboBox x:Name="MicCombo" Style="{StaticResource DeviceCombo}"/>
        </StackPanel>
      </Border>

      <Border Margin="0,0,0,12" Padding="14" CornerRadius="12"
              Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="CameraLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ComboBox x:Name="CameraCombo" Style="{StaticResource DeviceCombo}"/>
        </StackPanel>
      </Border>

      <Button x:Name="ClearRememberBtn" Style="{StaticResource DlgBtn}"
              HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="ClearRemember_Click"/>
      <TextBlock x:Name="ClearStatus" FontSize="12" Foreground="{DynamicResource Muted}"
                 HorizontalAlignment="Center" Margin="0,8,0,0"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,8">
        <Button x:Name="SaveBtn" Style="{StaticResource DlgPrimaryBtn}" Margin="0,0,10,0" Click="Save_Click"/>
        <Button x:Name="CloseBtn" Style="{StaticResource DlgBtn}" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
