<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与 VS MAUI 模板一致（勿用自定义属性包一层，否则 VS 设计时还原常漏 TFM → NETSDK1005）。
         仅 Windows：-p:FlyScreenMauiTfms=windows -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(FlyScreenMauiTfms)' == 'windows'">net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FlyScreen.AppMaui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>玄鸟</ApplicationTitle>
    <ApplicationId>com.xuanniao.flyscreen</ApplicationId>
    <!-- ApplicationDisplayVersion / ApplicationVersion 由 build/FlyScreen.Version.targets 与 Win 同源 -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- .NET 10 默认 Release 出 aab；内测分发需要 apk。上架 Play 可临时 -p:AndroidPackageFormat=aab -->
    <AndroidPackageFormat Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">apk</AndroidPackageFormat>
    <!-- 真机常为 arm/arm64；仅 arm64+x64 时部分机型按 32 位加载会 UnsatisfiedLinkError(n_onCreate) -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- 非打包：F5 用 Project 配置；VS 项目右键「发布」对 unpackaged 常不可用，见 Properties/PublishProfiles/SingleFile-win-x64.pubxml -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <IsPublishable>true</IsPublishable>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- VS「调试 Android」要求显式符号；否则报「此项目配置未启用调试」 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <!-- Release 未签名 APK 无法安装（packageInfo is null）。内测旁加载用 sideload keystore；上架 Play 请换正式库并用 -p 覆盖 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\build\android\flyscreen-sideload.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>flyscreen</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>flyscreen</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>flyscreen</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Windows 用 .ico；跨平台图标/启动图用玄鸟 png（与 Desktop Assets 同源） -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- win-x64 发布：单文件自包含（与 PublishProfiles/SingleFile-win-x64.pubxml / Publish-FlyScreenMaui.ps1 一致） -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- VS / msbuild：dotnet msbuild -t:PublishMauiWinX64 -->
  <Target Name="PublishMauiWinX64">
    <PropertyGroup>
      <_FsMauiWinPub>$(MSBuildThisFileDirectory)bin\publish\maui-win-x64</_FsMauiWinPub>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -f net10.0-windows10.0.19041.0 -p:RuntimeIdentifierOverride=win-x64 -p:WindowsPackageType=None -p:WindowsAppSDKSelfContained=true --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -o &quot;$(_FsMauiWinPub)&quot;" />
    <Message Importance="High" Text="MAUI win-x64 → $(_FsMauiWinPub)" />
  </Target>

  <ItemGroup>
    <!-- Color=自适应图标底板；与 png 黑底一致，避免启动器回退默认紫标 -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#000000" BaseSize="256,256" />
    <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#000000" BaseSize="256,256" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="Platforms\Windows\Assets\**\*">
      <Link>Assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Platforms\Windows\Assets\appiconLogo.png">
      <Link>Square44x44Logo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>

  <!-- 仅 Windows 目标引用 Win32 适配；不引用 App.Windows（WPF stable 不动） -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="..\FlyScreen.Windows\FlyScreen.Windows.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\FlyScreen.Version.targets" />

  <!-- 缓解 Windows 上 XARDF7024（RemoveDirFixed: 目录不是空的 / 文件被占用） -->
  <Target Name="FlyScreen_PreClearAndroidIntermediates"
          BeforeTargets="_CleanMonoAndroidIntermediateDir"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Clean-MauiAndroid.ps1&quot; -Configuration &quot;$(Configuration)&quot; -TargetFramework &quot;$(TargetFramework)&quot;"
          IgnoreExitCode="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\Clean-MauiAndroid.ps1')" />
  </Target>

  <!-- VS IncrementalClean 会清掉未登记的 *-Signed.apk；勿再让脚本缺文件时 exit 1。
       AfterTargets=Build 在 CLI 上会在 BuildDependsOn 内的 _Sign 之后执行；VS 内 Build 不签包，无文件则跳过。 -->
  <Target Name="FlyScreen_ProtectApkFileWrites"
          BeforeTargets="IncrementalClean"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <_FsPkgId Condition="'$(_AndroidPackage)' != ''">$(_AndroidPackage)</_FsPkgId>
      <_FsPkgId Condition="'$(_FsPkgId)' == ''">$(ApplicationId)</_FsPkgId>
    </PropertyGroup>
    <ItemGroup>
      <FileWrites Include="$(OutDir)$(_FsPkgId).apk" />
      <FileWrites Include="$(OutDir)$(_FsPkgId)-Signed.apk" />
      <FileWrites Include="$(OutDir)$(_FsPkgId)-Signed.apk.idsig" />
      <FileWrites Include="$(OutDir)FlyScreen.apk" />
    </ItemGroup>
  </Target>

  <Target Name="FlyScreen_EnsureSignedApk"
          AfterTargets="_Sign;SignAndroidPackage;Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <!-- 末尾不要加 \，否则 powershell -OutDir "....\" 会把引号转义掉 -->
      <_FsApkDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</_FsApkDir>
      <_FsInterApkDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\android\bin</_FsInterApkDir>
      <_FsPkgId Condition="'$(_AndroidPackage)' != ''">$(_AndroidPackage)</_FsPkgId>
      <_FsPkgId Condition="'$(_FsPkgId)' == ''">$(ApplicationId)</_FsPkgId>
      <_FsEnsureScript>$(MSBuildThisFileDirectory)..\..\build\Ensure-MauiSignedApk.ps1</_FsEnsureScript>
      <_FsKeyStore>$(MSBuildThisFileDirectory)..\..\build\android\flyscreen-sideload.keystore</_FsKeyStore>
      <_FsPublishOut>$([System.String]::Copy('$(OutDir)').TrimEnd('\'))</_FsPublishOut>
    </PropertyGroup>
    <!-- 禁止用未签名 plain 覆盖 Signed（会导致 INSTALL_PARSE_FAILED_NOT_APK）。一律走脚本：校验签名 / 必要时 apksigner 重签。 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_FsEnsureScript)&quot; -OutDir &quot;$(_FsApkDir)&quot; -PackageId &quot;$(_FsPkgId)&quot; -IntermediateDir &quot;$(_FsInterApkDir)&quot; -KeyStore &quot;$(_FsKeyStore)&quot; -KeyStorePass &quot;$(AndroidSigningStorePass)&quot; -KeyAlias &quot;$(AndroidSigningKeyAlias)&quot; -KeyPass &quot;$(AndroidSigningKeyPass)&quot;"
          Condition="Exists('$(_FsEnsureScript)')"
          IgnoreExitCode="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_FsEnsureScript)&quot; -OutDir &quot;$(_FsPublishOut)&quot; -PackageId &quot;$(_FsPkgId)&quot; -IntermediateDir &quot;$(_FsInterApkDir)&quot; -KeyStore &quot;$(_FsKeyStore)&quot; -KeyStorePass &quot;$(AndroidSigningStorePass)&quot; -KeyAlias &quot;$(AndroidSigningKeyAlias)&quot; -KeyPass &quot;$(AndroidSigningKeyPass)&quot;"
          Condition="Exists('$(_FsEnsureScript)') And '$(_FsPublishOut)' != '' And '$(_FsPublishOut)' != '$(_FsApkDir)'"
          IgnoreExitCode="true" />
    <ItemGroup>
      <FileWrites Include="$(_FsApkDir)\$(_FsPkgId).apk" />
      <FileWrites Include="$(_FsApkDir)\$(_FsPkgId)-Signed.apk" />
      <FileWrites Include="$(_FsApkDir)\$(_FsPkgId)-Signed.apk.idsig" />
      <FileWrites Include="$(_FsApkDir)\FlyScreen.apk" />
    </ItemGroup>
    <Message Importance="High" Text="FlyScreen APK → $(_FsApkDir)\FlyScreen.apk"
             Condition="Exists('$(_FsApkDir)\FlyScreen.apk')" />
  </Target>

</Project>
