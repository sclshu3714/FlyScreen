<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\FlyScreen.Assets.props" />

  <!--
    配对 Mac：Xcode 26.0.1。默认 FlyScreenAppleSdk=26.0 → net10.0-ios26.0（本机已有 pack）。
    若已安装 ios 26.2.x workload：-p:FlyScreenAppleSdk=26.2 → net10.0-ios26.2。
    官方 26.2 要求 Xcode 26.2；与 26.0.1 混用时 ValidateXcodeVersion=false。
    覆盖：FLYSCREEN_XCODE_SDK / FlyScreenIosTfm。
  -->
  <PropertyGroup>
    <FlyScreenAppleSdk Condition="'$(FlyScreenAppleSdk)' == ''">26.0</FlyScreenAppleSdk>
    <_FsXcodeDeveloperDir>$(DEVELOPER_DIR)</_FsXcodeDeveloperDir>
    <_FsXcodeDeveloperDir Condition="'$(_FsXcodeDeveloperDir)' == ''">/var/db/xcode_select_link</_FsXcodeDeveloperDir>
    <_FsXcodeDeveloperDir Condition="!Exists('$(_FsXcodeDeveloperDir)')">/Applications/Xcode.app/Contents/Developer</_FsXcodeDeveloperDir>
    <_FsXcodeVersionPlist>$([System.IO.Path]::Combine('$(_FsXcodeDeveloperDir)', '..', 'version.plist'))</_FsXcodeVersionPlist>
    <_FsXcodeVersionText Condition="Exists('$(_FsXcodeVersionPlist)')">$([System.IO.File]::ReadAllText('$(_FsXcodeVersionPlist)'))</_FsXcodeVersionText>
    <_FsXcodeVersion Condition="'$(_FsXcodeVersionText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_FsXcodeVersionText)', 'CFBundleShortVersionString&lt;/key&gt;\s*&lt;string&gt;([0-9.]+)&lt;/string&gt;').Groups.get_Item(1).Value)</_FsXcodeVersion>
    <_FsXcodeMajorMinor Condition="'$(_FsXcodeVersion)' != ''">$([System.Version]::Parse('$(_FsXcodeVersion)').ToString(2))</_FsXcodeMajorMinor>
    <_FsAppleSdk>$(FLYSCREEN_XCODE_SDK)</_FsAppleSdk>
    <_FsAppleSdk Condition="'$(FlyScreenAppleSdk)' != ''">$(FlyScreenAppleSdk)</_FsAppleSdk>
    <!-- 只用精确字符串（勿写 '26'：MSBuild 会把 26.0==26 当成数值相等） -->
    <_FsPinAppleSdk Condition="'$(_FsAppleSdk)' == '26.0' or '$(_FsAppleSdk)' == '26.2'">true</_FsPinAppleSdk>
    <_FsPinAppleSdk Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(Configuration)' != 'Release' and ('$(_FsXcodeMajorMinor)' == '26.0' or '$(_FsXcodeMajorMinor)' == '26.2')">true</_FsPinAppleSdk>
    <_FsIosTfm>net10.0-ios</_FsIosTfm>
    <_FsIosTfm Condition="'$(_FsPinAppleSdk)' == 'true' and '$(_FsAppleSdk)' != '26.2'">net10.0-ios26.0</_FsIosTfm>
    <_FsIosTfm Condition="'$(_FsAppleSdk)' == '26.2'">net10.0-ios26.2</_FsIosTfm>
    <_FsIosTfm Condition="'$(FlyScreenIosTfm)' != ''">$(FlyScreenIosTfm)</_FsIosTfm>
    <_FsMacCatalystTfm>net10.0-maccatalyst</_FsMacCatalystTfm>
    <_FsMacCatalystTfm Condition="'$(_FsPinAppleSdk)' == 'true' and '$(_FsAppleSdk)' != '26.2'">net10.0-maccatalyst26.0</_FsMacCatalystTfm>
    <_FsMacCatalystTfm Condition="'$(_FsAppleSdk)' == '26.2'">net10.0-maccatalyst26.2</_FsMacCatalystTfm>
    <_FsMacCatalystTfm Condition="'$(FlyScreenMacCatalystTfm)' != ''">$(FlyScreenMacCatalystTfm)</_FsMacCatalystTfm>
    <!-- 26.2 SDK 官方要 Xcode 26.2；本机仍为 26.0.1 时跳过校验（原生工具仍可能因 SDK 差失败） -->
    <ValidateXcodeVersion Condition="'$(_FsAppleSdk)' == '26.2'">false</ValidateXcodeVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 与 VS MAUI 模板一致（勿用自定义属性包一层，否则 VS 设计时还原常漏 TFM → NETSDK1005）。
         仅 Windows：-p:FlyScreenMauiTfms=windows -->
    <TargetFrameworks>net10.0-android;$(_FsIosTfm);$(_FsMacCatalystTfm)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(FlyScreenMauiTfms)' == 'windows'">net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FlyScreen.AppMaui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>玄鸟</ApplicationTitle>
    <ApplicationId>com.xuanniao.flyscreen</ApplicationId>
    <!-- ApplicationDisplayVersion / ApplicationVersion 由 build/FlyScreen.Version.targets 与 Win 同源 -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- .NET 10 默认 AndroidPackageFormats=aab;apk，Release 会再走一遍 aab，并在生成通用 apk 时删掉 *-Signed.apk。内测只出 apk。 -->
    <AndroidPackageFormat Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">apk</AndroidPackageFormat>
    <AndroidPackageFormats Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">apk</AndroidPackageFormats>
    <!-- 真机常为 arm/arm64；仅 arm64+x64 时部分机型按 32 位加载会 UnsatisfiedLinkError(n_onCreate) -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <!--
      默认 Marshal Methods 只在 JNI_OnLoad 里 RegisterNatives，不导出 Java_crc…_n_1onCreate。
      真机若登记失败，启动即 UnsatisfiedLinkError: MauiApplication.n_onCreate。
      关闭后改走传统 JNI 符号，和生成的 Java 包装一致。
    -->
    <AndroidEnableMarshalMethods Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidEnableMarshalMethods>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <!-- Debug|ios：RID 与 Mac CPU 对齐（默认 x64；Apple Silicon 见 Directory.Build.props） -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(RuntimeIdentifier)' == ''">$(FlyScreenIosSimulatorRid)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(RuntimeIdentifier)' == ''">iossimulator-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- VS 部署/设计时在带版本号的 ios TFM 下常探测不到 Platforms/*/Info.plist，显式指定 -->
    <AppBundleManifest Condition="'$(AppBundleManifest)' == '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Info.plist</AppBundleManifest>
    <AppBundleManifest Condition="'$(AppBundleManifest)' == '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms\MacCatalyst\Info.plist</AppBundleManifest>
    <!-- 非打包：F5 用 Project 配置；VS 项目右键「发布」对 unpackaged 常不可用，见 Properties/PublishProfiles/SingleFile-win-x64.pubxml -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <IsPublishable>true</IsPublishable>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- 给 VS iOS 部署工具可识别的 Link/LogicalName（仅文件名 Platforms/.../Info.plist 时会报找不到清单） -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <None Include="Platforms\iOS\Info.plist" Condition="Exists('Platforms\iOS\Info.plist')">
      <Link>Info.plist</Link>
      <LogicalName>Info.plist</LogicalName>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <None Include="Platforms\MacCatalyst\Info.plist" Condition="Exists('Platforms\MacCatalyst\Info.plist')">
      <Link>Info.plist</Link>
      <LogicalName>Info.plist</LogicalName>
    </None>
  </ItemGroup>

  <!-- VS「调试 Android」要求显式符号；否则报「此项目配置未启用调试」 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <!-- Release 未签名 APK 无法安装（packageInfo is null）。内测旁加载用 sideload keystore；上架 Play 请换正式库并用 -p 覆盖 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\build\android\flyscreen-sideload.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>flyscreen</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>flyscreen</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>flyscreen</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Windows：通用玄鸟 ico；FileDescription=玄鸟。exe 名不变，显示名见 WindowsAppUserModel。
       清单要求管理员：对齐 WPF，保证 WH_MOUSE_LL 穿边钩子可靠（非提权易丢边沿移动事件）。 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ApplicationIcon>$(FlyScreenAppIco)</ApplicationIcon>
    <AssemblyTitle>玄鸟</AssemblyTitle>
    <Product>玄鸟</Product>
    <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- win-x64 发布：单文件自包含（与 PublishProfiles/SingleFile-win-x64.pubxml / Publish-FlyScreenMaui.ps1 一致） -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- VS / msbuild：dotnet msbuild -t:PublishMauiWinX64 -->
  <Target Name="PublishMauiWinX64">
    <PropertyGroup>
      <_FsMauiWinPub>$(MSBuildThisFileDirectory)bin\publish\maui-win-x64</_FsMauiWinPub>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -f net10.0-windows10.0.19041.0 -p:RuntimeIdentifierOverride=win-x64 -p:WindowsPackageType=None -p:WindowsAppSDKSelfContained=true --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -o &quot;$(_FsMauiWinPub)&quot;" />
    <Message Importance="High" Text="MAUI win-x64 → $(_FsMauiWinPub)" />
  </Target>

  <ItemGroup>
    <!-- 源文件在 FlyScreen.Assets，文件名保持 appicon.png 才能生成 mipmap/appicon。
         Windows / iOS：勿设不透明 Color（否则 Win 托盘黑底方块）。
         Android 自适应图标画布 108dp，启动器遮罩只保留中心约 66dp（66/108≈0.61）。
         源图圆形徽标几乎贴满 256 画布，ForegroundScale 必须 ≤0.62，否则外圈被圆角/圆形遮罩裁掉。 -->
    <MauiIcon Include="$(FlyScreenAppPng)" BaseSize="256,256"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <MauiIcon Include="$(FlyScreenAppPng)" BaseSize="256,256"
              Color="#FFF1E8" ForegroundScale="0.60"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <MauiSplashScreen Include="$(FlyScreenAppPng)" Color="#0F172A" BaseSize="256,256" />
    <MauiImage Include="$(FlyScreenCursorPng)" Link="Resources\Images\cursor.png" />
  </ItemGroup>

  <!-- 显式打包 Monaco 等 Raw 资源（默认 MauiAsset 在本工程评估为空，导致 HybridWebView 404） -->
  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**\*">
      <!-- 资源名相对 Raw：wwwroot/index.html、monaco/... -->
      <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </MauiAsset>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="$(FlyScreenAppIco)">
      <Link>Assets\appicon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(FlyScreenAppPng64)">
      <Link>Assets\appiconLogo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <!-- Fly.Ocr：Google ML Kit 中英 OCR（专有条款，见 docs/THIRD_PARTY.md）。
       纯净开源构建：-p:FlyEnableMlKit=false -->
  <PropertyGroup>
    <FlyEnableMlKit Condition="'$(FlyEnableMlKit)' == ''">true</FlyEnableMlKit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FlyEnableMlKit)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <DefineConstants>$(DefineConstants);FLY_ENABLE_MLKIT</DefineConstants>
  </PropertyGroup>

  <!-- 与 ML Kit 对齐 AndroidX，避免 Fragment/Lifecycle 主包与 Ktx 版本错位导致 R8 duplicate class。 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.1" />
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition.Chinese" Version="116.0.1.9" Condition="'$(FlyEnableMlKit)' == 'true'" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Android" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Jvm" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.5.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyScreen.Assets\FlyScreen.Assets.csproj" />
    <ProjectReference Include="..\FlyScreen.Core\FlyScreen.Core.csproj" />
  </ItemGroup>

  <!-- 仅 Windows 目标引用 Win32 适配；不引用 App.Windows（WPF stable 不动） -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="..\FlyScreen.Windows\FlyScreen.Windows.csproj" />
    <!-- 托盘菜单 UpdateLayeredWindow 绘制（非 WinForms） -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <Import Project="..\..\build\FlyScreen.Version.targets" />
  <!-- Windows：TopologyGuard / VddOffline（zip 在 VddOffline\ 下）打进包 -->
  <Import Project="..\..\build\FlyScreen.BundleTopologyGuard.targets"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
  <Import Project="..\..\build\FlyScreen.BundleVddOffline.targets"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />

  <!-- 缓解 Windows 上 XARDF7024（RemoveDirFixed: 目录不是空的 / 文件被占用） -->
  <Target Name="FlyScreen_PreClearAndroidIntermediates"
          BeforeTargets="_CleanMonoAndroidIntermediateDir"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Clean-MauiAndroid.ps1&quot; -Configuration &quot;$(Configuration)&quot; -TargetFramework &quot;$(TargetFramework)&quot;"
          IgnoreExitCode="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\Clean-MauiAndroid.ps1')" />
  </Target>

  <!-- 登记 APK，避免下次 IncrementalClean 把未出现在上一轮 FileWrites 里的 Signed / FlyScreen.apk 删掉。 -->
  <Target Name="FlyScreen_ProtectApkFileWrites"
          BeforeTargets="IncrementalClean"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <_FsPkgId Condition="'$(_AndroidPackage)' != ''">$(_AndroidPackage)</_FsPkgId>
      <_FsPkgId Condition="'$(_FsPkgId)' == ''">$(ApplicationId)</_FsPkgId>
    </PropertyGroup>
    <ItemGroup>
      <FileWrites Include="$(OutDir)$(_FsPkgId).apk" />
      <FileWrites Include="$(OutDir)$(_FsPkgId)-Signed.apk" />
      <FileWrites Include="$(OutDir)$(_FsPkgId)-Signed.apk.idsig" />
      <FileWrites Include="$(OutDir)FlyScreen.apk" />
    </ItemGroup>
  </Target>

  <!--
    CLI：Build 内部会 _Sign，结束后补一次。
    VS 右键存档：SignAndroidPackage 之后，IDE 会删掉非 *-Signed.apk，再把 *-Signed.apk 改名为包名。
    不要挂在 _CopyPackage 上，否则会提前生成 -Signed.apk，_Sign 被当成已完成而跳过。
    RestoreAfterVisualStudio 在 IDE 改名之后把 -Signed.apk / FlyScreen.apk 拷回去。
  -->
  <Target Name="FlyScreen_EnsureSignedApk"
          AfterTargets="SignAndroidPackage"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <CallTarget Targets="FlyScreen_EnsureSignedApkCore" />
  </Target>
  <Target Name="FlyScreen_EnsureSignedApkOnCliBuild"
          AfterTargets="Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(BuildingInsideVisualStudio)' != 'true'">
    <CallTarget Targets="FlyScreen_EnsureSignedApkCore" />
  </Target>
  <Target Name="FlyScreen_EnsureSignedApkCore"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <!-- 末尾不要加 \，否则 powershell -OutDir "....\" 会把引号转义掉 -->
      <_FsApkDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</_FsApkDir>
      <_FsInterApkDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\android\bin</_FsInterApkDir>
      <_FsPkgId Condition="'$(_AndroidPackage)' != ''">$(_AndroidPackage)</_FsPkgId>
      <_FsPkgId Condition="'$(_FsPkgId)' == ''">$(ApplicationId)</_FsPkgId>
      <_FsEnsureScript>$(MSBuildThisFileDirectory)..\..\build\Ensure-MauiSignedApk.ps1</_FsEnsureScript>
      <_FsKeyStore>$(MSBuildThisFileDirectory)..\..\build\android\flyscreen-sideload.keystore</_FsKeyStore>
      <_FsIdeRestoreArgs> -RestoreAfterVisualStudio</_FsIdeRestoreArgs>
    </PropertyGroup>
    <!-- 只跑一次。OutDir 用绝对路径，避免和相对 OutDir 再执行一遍。 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_FsEnsureScript)&quot; -OutDir &quot;$(_FsApkDir)&quot; -PackageId &quot;$(_FsPkgId)&quot; -IntermediateDir &quot;$(_FsInterApkDir)&quot; -KeyStore &quot;$(_FsKeyStore)&quot; -KeyStorePass &quot;$(AndroidSigningStorePass)&quot; -KeyAlias &quot;$(AndroidSigningKeyAlias)&quot; -KeyPass &quot;$(AndroidSigningKeyPass)&quot;$(_FsIdeRestoreArgs)"
          Condition="Exists('$(_FsEnsureScript)')"
          IgnoreExitCode="true" />
    <ItemGroup>
      <FileWrites Include="$(_FsApkDir)\$(_FsPkgId).apk" />
      <FileWrites Include="$(_FsApkDir)\$(_FsPkgId)-Signed.apk" />
      <FileWrites Include="$(_FsApkDir)\$(_FsPkgId)-Signed.apk.idsig" />
      <FileWrites Include="$(_FsApkDir)\FlyScreen.apk" />
    </ItemGroup>
    <Message Importance="High" Text="FlyScreen APK → $(_FsApkDir)\FlyScreen.apk"
             Condition="Exists('$(_FsApkDir)\FlyScreen.apk')" />
  </Target>

  <Target Name="_FlyScreenLogAppleSdkPin" BeforeTargets="Build"
          Condition="'$(TargetFramework)' == '' and '$(_FsPinAppleSdk)' == 'true'">
    <Message Importance="High" Text="Apple SDK pin：FlyScreenAppleSdk=$(_FsAppleSdk) → iOS=$(_FsIosTfm) MacCatalyst=$(_FsMacCatalystTfm)（ValidateXcodeVersion=$(ValidateXcodeVersion)）。" />
  </Target>

</Project>
