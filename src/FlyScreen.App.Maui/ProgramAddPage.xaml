<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlyScreen.AppMaui.ProgramAddPage"
             Title="添加程序"
             BackgroundColor="{DynamicResource WinBg}">
  <Grid Padding="24">
    <Border Style="{StaticResource Card}"
            MaximumWidthRequest="440"
            MinimumWidthRequest="280"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="24">
      <ScrollView>
        <VerticalStackLayout Spacing="10">
          <Label x:Name="LblName" Text="程序名称" FontAttributes="Bold" />
          <Entry x:Name="NameBox" Placeholder="例如：测试脚本" HeightRequest="44"
                 TextChanged="NameBox_TextChanged" />

          <Label x:Name="LblLang" Text="开发语言" FontAttributes="Bold" Margin="0,6,0,0" />
          <!-- 勿包额外 Border、勿设 Title：Windows 上会套双层框 / 多出「语言」标签 -->
          <Picker x:Name="LangPicker" Title=""
                  HeightRequest="44"
                  SelectedIndexChanged="LangPicker_Changed" />

          <Label x:Name="LblNs" Text="命名空间" FontAttributes="Bold" Margin="0,6,0,0" />
          <Entry x:Name="NamespaceBox" HeightRequest="44" />

          <Label x:Name="LblFile" Text="文件名称" FontAttributes="Bold" Margin="0,6,0,0" />
          <Entry x:Name="FileNameBox" HeightRequest="44" />

          <Label x:Name="DetectStatus" TextColor="{DynamicResource Muted}" FontSize="12"
                 Margin="0,8,0,0" />
          <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button x:Name="DetectBtn" Text="检测" Style="{StaticResource NormalBtn}"
                    WidthRequest="96" HorizontalOptions="Start" Clicked="Detect_Clicked" />
            <Button x:Name="CancelBtn" Grid.Column="1" Text="取消" Style="{StaticResource NormalBtn}"
                    WidthRequest="96" Clicked="Cancel_Clicked" />
            <Button x:Name="SaveBtn" Grid.Column="2" Text="保存" Style="{StaticResource SoftBlueBtn}"
                    WidthRequest="96" Clicked="Save_Clicked" />
          </Grid>
        </VerticalStackLayout>
      </ScrollView>
    </Border>
  </Grid>
</ContentPage>
