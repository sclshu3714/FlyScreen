<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <!-- 对齐 Win MainWindow：FontSize=13、Card Padding=18/Radius=12、按钮高 34；主题色用 DynamicResource -->
  <Style TargetType="Page">
    <Setter Property="BackgroundColor" Value="{DynamicResource WinBg}" />
  </Style>
  <Style TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style TargetType="Picker">
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="MinimumHeightRequest" Value="34" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinimumWidthRequest" Value="0" />
    <Setter Property="VerticalOptions" Value="Center" />
    <Setter Property="HorizontalOptions" Value="Start" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style x:Key="PrimaryBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{DynamicResource Blue}" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinimumWidthRequest" Value="88" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>
  <Style x:Key="NormalBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="BorderColor" Value="{DynamicResource Line}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinimumWidthRequest" Value="88" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style x:Key="NavBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalOptions" Value="Fill" />
    <Setter Property="HeightRequest" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
    <Setter Property="BackgroundColor" Value="{DynamicResource BlueSoft}" />
    <Setter Property="TextColor" Value="{DynamicResource Blue}" />
  </Style>
  <!-- 与 Win Style Card 一致 -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
    <Setter Property="Stroke" Value="{DynamicResource Line}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="StrokeShape">
      <Setter.Value>
        <RoundRectangle CornerRadius="12" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource Text}" />
    <Setter Property="HeightRequest" Value="28" />
    <Setter Property="WidthRequest" Value="52" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="SegBtnActive" TargetType="Button" BasedOn="{StaticResource SegBtn}">
    <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
    <Setter Property="TextColor" Value="{DynamicResource Blue}" />
    <Setter Property="BorderColor" Value="{DynamicResource Line}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>
</ResourceDictionary>
