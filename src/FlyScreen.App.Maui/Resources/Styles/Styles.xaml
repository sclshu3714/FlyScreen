<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Style TargetType="Page">
    <Setter Property="BackgroundColor" Value="{StaticResource WinBg}" />
  </Style>
  <Style TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
    <Setter Property="HeightRequest" Value="36" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style x:Key="PrimaryBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource Blue}" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinimumWidthRequest" Value="88" />
  </Style>
  <Style x:Key="NormalBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="BorderColor" Value="{StaticResource Line}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="HeightRequest" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinimumWidthRequest" Value="88" />
  </Style>
  <Style x:Key="NavBtn" TargetType="Button">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="HorizontalOptions" Value="Fill" />
    <Setter Property="HeightRequest" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="8,2" />
  </Style>
  <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
    <Setter Property="BackgroundColor" Value="{StaticResource BlueSoft}" />
    <Setter Property="TextColor" Value="{StaticResource Blue}" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
    <Setter Property="Stroke" Value="{StaticResource Line}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="StrokeShape">
      <Setter.Value>
        <RoundRectangle CornerRadius="12" />
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
