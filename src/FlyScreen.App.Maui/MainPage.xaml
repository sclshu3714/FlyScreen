<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FlyScreen.AppMaui"
             xmlns:helpers="clr-namespace:FlyScreen.AppMaui.Helpers"
             xmlns:models="clr-namespace:FlyScreen.Models;assembly=FlyScreen.Core"
             x:Class="FlyScreen.AppMaui.MainPage"
             Title="玄鸟"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource WinBg}">

    <ContentPage.Resources>
        <helpers:HexToColorConverter x:Key="HexToColor"/>
    </ContentPage.Resources>

    <Grid>
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <!-- 手机顶栏：汉堡 + 标题 + 投影（对齐电脑标题栏入口；触控板页另有同名按钮） -->
        <Grid x:Name="PhoneTopBar" IsVisible="False" HeightRequest="48" Padding="4,0,8,0"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{DynamicResource PaneBg}">
            <BoxView Grid.ColumnSpan="3" HeightRequest="1" Color="{DynamicResource Line}" VerticalOptions="End" />
            <Button x:Name="MenuBtn" Text="☰" Style="{StaticResource NormalBtn}"
                    WidthRequest="44" MinimumWidthRequest="44" HeightRequest="40" Margin="0"
                    Padding="0" HorizontalOptions="Start" Clicked="MenuBtn_Clicked" />
            <Label x:Name="PhoneTitleLabel" Grid.Column="1" Text="玄鸟" FontAttributes="Bold" FontSize="16"
                   HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
            <Button x:Name="PhoneProjectBtn" Grid.Column="2" Text="⧉  投影"
                    Style="{StaticResource NormalBtn}"
                    MinimumWidthRequest="0" HeightRequest="36" Padding="12,0"
                    VerticalOptions="Center" Clicked="PhoneProject_Clicked" />
        </Grid>

        <!-- 主内容：宽屏左侧留白给固定侧栏；窄屏全宽 -->
        <Grid x:Name="MainPane" Grid.Row="1" Padding="16" RowDefinitions="*,Auto">
            <Grid Grid.Row="0">
                <!-- ===== 安全（独立页）：生成密钥在标题工具栏，输入框窄屏不被挤裁 ===== -->
                <Grid x:Name="PageSecurity" IsVisible="False">
                    <Border Style="{StaticResource Card}" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="SecurityTitleText" Text="安全密钥" FontSize="15" FontAttributes="Bold"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Button x:Name="NewKeyBtn" Text="生成新密钥"
                                            Style="{StaticResource PrimaryBtn}" Clicked="NewKey_Clicked"
                                            VerticalOptions="Center" />
                                    <Button x:Name="SyncKeyBtn" Text="同步密钥"
                                            Style="{StaticResource PrimaryBtn}" Clicked="SyncKey_Clicked"
                                            VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Entry x:Name="KeyEntry" IsPassword="True" StyleClass="Mono" FontSize="14"
                                       HeightRequest="40" HorizontalOptions="Fill" />
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <CheckBox x:Name="ShowKeyCheck" VerticalOptions="Center" CheckedChanged="ShowKey_Changed" />
                                    <Label x:Name="ShowKeyLabel" Text="显示" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label x:Name="SecurityHintText" Text="多台电脑必须使用相同的安全密钥才能连接（最多支持 4 台）。"
                                   TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />
                            <Label x:Name="SecuritySyncHintText"
                                   Text="生成或修改密钥后点「同步密钥」，布局内已连接与因密钥不同未连上的电脑都会收到并应用。"
                                   TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ===== 基础设置（电脑布局） ===== -->
                <Grid x:Name="PageBasic" IsVisible="True">
                    <Border Style="{StaticResource Card}">
                        <!-- 标题 / 提示 / 工具栏 / 卡片矩阵（工具栏在卡片上方，横屏不挤压） -->
                        <Grid x:Name="LayoutRootGrid" RowDefinitions="Auto,Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <Label x:Name="LayoutTitleText" Text="电脑布局" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource SubtleBg}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8" Padding="3" VerticalOptions="Center">
                                    <HorizontalStackLayout>
                                        <Button x:Name="Layout1x4Btn" Text="1×4" Style="{StaticResource SegBtn}" Clicked="LayoutMode_Clicked" />
                                        <Button x:Name="Layout2x2Btn" Text="2×2" Style="{StaticResource SegBtnActive}" Clicked="LayoutMode_Clicked" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Label x:Name="LayoutHintText" Grid.Row="1" Margin="0,0,0,8"
                                   Text="格子代表真实摆放位置。按住卡片拖到另一格可互换；添加/移除后点「应用」同步。双击对端卡片可移除。"
                                   TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />

                            <HorizontalStackLayout x:Name="LayoutActions" Grid.Row="2" Spacing="8" Margin="0,0,0,10"
                                                   HorizontalOptions="Fill">
                                <Label x:Name="LayoutDragTipText" Text="按住拖拽互换" TextColor="{DynamicResource Blue}" FontSize="12"
                                       VerticalOptions="Center" Margin="0,0,4,0" />
                                <Button x:Name="AddMachineBtn" Text="＋ 添加" Style="{StaticResource NormalBtn}"
                                        Margin="0" Padding="10,0" HeightRequest="34" MinimumWidthRequest="36"
                                        HorizontalOptions="Start" Clicked="AddPeer_Clicked" />
                                <Button x:Name="RemoveMachineBtn" Text="－ 移除" Style="{StaticResource NormalBtn}"
                                        Margin="0" Padding="10,0" HeightRequest="34" MinimumWidthRequest="36"
                                        HorizontalOptions="Start" Clicked="RemovePeer_Clicked" />
                                <Button x:Name="ReconnectBtn" Text="↻ 刷新" Style="{StaticResource NormalBtn}"
                                        Margin="0" Padding="10,0" HeightRequest="34" MinimumWidthRequest="36"
                                        HorizontalOptions="Start" Clicked="Reconnect_Clicked" />
                                <!-- 手机：按需打开触控板，控制布局中选中的对端电脑 -->
                                <Button x:Name="TouchpadBtn" Text="⌨ 触控板" Style="{StaticResource PrimaryBtn}"
                                        Margin="0" Padding="10,0" HeightRequest="34" MinimumWidthRequest="36"
                                        HorizontalOptions="Start" IsVisible="False"
                                        Clicked="OpenTouchpad_Clicked" />
                            </HorizontalStackLayout>

                            <Border x:Name="MatrixBorder" Grid.Row="3" BackgroundColor="{DynamicResource MatrixBg}" Stroke="{DynamicResource Line}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="4">
                                <Grid x:Name="MachineMatrix" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 高级选项：相对原布局仅略收约 10；Maui-Win 默认不滚，手机仍可滚 ===== -->
                <ScrollView x:Name="PageOptions" IsVisible="False" VerticalScrollBarVisibility="Never">
                    <Grid x:Name="OptionsContentRoot" RowDefinitions="Auto,Auto" RowSpacing="8" Padding="0,0,0,4">
                        <Border Style="{StaticResource Card}" Padding="12,8">
                            <!-- 宽屏三列；窄屏由 ApplyOptionsPlacement 改为单列堆叠 -->
                            <Grid x:Name="OptionsFeatGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="8">
                                <VerticalStackLayout x:Name="FeatColumn" Spacing="0">
                                    <Label x:Name="FeatTitleText" Text="功能" FontAttributes="Bold" Margin="0,0,0,4" />
                                    <!-- Spacing=8；列勿锁死 20px（会裁掉勾选图标） -->
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="WrapMouseCheck" VerticalOptions="Center" />
                                        <Label x:Name="WrapMouseLabel" Text="环形鼠标（首尾相连）" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="ShareClipboardCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="ShareClipboardLabel" Text="共享剪贴板" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="20,1,0,1">
                                        <CheckBox x:Name="TransferFileCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="TransferFileLabel" Text="启用文件传输" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="HideMouseCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="HideMouseLabel" Text="隐藏光标" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="DrawCursorCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="DrawCursorLabel" Text="绘制鼠标光标（预留）" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="SameSubnetCheck" VerticalOptions="Center" />
                                        <Label x:Name="SameSubnetLabel" Text="仅同网段连接" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="ShowStatusCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="ShowStatusLabel" Text="显示状态消息" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="BehColumn" Grid.Column="1" Spacing="0">
                                    <Label x:Name="BehTitleText" Text="行为" FontAttributes="Bold" Margin="0,0,0,4" />
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="AutoStartCheck" VerticalOptions="Center" />
                                        <Label x:Name="AutoStartLabel" Text="开机自动启动并连接" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="BlockSaverCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="BlockSaverLabel" Text="阻止其他机器屏保" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="RelativeMouseCheck" VerticalOptions="Center" />
                                        <Label x:Name="RelativeMouseLabel" Text="相对移动鼠标" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="BlockCornersCheck" VerticalOptions="Center" />
                                        <Label x:Name="BlockCornersLabel" Text="屏幕四角阻挡切换" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" HeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="EasyMouseCheck" IsChecked="True" VerticalOptions="Center" />
                                        <Label x:Name="EasyMouseLabel" Text="轻松鼠标（移出边缘切换）" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <!-- Android / iOS：通知注入。Grid 约束文本列宽，HorizontalStack 无限宽导致 WordWrap 失效 -->
                                    <Grid x:Name="NotifyInjectRow" IsVisible="False"
                                          ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                          MinimumHeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="NotifyInjectCheck" VerticalOptions="Start" Margin="0,2,0,0"
                                                  CheckedChanged="NotifyInject_Changed" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                            <Label x:Name="NotifyInjectLabel" Text="通知注入（子程序后台保活）"
                                                   FontSize="13" LineBreakMode="WordWrap" />
                                            <Label x:Name="NotifyInjectTipLabel"
                                                   Text="仅当有用户子程序运行时显示前台通知；无子程序时不占用通知栏。"
                                                   TextColor="{DynamicResource Muted}" FontSize="11"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <!-- Android / iOS：无障碍注入（iOS 受系统限制，见 tip） -->
                                    <Grid x:Name="A11yInjectRow" IsVisible="False"
                                          ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                          MinimumHeightRequest="32" Margin="0,1">
                                        <CheckBox x:Name="A11yInjectCheck" VerticalOptions="Start" Margin="0,2,0,0"
                                                  CheckedChanged="A11yInject_Changed" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                            <Label x:Name="A11yInjectLabel" Text="无障碍注入（键鼠/程序控机）"
                                                   FontSize="13" LineBreakMode="WordWrap" />
                                            <Label x:Name="A11yInjectTipLabel"
                                                   Text="与「玄鸟键鼠注入」是否正在运行一致。开=跳转系统设置；关=直接停用。"
                                                   TextColor="{DynamicResource Muted}" FontSize="11"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="EdgeCrossColumn" Grid.Column="2" Spacing="0"
                                                     HorizontalOptions="Fill">
                                    <Label x:Name="EdgeCrossTitleText" Text="穿边模式" FontAttributes="Bold" Margin="0,0,0,4" />
                                    <!-- 独立列内纵向排列，避免窄列横排挤换行 -->
                                    <RadioButton x:Name="EdgeCrossBarrierRadio" GroupName="EdgeCross"
                                                 IsChecked="True" FontSize="13" Margin="0,1"
                                                 CheckedChanged="EdgeCrossMode_Changed">
                                        <RadioButton.Content>
                                            <Label Text="无障碍" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                        </RadioButton.Content>
                                    </RadioButton>
                                    <RadioButton x:Name="EdgeCrossDoubleRadio" GroupName="EdgeCross"
                                                 FontSize="13" Margin="0,1"
                                                 CheckedChanged="EdgeCrossMode_Changed">
                                        <RadioButton.Content>
                                            <Label Text="双击" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                        </RadioButton.Content>
                                    </RadioButton>
                                    <RadioButton x:Name="EdgeCrossSpeedRadio" GroupName="EdgeCross"
                                                 FontSize="13" Margin="0,1"
                                                 CheckedChanged="EdgeCrossMode_Changed">
                                        <RadioButton.Content>
                                            <Label Text="极速" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                        </RadioButton.Content>
                                    </RadioButton>
                                    <RadioButton x:Name="EdgeCrossHotkeyRadio" GroupName="EdgeCross"
                                                 FontSize="13" Margin="0,1,0,6"
                                                 CheckedChanged="EdgeCrossMode_Changed">
                                        <RadioButton.Content>
                                            <Label Text="快捷键" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                        </RadioButton.Content>
                                    </RadioButton>
                                    <!-- 宽度由 ConstrainEdgeCrossTipWidth 按列宽写入 WidthRequest，否则 WinUI 不换行 -->
                                    <Label x:Name="EdgeCrossTipText" Text="" TextColor="{DynamicResource Muted}"
                                           FontSize="11" LineBreakMode="WordWrap" MaxLines="8"
                                           HorizontalOptions="Start" VerticalOptions="Start" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid x:Name="OptionsBottomGrid" Grid.Row="1" ColumnDefinitions="*,12,240" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Border x:Name="HotCard" Style="{StaticResource Card}" Padding="12,8">
                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="HotTitleText" Text="键盘快捷键" FontAttributes="Bold" />
                                    <Label x:Name="HotSwitchText" Text="切换机器（Ctrl+Alt+）" TextColor="{DynamicResource Muted}" FontSize="12" />
                                    <!-- 勿用 FlexLayout：Maui-Win 显隐后 Wrap 高度常算错（留大块空白） -->
                                    <HorizontalStackLayout x:Name="HotSwitchRow" Spacing="0" Margin="0,2,0,6">
                                        <RadioButton x:Name="HotF" GroupName="SwHot" IsChecked="True" Margin="0,0,14,0"
                                                     VerticalOptions="Center">
                                            <RadioButton.Content>
                                                <Label Text="F1–F4" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                            </RadioButton.Content>
                                        </RadioButton>
                                        <RadioButton x:Name="HotNum" GroupName="SwHot" Margin="0,0,14,0"
                                                     VerticalOptions="Center">
                                            <RadioButton.Content>
                                                <Label Text="1–4" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                            </RadioButton.Content>
                                        </RadioButton>
                                        <RadioButton x:Name="HotOff" GroupName="SwHot" Margin="0"
                                                     VerticalOptions="Center">
                                            <RadioButton.Content>
                                                <Label Text="禁用" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                            </RadioButton.Content>
                                        </RadioButton>
                                    </HorizontalStackLayout>
                                    <!-- 宽屏两列；窄屏由代码改为单列 -->
                                    <Grid x:Name="HotKeysGrid" ColumnDefinitions="Auto,68,12,Auto,68" RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8" RowSpacing="8" VerticalOptions="Center">
                                        <Label x:Name="HotSettingsLabel" Text="显示设置 (Ctrl+Alt+)" VerticalOptions="Center" FontSize="12" LineBreakMode="WordWrap" />
                                        <Entry x:Name="HotkeySettingsEntry" Grid.Column="1" MaxLength="1" Text="M" HeightRequest="36" WidthRequest="60"
                                               HorizontalTextAlignment="Center" />
                                        <Label x:Name="HotReconnectLabel" Grid.Column="3" Text="重新连接 (Ctrl+Alt+)" VerticalOptions="Center" FontSize="12" LineBreakMode="WordWrap" />
                                        <Entry x:Name="HotkeyReconnectEntry" Grid.Column="4" MaxLength="1" Text="R" HeightRequest="36" WidthRequest="60"
                                               HorizontalTextAlignment="Center" />
                                        <Label x:Name="HotExitLabel" Grid.Row="1" Text="退出程序 (Ctrl+Alt+)" VerticalOptions="Center" FontSize="12" LineBreakMode="WordWrap" />
                                        <Entry x:Name="HotkeyExitEntry" Grid.Row="1" Grid.Column="1" MaxLength="1" Text="Q" HeightRequest="36" WidthRequest="60"
                                               HorizontalTextAlignment="Center" />
                                        <Label x:Name="HotLockLabel" Grid.Row="1" Grid.Column="3" Text="锁定机器 (Ctrl+Alt+)" VerticalOptions="Center" FontSize="12" LineBreakMode="WordWrap" />
                                        <Entry x:Name="HotkeyLockEntry" Grid.Row="1" Grid.Column="4" MaxLength="1" Text="L" HeightRequest="36" WidthRequest="60"
                                               HorizontalTextAlignment="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border x:Name="SysCard" Grid.Column="2" Style="{StaticResource Card}" Padding="12,8">
                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="SysTitleText" Text="系统设置" FontAttributes="Bold" />
                                    <Label x:Name="SysStyleLabel" Text="样式" Margin="0,4,0,2" />
                                    <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,0,0,8">
                                        <RadioButton x:Name="ThemeLight" GroupName="UiTheme" IsChecked="True" Margin="0,0,18,4">
                                            <RadioButton.Content>
                                                <Label Text="淡色" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                            </RadioButton.Content>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeDark" GroupName="UiTheme" Margin="0,0,0,4">
                                            <RadioButton.Content>
                                                <Label Text="深色" TextColor="{DynamicResource Text}" FontSize="13" VerticalTextAlignment="Center" />
                                            </RadioButton.Content>
                                        </RadioButton>
                                    </FlexLayout>
                                    <Label x:Name="SysLangLabel" Text="语言" Margin="0,0,0,4" />
                                    <Picker x:Name="LanguagePicker" HeightRequest="40" MinimumHeightRequest="34"
                                            ItemDisplayBinding="{Binding NativeName}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollView>

                <!-- ===== 网络设置：连接配置 / 设备管理 ===== -->
                <Grid x:Name="PageNetwork" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                    <HorizontalStackLayout x:Name="NetworkBreadcrumbHost" />
                    <Grid Grid.Row="1">
                        <Border x:Name="PanelConnConfig" Style="{StaticResource Card}">
                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label x:Name="ConnConfigTitleText" Text="连接配置" FontSize="15" FontAttributes="Bold" />
                                        <Label x:Name="ConnConfigHintText"
                                               Text="本机网卡用于局域网；可添加远程/中转（旧端忽略未知配置）。"
                                               TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Button x:Name="AddEndpointBtn" Grid.Column="1" Text="+" WidthRequest="32" HeightRequest="28"
                                            Padding="0" FontSize="16" FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}" BackgroundColor="{DynamicResource BlueSoft}"
                                            Clicked="AddEndpoint_Clicked" />
                                </Grid>
                                <Border Grid.Row="1" BackgroundColor="{DynamicResource ListBg}" Stroke="{DynamicResource Line}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <Grid ColumnDefinitions="100,*,96">
                                        <Label x:Name="ConnColType" Text="类型" FontSize="12" TextColor="{DynamicResource Muted}" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" HorizontalOptions="Fill" />
                                        <Label x:Name="ConnColAddr" Grid.Column="1" Text="地址" FontSize="12" TextColor="{DynamicResource Muted}" FontAttributes="Bold" />
                                        <Label x:Name="ConnColOp" Grid.Column="2" Text="操作" FontSize="12" TextColor="{DynamicResource Muted}" FontAttributes="Bold"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                                <ScrollView Grid.Row="2">
                                    <VerticalStackLayout Spacing="0">
                                        <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource Line}"
                                                StrokeThickness="0,0,0,1" Padding="12,10">
                                            <Grid ColumnDefinitions="100,*,96" ColumnSpacing="8">
                                                <Label x:Name="NicTitleText" Text="本机网卡" FontAttributes="Bold" VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                                                <Picker x:Name="NicPicker" Grid.Column="1" HeightRequest="36"
                                                        ItemDisplayBinding="{Binding ShortDisplay}" />
                                                <Button x:Name="RefreshNicsBtn" Grid.Column="2" Text="↻" HeightRequest="28"
                                                        Padding="0" FontSize="14" FontAttributes="Bold"
                                                        TextColor="{DynamicResource Blue}" BackgroundColor="{DynamicResource BlueSoft}"
                                                        BorderColor="{DynamicResource Blue}" BorderWidth="1" CornerRadius="6"
                                                        Clicked="RefreshNics_Clicked" />
                                            </Grid>
                                        </Border>
                                        <CollectionView x:Name="EndpointList" HeightRequest="160">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource Line}"
                                                            StrokeThickness="0,0,0,1" Padding="12,10">
                                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="100,*,96" ColumnSpacing="8" RowSpacing="4">
                                                            <Button Text="{Binding KindLabel}" HeightRequest="34" Padding="10,0"
                                                                    FontAttributes="Bold" HorizontalOptions="Center"
                                                                    Clicked="EndpointKind_Clicked"
                                                                    CommandParameter="{Binding}"
                                                                    BackgroundColor="{DynamicResource BlueSoft}"
                                                                    TextColor="{DynamicResource Text}" />
                                                            <Entry Grid.Column="1" Text="{Binding Address}" HeightRequest="34"
                                                                   Placeholder="远程 host:port 或 IP（未写端口用下方 TCP）" />
                                                            <Grid Grid.Column="2" ColumnDefinitions="*,6,*">
                                                                <Button Text="⚡" HeightRequest="28" Padding="0" FontSize="14"
                                                                        TextColor="{DynamicResource Blue}" BackgroundColor="{DynamicResource BlueSoft}"
                                                                        BorderColor="{DynamicResource Blue}" BorderWidth="1" CornerRadius="6"
                                                                        CommandParameter="{Binding}" Clicked="TestEndpoint_Clicked" />
                                                                <Button Grid.Column="2" Text="−" HeightRequest="28" Padding="0" FontSize="14"
                                                                        TextColor="{DynamicResource Warn}" BackgroundColor="{DynamicResource WarnSoft}"
                                                                        BorderColor="{DynamicResource Warn}" BorderWidth="1" CornerRadius="6"
                                                                        CommandParameter="{Binding}" Clicked="DeleteEndpoint_Clicked" />
                                                            </Grid>
                                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}"
                                                                   FontSize="11" TextColor="{DynamicResource Muted}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                        <CollectionView x:Name="DiscoveryList" IsVisible="False" HeightRequest="0" />
                                    </VerticalStackLayout>
                                </ScrollView>
                                <Grid Grid.Row="3" ColumnDefinitions="Auto,100,Auto,100" ColumnSpacing="8">
                                    <Label x:Name="TcpPortLabel" Text="TCP" VerticalOptions="Center" TextColor="{DynamicResource Muted}" />
                                    <Entry x:Name="TcpPortEntry" Grid.Column="1" Keyboard="Numeric" Text="15155" HeightRequest="34" />
                                    <Label x:Name="UdpPortLabel" Grid.Column="2" Text="发现" VerticalOptions="Center" TextColor="{DynamicResource Muted}" />
                                    <Entry x:Name="UdpPortEntry" Grid.Column="3" Keyboard="Numeric" Text="15156" HeightRequest="34" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border x:Name="PanelDeviceMgmt" Style="{StaticResource Card}" IsVisible="False">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label x:Name="DiscoveryTitleText" Text="设备管理" FontSize="15" FontAttributes="Bold" />
                                        <Label x:Name="DiscoveryHintText"
                                               Text="刷新：全网卡（含 Tailscale）广播并探测连接配置中的远程地址；发现到的以「本地」列出。设备管理无上限，布局最多 4 台。"
                                               TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Button x:Name="RefreshDiscoveryBtn" Grid.Column="1" Text="↻" WidthRequest="32" HeightRequest="28"
                                            Padding="0" TextColor="{DynamicResource Blue}" Style="{StaticResource NormalBtn}"
                                            Clicked="RefreshDiscovery_Clicked" />
                                </Grid>
                                <HorizontalStackLayout Grid.Row="1" Spacing="12">
                                    <RadioButton x:Name="DevFilterAll" Content="全部" IsChecked="True" CheckedChanged="DevFilter_Changed" />
                                    <RadioButton x:Name="DevFilterLocal" Content="本地" CheckedChanged="DevFilter_Changed" />
                                    <RadioButton x:Name="DevFilterRemote" Content="远程" CheckedChanged="DevFilter_Changed" />
                                    <RadioButton x:Name="DevFilterService" Content="服务" CheckedChanged="DevFilter_Changed" />
                                </HorizontalStackLayout>
                                <CollectionView x:Name="DeviceInventoryList" Grid.Row="2" BackgroundColor="{DynamicResource ListBg}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Stroke="{DynamicResource Line}" StrokeThickness="0,0,0,1" Padding="10,8"
                                                    BackgroundColor="{DynamicResource CardBg}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                        <Label FontSize="12" TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding KindLabel}" />
                                                                    <Span Text="  " />
                                                                    <Span Text="{Binding Address}" />
                                                                    <Span Text="  " />
                                                                    <Span Text="{Binding StatusText}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                    <Grid Grid.Column="1" ColumnDefinitions="*,6,*" WidthRequest="96" VerticalOptions="Center">
                                                        <Button Text="{Binding PrimaryActionIcon}" HeightRequest="28" Padding="0" FontSize="14"
                                                                TextColor="{DynamicResource Blue}" BackgroundColor="{DynamicResource BlueSoft}"
                                                                BorderColor="{DynamicResource Blue}" BorderWidth="1" CornerRadius="6"
                                                                IsVisible="{Binding PrimaryActionVisible}"
                                                                CommandParameter="{Binding}" Clicked="DevicePrimaryAction_Clicked">
                                                            <Button.Triggers>
                                                                <DataTrigger TargetType="Button" Binding="{Binding PrimaryActionStretch}" Value="True">
                                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                                </DataTrigger>
                                                            </Button.Triggers>
                                                        </Button>
                                                        <Button Grid.Column="2" Text="{Binding SecondaryActionIcon}" HeightRequest="28" Padding="0" FontSize="14"
                                                                TextColor="{DynamicResource Warn}" BackgroundColor="{DynamicResource WarnSoft}"
                                                                BorderColor="{DynamicResource Warn}" BorderWidth="1" CornerRadius="6"
                                                                IsVisible="{Binding SecondaryActionVisible}"
                                                                CommandParameter="{Binding}" Clicked="DeviceSecondaryAction_Clicked" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>
                    </Grid>
                    <Label x:Name="NicHintText" IsVisible="False" />
                </Grid>

                <!-- ===== 文件传输：表头固定，仅内容区滚动并填满高度 ===== -->
                <Grid x:Name="PageTransfer" RowDefinitions="Auto,Auto,*" RowSpacing="10" IsVisible="False">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="XferTitleText" Text="传输列表" FontSize="15" FontAttributes="Bold" />
                        <Label x:Name="XferHintText" Text="剪贴板粘贴：仅传到粘贴机。直接传输：推送到指定电脑的指定目录。清除只删接收缓存。"
                     TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,6">
                        <HorizontalStackLayout x:Name="XferToolBarHost" Spacing="8"
                                               SizeChanged="XferToolBarHost_SizeChanged">
                            <Button x:Name="DirectTransferBtn" Text="直接传输…" Style="{StaticResource PrimaryBtn}"
                                    HeightRequest="34" MinimumWidthRequest="36" Clicked="DirectTransfer_Clicked" />
                            <BoxView x:Name="XferToolSep" WidthRequest="1" Color="{DynamicResource Line}" Margin="4,4" />
                            <Button x:Name="OpenInboxBtn" Text="打开收件箱" Style="{StaticResource NormalBtn}"
                                    HeightRequest="34" MinimumWidthRequest="36" Clicked="OpenInbox_Clicked" />
                            <Button x:Name="ReceiveClipboardBtn" Text="接收剪贴板文件" Style="{StaticResource NormalBtn}"
                                    HeightRequest="34" MinimumWidthRequest="36" Clicked="ReceiveClipboardFiles_Clicked" />
                            <Button x:Name="ClearTransfersBtn" Text="清除已完成" Style="{StaticResource NormalBtn}"
                                    HeightRequest="34" MinimumWidthRequest="36" Clicked="ClearTransfers_Clicked" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid x:Name="TransferListHost" RowDefinitions="Auto,*"
                              SizeChanged="TransferListHost_SizeChanged">
                            <Grid x:Name="TransferListHeader" Padding="10,8" ColumnSpacing="4"
                                  BackgroundColor="{DynamicResource SubtleBg}">
                                <Label x:Name="ColDir" Text="方向" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label x:Name="ColName" Grid.Column="1" Text="文件名" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label x:Name="ColPeer" Grid.Column="2" Text="对端" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label x:Name="ColSize" Grid.Column="3" Text="大小" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label x:Name="ColStatus" Grid.Column="4" Text="状态" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label x:Name="ColOption" Grid.Column="5" Text="操作" FontAttributes="Bold" FontSize="12"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            </Grid>
                            <CollectionView x:Name="TransferList" Grid.Row="1" BackgroundColor="{DynamicResource ListBg}">
                                <CollectionView.EmptyView>
                                    <Label x:Name="XferEmptyText" Text="暂无传输任务。" TextColor="{DynamicResource Muted}"
                           HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TransferItem">
                                        <local:TransferListRowView />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 工具（目录卡片 + 内嵌工作区） ===== -->
                <Grid x:Name="PageTools" IsVisible="False">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Grid>
                                <HorizontalStackLayout Spacing="0" HorizontalOptions="Start">
                                    <Label x:Name="ToolsTitleText" Text="工具" FontSize="15" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout x:Name="ToolsWorkspaceNavPanel" Spacing="0"
                                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button x:Name="ToolsImportBtn" Text="导入" HorizontalOptions="End"
                                        Padding="12,4" Clicked="ToolsImport_Clicked" />
                            </Grid>
                            <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,4,0,8">
                                <Label x:Name="ToolsHintText"
                                       TextColor="{DynamicResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <ScrollView x:Name="ToolsShortcutHost" Grid.Row="2" Orientation="Horizontal"
                                        Margin="0,0,0,12"
                                        MinimumHeightRequest="72" HorizontalScrollBarVisibility="Default"
                                        VerticalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="ToolsShortcutBar" Spacing="10"
                                                       HorizontalOptions="Start" />
                            </ScrollView>
                            <Grid Grid.Row="3">
                                <ScrollView x:Name="ToolsScroll"
                                            VerticalScrollBarVisibility="Default"
                                            HorizontalScrollBarVisibility="Never">
                                    <!-- Grid 分列：避免 FlexLayout 在 ScrollView 内量宽失败导致永远一列 -->
                                    <Grid x:Name="ToolsStack" ColumnSpacing="0" RowSpacing="0" />
                                </ScrollView>
                                <ContentView x:Name="ToolsWorkspaceHost" IsVisible="False"
                                             VerticalOptions="Fill" HorizontalOptions="Fill" />
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Win 提权指针拖拽：只跟手小图标，盖在快捷栏之上 -->
                    <AbsoluteLayout x:Name="ToolsDragGhostLayer"
                                    InputTransparent="True"
                                    IsVisible="False"
                                    ZIndex="1000" />
                </Grid>

                <!-- ===== 程序 ===== -->
                <Grid x:Name="PagePrograms" IsVisible="False">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Label x:Name="ProgTitleText" Text="程序" FontSize="15" FontAttributes="Bold" />
                            <Label x:Name="ProgHintText" Grid.Row="1" Text="管理可单文件运行的脚本与程序。"
                                   TextColor="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,8" />
                            <Grid x:Name="ProgToolBarHost" Grid.Row="2" Margin="0,0,0,8">
                              <HorizontalStackLayout x:Name="ProgToolBar" Spacing="8" HorizontalOptions="Start">
                                <!-- 符号与文字同一 Text，保证垂直居中（对齐 Win 语义） -->
                                <Button x:Name="ProgAddBtn" Style="{StaticResource SoftBlueBtn}"
                                        MinimumWidthRequest="36" Padding="10,0"
                                        Clicked="ProgAdd_Clicked" ToolTipProperties.Text="添加程序" />
                                <Button x:Name="ProgDeleteBtn" Style="{StaticResource SoftBlueBtn}"
                                        MinimumWidthRequest="36" Padding="10,0"
                                        Clicked="ProgDelete_Clicked" ToolTipProperties.Text="删除程序" />
                                <Button x:Name="ProgStartBtn" Style="{StaticResource SoftBlueBtn}"
                                        MinimumWidthRequest="36" Padding="10,0"
                                        Clicked="ProgStart_Clicked" ToolTipProperties.Text="启动程序" />
                                <Button x:Name="ProgStopBtn" Style="{StaticResource SoftBlueBtn}"
                                        MinimumWidthRequest="36" Padding="10,0"
                                        Clicked="ProgStop_Clicked" ToolTipProperties.Text="停止程序" />
                              </HorizontalStackLayout>
                            </Grid>
                            <!-- 列宽严格等于容器宽；语言/状态/操作必显，窄屏可隐藏大小 -->
                            <Grid x:Name="ProgListHost" Grid.Row="3" RowDefinitions="Auto,*"
                                  VerticalOptions="Fill"
                                  SizeChanged="ProgListHost_SizeChanged">
                              <Grid x:Name="ProgListHeader" Padding="4,8" ColumnSpacing="4"
                                    BackgroundColor="{DynamicResource SubtleBg}">
                                <CheckBox x:Name="ProgSelectAll" VerticalOptions="Center"
                                          HorizontalOptions="Center"
                                          CheckedChanged="ProgSelectAll_Changed" />
                                <Label x:Name="ProgColName" Grid.Column="1" Text="程序名称"
                                       FontAttributes="Bold" FontSize="12" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="ProgColLang" Grid.Column="2" Text="语言"
                                       FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                                <Label x:Name="ProgColSize" Grid.Column="3" Text="大小"
                                       FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                                <Label x:Name="ProgColStatus" Grid.Column="4" Text="状态"
                                       FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                                <Label x:Name="ProgColActions" Grid.Column="5" Text="操作"
                                       FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                              </Grid>
                              <CollectionView x:Name="ProgList" Grid.Row="1" SelectionMode="None"
                                              BackgroundColor="{DynamicResource ListBg}">
                                <CollectionView.ItemTemplate>
                                  <DataTemplate>
                                    <local:ProgListRowView />
                                  </DataTemplate>
                                </CollectionView.ItemTemplate>
                              </CollectionView>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 日志 ===== -->
                <Grid x:Name="PageLog" IsVisible="False">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Label x:Name="LogTitleText" Text="日志" FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center" Margin="0,0,0,4" />
                            <HorizontalStackLayout x:Name="LogToolBarHost" Grid.Row="1" Spacing="3"
                                                   Margin="0,0,0,6" SizeChanged="LogToolBarHost_SizeChanged">
                                <Picker x:Name="LogLevelFilter" WidthRequest="96" VerticalOptions="Center"
                                        SelectedIndexChanged="LogFilter_Changed" />
                                <Button x:Name="LogPrevBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogPrev_Clicked" />
                                <Button x:Name="LogNextBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogNext_Clicked" />
                                <Button x:Name="LogLatestBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogLatest_Clicked" />
                                <Button x:Name="LogDateBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogDate_Clicked" />
                                <Button x:Name="LogDownloadBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogDownload_Clicked" />
                                <Button x:Name="LogCopyBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogCopy_Clicked" />
                                <Button x:Name="LogClearBtn" Style="{StaticResource NormalBtn}"
                                        HeightRequest="32" MinimumWidthRequest="30" MaximumWidthRequest="120"
                                        Padding="6,0" Clicked="LogClear_Clicked" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="2" Margin="0,0,0,8">
                                <Label x:Name="LogPageText" TextColor="{DynamicResource Muted}" FontSize="12"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="LogHintText" Text="收录运行中的状态与错误。新记录在底部。"
                                       TextColor="{DynamicResource Muted}" FontSize="12" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <!-- SelectionMode=None：Win 平台 Multiple 会自带复选框；自绘高亮点选多选 -->
                            <CollectionView x:Name="LogList" Grid.Row="3" SelectionMode="None"
                                            Scrolled="LogList_Scrolled">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Margin="0,1"
                                                MinimumHeightRequest="28"
                                                BackgroundColor="{Binding RowBg}"
                                                StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="LogRow_Tapped" NumberOfTapsRequired="1" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                <Label Text="{Binding TimeText}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource Muted}"
                                                       VerticalOptions="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding LevelText}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       MinimumWidthRequest="40"
                                                       TextColor="{Binding Level, Converter={StaticResource LogLevelColorConverter}}"
                                                       VerticalOptions="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2"
                                                       Text="{Binding Message}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource Text}"
                                                       LineBreakMode="WordWrap"
                                                       VerticalOptions="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 关于 ===== -->
                <Grid x:Name="PageAbout" IsVisible="False">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <ScrollView>
                            <VerticalStackLayout Spacing="8">
                                <Label x:Name="AboutTitleText" Text="关于" FontSize="15" FontAttributes="Bold" />
                                <VerticalStackLayout x:Name="AboutBodyHost" Spacing="2" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>
                </Grid>

                <!-- ===== 帮助：工具栏 + 内容区 ===== -->
                <Grid x:Name="PageHelp" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                    <Border Style="{StaticResource Card}" Padding="12,10">
                        <VerticalStackLayout Spacing="10">
                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                <Button x:Name="HelpDocBtn" Text="帮助文本" Style="{StaticResource NormalBtn}"
                                        Margin="0,2,8,2" Clicked="HelpDoc_Clicked" />
                                <Button x:Name="HelpUpdateBtn" Text="检查更新" Style="{StaticResource SoftBlueBtn}"
                                        Margin="0,2,8,2" Clicked="HelpUpdate_Clicked" />
                                <Button x:Name="HelpDiagBtn" Text="问题检查" Style="{StaticResource SoftWarnBtn}"
                                        Margin="0,2,0,2" Clicked="HelpDiag_Clicked" />
                            </FlexLayout>
                            <ProgressBar x:Name="HelpUpdateProgressBar" HeightRequest="10" Progress="0" IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <ScrollView>
                            <VerticalStackLayout x:Name="HelpContent" Padding="12,10" Spacing="8" />
                        </ScrollView>
                    </Border>
                </Grid>
            </Grid>

            <FlexLayout x:Name="FooterBar" Grid.Row="1" Wrap="Wrap" JustifyContent="End" AlignItems="Center"
                        Margin="0,16,0,0">
                <Button x:Name="ApplyBtn" Text="应用" Style="{StaticResource PrimaryBtn}" Clicked="Apply_Clicked" Margin="0,0,8,4" />
                <Button x:Name="TrayBtn" Text="隐藏到托盘" Style="{StaticResource NormalBtn}" Clicked="Tray_Clicked" Margin="0,0,8,4" />
                <Button x:Name="ExitBtn" Text="退出" Style="{StaticResource NormalBtn}" Clicked="Exit_Clicked" Margin="0,0,0,4" />
            </FlexLayout>
        </Grid>

        <!-- 遮罩（仅主区行，不挡顶栏汉堡；低于侧栏） -->
        <BoxView x:Name="NavScrim" Grid.Row="1" IsVisible="False" Color="#66000000" ZIndex="40">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="NavScrim_Tapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- 侧栏：宽屏固定左侧；窄屏抽屉覆盖 -->
        <Grid x:Name="SidePane" Grid.Row="1" BackgroundColor="{DynamicResource PaneBg}"
              WidthRequest="168" HorizontalOptions="Start" ZIndex="50">
            <BoxView WidthRequest="1" Color="{DynamicResource Line}" HorizontalOptions="End" InputTransparent="True" />
            <Grid RowDefinitions="Auto,*,Auto" Padding="0,16,0,12" Margin="0,0,1,0">
                <Border Margin="12,0,12,16" BackgroundColor="{DynamicResource SubtleBg}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" HeightRequest="36" Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="⌕" TextColor="{DynamicResource Muted}" FontSize="14" VerticalOptions="Center"
                               Margin="0,0,6,0" InputTransparent="True" />
                        <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="搜索设置…" Style="{StaticResource SideSearchEntry}"
                               StyleClass="SideSearch" VerticalOptions="Center" TextChanged="Search_Changed" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="0">
                        <!-- 与 WPF 一致：Path 彩标 + 文本；底层 Button 保证 Android 可点 -->
                        <Grid HeightRequest="40" Margin="8,2">
                            <Button x:Name="NavBasic" Style="{StaticResource SideNavBtnActive}" Text=" "
                                    Margin="0" Clicked="Nav_Clicked" CommandParameter="basic" />
                            <HorizontalStackLayout InputTransparent="True" Padding="12,0" VerticalOptions="Center">
                                <Path Data="M12,5.69L17,10.19V18H15V12H9V18H7V10.19L12,5.69M12,3L2,12H5V20H11V14H13V20H19V12H22L12,3Z"
                                      Fill="#F59E0B" Aspect="Uniform" WidthRequest="22" HeightRequest="22"
                                      VerticalOptions="Center" />
                                <Label x:Name="NavBasicText" Text="基础" Style="{StaticResource SideNavLabelActive}"
                                       Margin="10,0,0,0" Padding="0,2,0,0" />
                            </HorizontalStackLayout>
                        </Grid>
                        <Grid HeightRequest="40" Margin="8,2">
                            <Button x:Name="NavNetwork" Style="{StaticResource SideNavBtn}" Text=" "
                                    Margin="0" Clicked="Nav_Clicked" CommandParameter="network" />
                            <HorizontalStackLayout InputTransparent="True" Padding="12,0" VerticalOptions="Center">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.78 4.21,10.21L9,15V16A2,2 0 0,0 11,18M17.9,17.39C17.64,16.59 16.89,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.77 20,8.64 20,12C20,14.08 19.2,15.97 17.9,17.39Z"
                                      Fill="#2563EB" Aspect="Uniform" WidthRequest="22" HeightRequest="22"
                                      VerticalOptions="Center" />
                                <Label x:Name="NavNetworkText" Text="网络" Style="{StaticResource SideNavLabel}"
                                       Margin="10,0,0,0" />
                            </HorizontalStackLayout>
                        </Grid>
                        <Grid HeightRequest="40" Margin="8,2">
                            <Button x:Name="NavShare" Style="{StaticResource SideNavBtn}" Text=" "
