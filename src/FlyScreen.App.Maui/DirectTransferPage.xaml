<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlyScreen.AppMaui.DirectTransferPage"
             Title=""
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WinBg}">
  <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto"
        MaximumWidthRequest="720" HorizontalOptions="Center">

    <Border Grid.Row="0" BackgroundColor="{DynamicResource SubtleBg}"
            Stroke="{DynamicResource Line}" StrokeThickness="1" Padding="8,6" Margin="0,0,0,8"
            StrokeShape="RoundRectangle 4">
      <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
        <Button x:Name="AddFilesBtn" Text="添加文件…" Style="{StaticResource NormalBtn}"
                HeightRequest="30" Margin="0,0,8,0" Padding="10,0" Clicked="AddFiles_Clicked" />
        <Button x:Name="AddFolderBtn" Text="添加文件夹…" Style="{StaticResource NormalBtn}"
                HeightRequest="30" Margin="0,0,8,0" Padding="10,0" Clicked="AddFolder_Clicked" />
        <Button x:Name="RemoveSelectedBtn" Text="移除所选" Style="{StaticResource NormalBtn}"
                HeightRequest="30" Margin="0,0,8,0" Padding="10,0" Clicked="RemoveSelected_Clicked" />
        <Button x:Name="ClearPathsBtn" Text="清空" Style="{StaticResource NormalBtn}"
                HeightRequest="30" Padding="10,0" Clicked="ClearPaths_Clicked" />
      </FlexLayout>
    </Border>

    <Label x:Name="ContentHintText" Grid.Row="1" Text="待传内容：选择或拖入本机文件/文件夹"
           TextColor="{DynamicResource Muted}" Margin="0,0,0,6" />

    <!-- Win：拖放走 WM_DROPFILES；列表自绘 CheckBox，避免平台多选勾与文字不齐 -->
    <Border x:Name="PathDropBorder" Grid.Row="2" BackgroundColor="{DynamicResource CardBg}"
            Stroke="{DynamicResource Line}" StrokeThickness="1" Padding="12" MinimumHeightRequest="140"
            StrokeShape="RoundRectangle 8">
      <Grid>
        <Label x:Name="PathDropHint" Text="将文件或文件夹拖到此处"
               TextColor="{DynamicResource Muted}" FontSize="12"
               HorizontalOptions="Center" VerticalOptions="Center"
               InputTransparent="True" />
        <CollectionView x:Name="PathList" SelectionMode="None"
                        BackgroundColor="Transparent">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="2,4" MinimumHeightRequest="32">
                <CheckBox IsChecked="{Binding IsSelected}"
                          VerticalOptions="Center"
                          Color="{DynamicResource Blue}" />
                <Label Grid.Column="1"
                       Text="{Binding Path}"
                       TextColor="{DynamicResource Text}"
                       FontSize="13"
                       LineBreakMode="MiddleTruncation"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </Grid>
    </Border>

    <Label x:Name="TargetHintText" Grid.Row="3" Text="传输到：指定已连接电脑及保存位置"
           TextColor="{DynamicResource Muted}" Margin="0,14,0,6" />

    <Border Grid.Row="4" BackgroundColor="{DynamicResource CardBg}"
            Stroke="{DynamicResource Line}" StrokeThickness="1" Padding="12"
            StrokeShape="RoundRectangle 8">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="10" ColumnSpacing="8">
        <Label x:Name="PeerLabel" Text="目标电脑" VerticalOptions="Center" TextColor="{DynamicResource Text}" />
        <Picker x:Name="PeerPicker" Grid.Column="1" Title="" HeightRequest="40"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndexChanged="PeerPicker_SelectedIndexChanged" />

        <Label x:Name="PresetLabel" Grid.Row="1" Text="常用位置" VerticalOptions="Center"
               TextColor="{DynamicResource Text}" />
        <Picker x:Name="FolderPresetPicker" Grid.Row="1" Grid.Column="1" Title="" HeightRequest="40"
                ItemDisplayBinding="{Binding Label}"
                SelectedIndexChanged="FolderPreset_SelectedIndexChanged" />

        <Label x:Name="PathLabel" Grid.Row="2" Text="保存路径" VerticalOptions="Center"
               TextColor="{DynamicResource Text}" />
        <Entry x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" HeightRequest="40" />
      </Grid>
    </Border>

    <Label x:Name="StatusText" Grid.Row="5" TextColor="{DynamicResource Muted}"
           Margin="0,10,0,0" LineBreakMode="WordWrap" />

    <HorizontalStackLayout Grid.Row="6" HorizontalOptions="End" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelBtn" Text="取消" Style="{StaticResource NormalBtn}" Clicked="Cancel_Clicked" />
      <Button x:Name="StartBtn" Text="开始传输" Style="{StaticResource PrimaryBtn}" Clicked="Start_Clicked" />
    </HorizontalStackLayout>
  </Grid>
</ContentPage>
