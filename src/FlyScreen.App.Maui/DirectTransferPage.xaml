<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FlyScreen.Ui.Maui;assembly=FlyScreen.Ui.Maui"
             x:Class="FlyScreen.AppMaui.DirectTransferPage"
             Title="直接传输"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Transparent">
  <controls:MauiDialogShell x:Name="Shell"
                            Title="直接传输"
                            ShowClose="True"
                            SizeMode="Wide"
                            CloseRequested="Cancel_Clicked">
    <controls:MauiDialogShell.Body>
      <ScrollView>
        <Grid x:Name="BodyGrid" Padding="20,16,20,8" RowDefinitions="Auto,Auto,*,Auto,Auto">

          <Border Grid.Row="0" BackgroundColor="{DynamicResource SubtleBg}"
                  Stroke="{DynamicResource Line}" StrokeThickness="1" Padding="8,6" Margin="0,0,0,12"
                  StrokeShape="RoundRectangle 8">
            <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
              <Button x:Name="AddFilesBtn" Text="添加文件…" Style="{StaticResource DlgNormalBtn}"
                      HeightRequest="30" Padding="10,0" Clicked="AddFiles_Clicked" />
              <Button x:Name="AddFolderBtn" Text="添加文件夹…" Style="{StaticResource DlgNormalBtn}"
                      HeightRequest="30" Padding="10,0" Clicked="AddFolder_Clicked" />
              <Button x:Name="RemoveSelectedBtn" Text="移除所选" Style="{StaticResource DlgNormalBtn}"
                      HeightRequest="30" Padding="10,0" Clicked="RemoveSelected_Clicked" />
              <Button x:Name="ClearPathsBtn" Text="清空" Style="{StaticResource DlgNormalBtn}"
                      HeightRequest="30" Margin="0" Padding="10,0" Clicked="ClearPaths_Clicked" />
            </FlexLayout>
          </Border>

          <Label x:Name="ContentHintText" Grid.Row="1" Text="待传内容：选择或拖入本机文件/文件夹"
                 Style="{StaticResource DlgHint}" Margin="0,0,0,6" />

          <Border x:Name="PathDropBorder" Grid.Row="2" Style="{StaticResource DlgCard}"
                  Margin="0,0,0,12" MinimumHeightRequest="140">
            <Grid>
              <Label x:Name="PathDropHint" Text="将文件或文件夹拖到此处"
                     TextColor="{DynamicResource Muted}" FontSize="12"
                     HorizontalOptions="Center" VerticalOptions="Center"
                     InputTransparent="True" />
              <CollectionView x:Name="PathList" SelectionMode="None"
                              BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="2,4" MinimumHeightRequest="32">
                      <CheckBox IsChecked="{Binding IsSelected}"
                                VerticalOptions="Center"
                                Color="{DynamicResource Blue}" />
                      <Label Grid.Column="1"
                             Text="{Binding Path}"
                             TextColor="{DynamicResource Text}"
                             FontSize="13"
                             LineBreakMode="MiddleTruncation"
                             VerticalOptions="Center"
                             VerticalTextAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </CollectionView.ItemTemplate>
              </CollectionView>
            </Grid>
          </Border>

          <Label x:Name="TargetHintText" Grid.Row="3" Text="传输到：指定已连接电脑及保存位置"
                 Style="{StaticResource DlgHint}" Margin="0,0,0,6" />

          <Border Grid.Row="4" Style="{StaticResource DlgCard}" Margin="0">
            <Grid x:Name="TargetGrid" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="100,*"
                  RowSpacing="10" ColumnSpacing="8">
              <Label x:Name="PeerLabel" Text="目标电脑" VerticalOptions="Center" TextColor="{DynamicResource Text}" />
              <Picker x:Name="PeerPicker" Grid.Column="1" Title="" HeightRequest="40"
                      TextColor="{DynamicResource Text}"
                      TitleColor="{DynamicResource Muted}"
                      HorizontalOptions="Fill"
                      VerticalOptions="Center"
                      ItemDisplayBinding="{Binding Name}"
                      SelectedIndexChanged="PeerPicker_SelectedIndexChanged" />

              <Label x:Name="PresetLabel" Grid.Row="1" Text="常用位置" VerticalOptions="Center"
                     TextColor="{DynamicResource Text}" />
              <Picker x:Name="FolderPresetPicker" Grid.Row="1" Grid.Column="1" Title="" HeightRequest="40"
                      TextColor="{DynamicResource Text}"
                      TitleColor="{DynamicResource Muted}"
                      HorizontalOptions="Fill"
                      VerticalOptions="Center"
                      ItemDisplayBinding="{Binding Label}"
                      SelectedIndexChanged="FolderPreset_SelectedIndexChanged" />

              <Label x:Name="PathLabel" Grid.Row="2" Text="保存路径" VerticalOptions="Center"
                     TextColor="{DynamicResource Text}" />
              <Entry x:Name="TargetPathBox" Grid.Row="2" Grid.Column="1" HeightRequest="40"
                     HorizontalOptions="Fill" />
            </Grid>
          </Border>
        </Grid>
      </ScrollView>
    </controls:MauiDialogShell.Body>
    <controls:MauiDialogShell.Footer>
      <!-- 勿用 FlexLayout Wrap：Maui-Win 底栏易竖排成两行 -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Label x:Name="StatusText" TextColor="{DynamicResource Muted}" FontSize="12"
               VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" Margin="0,0,8,0" />
        <HorizontalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
          <Button x:Name="CancelBtn" Text="取消" Style="{StaticResource DlgNormalBtn}" Clicked="Cancel_Clicked" />
          <Button x:Name="StartBtn" Text="开始传输" Style="{StaticResource DlgPrimaryBtn}" Clicked="Start_Clicked" />
        </HorizontalStackLayout>
      </Grid>
    </controls:MauiDialogShell.Footer>
  </controls:MauiDialogShell>
</ContentPage>
