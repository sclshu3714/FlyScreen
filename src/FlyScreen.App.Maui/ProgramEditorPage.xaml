<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diag="clr-namespace:FlyScreen.Services;assembly=FlyScreen.Core"
             xmlns:ctl="clr-namespace:FlyScreen.AppMaui.Controls"
             x:Class="FlyScreen.AppMaui.ProgramEditorPage"
             Title="编辑程序"
             BackgroundColor="{DynamicResource WinBg}">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto">
      <HorizontalStackLayout x:Name="ToolBar" Spacing="6" HorizontalOptions="Start">
        <!-- 返回：覆盖 SoftBlueBtn 的 MinWidth=88，避免撑宽叠到保存钮 -->
        <Grid x:Name="BtnCloseHost" WidthRequest="36" MinimumWidthRequest="36" MaximumWidthRequest="36" HeightRequest="32">
          <Button x:Name="BtnClose" Style="{StaticResource SoftBlueBtn}"
                  Text=" " Margin="0" Padding="0"
                  WidthRequest="36" MinimumWidthRequest="36" MaximumWidthRequest="36" HeightRequest="32"
                  Clicked="Close_Clicked" ToolTipProperties.Text="关闭并返回" />
          <Path x:Name="BtnCloseIcon" InputTransparent="True"
                Data="M16,20 L16,8 L4,8 M4,8 L8,5 M4,8 L8,11"
                Stroke="{DynamicResource Blue}" StrokeThickness="2.4"
                StrokeLineCap="Round" StrokeLineJoin="Round"
                Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
        <Button x:Name="BtnSave" Style="{StaticResource SoftBlueBtn}"
                MinimumWidthRequest="36" MaximumWidthRequest="36" WidthRequest="36" Padding="0" HeightRequest="32"
                FontSize="18"
                Clicked="Save_Clicked" ToolTipProperties.Text="保存" />
        <Button x:Name="BtnDebug" Style="{StaticResource SoftBlueBtn}"
                MinimumWidthRequest="36" MaximumWidthRequest="36" WidthRequest="36" Padding="0" HeightRequest="32"
                FontSize="20"
                Clicked="Debug_Clicked" ToolTipProperties.Text="调试" />
        <Button x:Name="BtnRun" Style="{StaticResource PrimaryBtn}"
                MinimumWidthRequest="36" MaximumWidthRequest="36" WidthRequest="36" Padding="0" HeightRequest="32"
                FontSize="20"
                Clicked="Run_Clicked" ToolTipProperties.Text="运行" />
        <Button x:Name="BtnStop" Style="{StaticResource SoftBlueBtn}"
                MinimumWidthRequest="36" MaximumWidthRequest="36" WidthRequest="36" Padding="0" HeightRequest="32"
                FontSize="18" TextColor="#DC2626"
                Clicked="Stop_Clicked" ToolTipProperties.Text="停止" />
      </HorizontalStackLayout>
      <Label x:Name="BpHintText" Grid.Column="1"
             TextColor="{DynamicResource Muted}" FontSize="11"
             VerticalOptions="Center" Margin="8,0,0,0"
             LineBreakMode="TailTruncation" />
    </Grid>

    <Border Grid.Row="1" Stroke="{DynamicResource Line}" StrokeThickness="1"
            BackgroundColor="{DynamicResource CardBg}">
      <!-- 默认 HybridRoot=wwwroot → Resources/Raw/wwwroot（已打包为 MauiAsset） -->
      <HybridWebView x:Name="CodeWeb"
                     HybridRoot="wwwroot"
                     DefaultFile="index.html"
                     RawMessageReceived="OnHybridMessage" />
    </Border>

    <!-- 原生组字条：内容先留在此；IME 选词或点「写入」后再进 Monaco -->
    <Border x:Name="ComposeBar" Grid.Row="2" Stroke="{DynamicResource Line}" StrokeThickness="1"
            StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SubtleBg}"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Label x:Name="ComposeHintLabel" Text="组字"
               TextColor="{DynamicResource Muted}" FontSize="12"
               VerticalOptions="Center" />
        <!-- Android 走 ComposeImeViewHandler(AppCompatEditText)，避免 Entry 默认 InputType 掐掉拼音候选 -->
        <ctl:ComposeImeView x:Name="ComposeEntry" Grid.Column="1"
               Placeholder="在此输入；中文请切系统输入法「中」并选词"
               FontSize="14" HeightRequest="40"
               ClearButtonVisibility="WhileEditing"
               TextChanged="ComposeEntry_TextChanged"
               Focused="ComposeEntry_Focused"
               Completed="ComposeEntry_Completed"
               HandlerChanged="ComposeEntry_HandlerChanged" />
        <Button x:Name="ComposeCommitBtn" Grid.Column="2" Text="写入"
                Style="{StaticResource SoftBlueBtn}"
                HeightRequest="36" MinimumWidthRequest="56" Padding="10,0" FontSize="13"
                Clicked="ComposeCommit_Clicked" />
      </Grid>
    </Border>

    <!-- 底部可折叠输出停靠窗 -->
    <Border Grid.Row="3" Stroke="{DynamicResource Line}" StrokeThickness="1"
            StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource CardBg}">
      <Grid RowDefinitions="Auto,Auto">
        <Grid x:Name="OutputHeader" HeightRequest="30" Padding="10,0"
              BackgroundColor="{DynamicResource SubtleBg}"
              ColumnDefinitions="Auto,*,Auto">
          <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OutputHeader_Tapped" />
          </Grid.GestureRecognizers>
          <Label x:Name="OutputToggleGlyph" Text="▲" FontSize="11"
                 TextColor="{DynamicResource Muted}" VerticalOptions="Center" Margin="0,0,8,0"
                 InputTransparent="True" />
          <Label x:Name="OutputTitleText" Grid.Column="1" Text="输出" FontAttributes="Bold"
                 FontSize="12" VerticalOptions="Center" InputTransparent="True" />
          <Button x:Name="OutputClearBtn" Grid.Column="2" Text="清除"
                  Style="{StaticResource SoftBlueBtn}"
                  HeightRequest="24" MinimumWidthRequest="52" Padding="10,0" FontSize="12"
                  Clicked="OutputClear_Clicked" />
        </Grid>
        <Grid x:Name="OutputBody" Grid.Row="1" IsVisible="False" HeightRequest="150">
          <CollectionView x:Name="OutputList" SelectionMode="None"
                          BackgroundColor="{DynamicResource ListBg}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="diag:AppLogEntry">
                <Label Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                       Margin="8,2" LineBreakMode="WordWrap" />
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
          <Label x:Name="OutputEmptyText"
                 Text="运行或调试后，程序输出会显示在这里。"
                 TextColor="{DynamicResource Muted}" FontSize="12"
                 HorizontalOptions="Center" VerticalOptions="Center"
                 InputTransparent="True" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</ContentPage>
