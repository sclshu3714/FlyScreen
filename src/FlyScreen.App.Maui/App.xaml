<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:FlyScreen.AppMaui.Converters"
             xmlns:theme="clr-namespace:FlyScreen.Ui.Theme.Maui;assembly=FlyScreen.Ui.Theme.Maui"
             x:Class="FlyScreen.AppMaui.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theme:MauiTheme />
        <ResourceDictionary Source="Resources/Styles/Theme/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/Spacing.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/Typography.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/Radii.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/EntryStyles.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/ButtonStyles.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/ControlStyles.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/ListStyles.xaml" />
        <ResourceDictionary Source="Resources/Styles/Theme/ActionStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:PercentToProgressConverter x:Key="PercentToProgress" />
      <conv:LogLevelColorConverter x:Key="LogLevelColorConverter" />
      <x:String x:Key="Str.Add">添加</x:String>
      <x:String x:Key="Str.Delete">删除</x:String>
      <x:String x:Key="Str.DeleteTip">删除此记录</x:String>
    </ResourceDictionary>
  </Application.Resources>
</Application>
