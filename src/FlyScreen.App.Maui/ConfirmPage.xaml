<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FlyScreen.Ui.Maui;assembly=FlyScreen.Ui.Maui"
             x:Class="FlyScreen.AppMaui.ConfirmPage"
             Title="确认"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Transparent">
  <controls:MauiDialogShell x:Name="Shell"
                            Title="确认"
                            ShowClose="False"
                            SizeMode="Form"
                            CloseRequested="Cancel_Clicked">
    <controls:MauiDialogShell.Body>
      <Border Style="{StaticResource DlgCard}" Margin="20,16,20,8">
        <Label x:Name="MessageLabel" FontSize="13" TextColor="{DynamicResource Text}"
               LineBreakMode="WordWrap" />
      </Border>
    </controls:MauiDialogShell.Body>
    <controls:MauiDialogShell.Footer>
      <HorizontalStackLayout Spacing="0" HorizontalOptions="End">
        <Button x:Name="CancelBtn" Text="取消" Style="{StaticResource DlgNormalBtn}"
                Clicked="Cancel_Clicked" />
        <Button x:Name="SecondaryBtn" Text="否" Style="{StaticResource DlgNormalBtn}"
                Clicked="Secondary_Clicked" />
        <Button x:Name="PrimaryBtn" Text="是" Style="{StaticResource DlgPrimaryBtn}"
                Clicked="Primary_Clicked" />
      </HorizontalStackLayout>
    </controls:MauiDialogShell.Footer>
  </controls:MauiDialogShell>
</ContentPage>
