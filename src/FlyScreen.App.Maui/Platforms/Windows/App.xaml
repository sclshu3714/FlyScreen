<maui:MauiWinUIApplication
    x:Class="FlyScreen.AppMaui.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui">

  <!--
    MAUI 默认标题栏 DataTemplate 引用 Square44x44Logo.png（不存在），导致图标空白。
    覆盖 MauiAppTitleBarTemplate；ThemeDictionaries 保证 Modal 重置模板后仍跟深/浅色，
    避免左侧浅底 + 右侧深色按钮区拼成两截。
  -->
  <maui:MauiWinUIApplication.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="FlyTitleBarBgBrush" Color="#F7F8FA"/>
          <SolidColorBrush x:Key="FlyTitleBarFgBrush" Color="#111827"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FlyTitleBarBgBrush" Color="#F7F8FA"/>
          <SolidColorBrush x:Key="FlyTitleBarFgBrush" Color="#111827"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FlyTitleBarBgBrush" Color="#0F172A"/>
          <SolidColorBrush x:Key="FlyTitleBarFgBrush" Color="#E2E8F0"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 滚动条主题资源（与玄鸟细滑块色一致；切换主题时由 MauiScrollBarTheme 覆盖） -->
      <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#CBD5E1"/>
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#94A3B8"/>
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#64748B"/>
      <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>

      <DataTemplate x:Key="MauiAppTitleBarTemplate">
        <Border x:Name="AppTitleBarRoot" Canvas.ZIndex="1" VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch" Margin="0"
                Background="{ThemeResource FlyTitleBarBgBrush}">
          <Grid x:Name="AppTitleBarInner" Background="{ThemeResource FlyTitleBarBgBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="12,0,0,0"
                        Background="Transparent">
              <Image x:Name="AppFontIcon"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Source="Assets/appiconLogo.png"
                     Visibility="Visible"
                     Width="16"
                     Height="16"
                     Margin="0,0,8,0" />
              <TextBlock x:Name="AppTitle"
                         VerticalAlignment="Center"
                         Margin="{Binding WindowTitleMargin}"
                         Text="玄鸟"
                         Foreground="{ThemeResource FlyTitleBarFgBrush}"
                         Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button x:Name="TitleProjectBtn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    MinWidth="78"
                    Width="78"
                    Padding="8,0"
                    Margin="0,0,140,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="投影到电脑"
                    FontSize="11"
                    Foreground="{ThemeResource FlyTitleBarFgBrush}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleProjectIcon"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Text="&#xE8B9;"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"
                           Foreground="{ThemeResource FlyTitleBarFgBrush}"/>
                <TextBlock x:Name="TitleProjectLabel"
                           FontSize="11"
                           Text="投影"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource FlyTitleBarFgBrush}"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
