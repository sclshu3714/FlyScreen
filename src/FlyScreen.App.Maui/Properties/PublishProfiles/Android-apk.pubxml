<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 内测 APK。配置固定 Release，不跟当前解决方案的 Debug。
  VS：右键 FlyScreen.App.Maui → 发布 → Android-apk
  或：dotnet publish src\FlyScreen.App.Maui\FlyScreen.App.Maui.csproj -c Release -f net10.0-android -p:PublishProfile=Android-apk
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\maui-android\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-android</TargetFramework>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
</Project>
