<?xml version="1.0" encoding="utf-8"?>
<!--
  MAUI Windows 非打包自包含单文件 win-x64。
  VS 对 unpackaged（WindowsPackageType=None）常灰掉「项目右键 → 发布」。

  推荐：
    dotnet publish src\FlyScreen.App.Maui\FlyScreen.App.Maui.csproj -c Release `
      -f net10.0-windows10.0.19041.0 -p:PublishProfile=SingleFile-win-x64
    或：powershell -File build\Publish-FlyScreenMaui.ps1 -Platforms Windows
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\maui-win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- 只用 Override，避免 multi-TFM restore 去拉 Mono.win-x64 -->
    <RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
